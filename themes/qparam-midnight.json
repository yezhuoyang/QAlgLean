{
  "$schema": "vscode://schemas/color-theme",
  "name": "QParam Midnight",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#80D7F4",
    "foreground": "#DFE7F2",
    "descriptionForeground": "#A0AEC3",
    "errorForeground": "#FDA4AF",
    "editor.background": "#101626",
    "editor.foreground": "#DFE7F2",
    "editor.lineHighlightBackground": "#182136",
    "editor.selectionBackground": "#364D75",
    "editor.inactiveSelectionBackground": "#28364E",
    "editor.selectionHighlightBackground": "#364D7555",
    "editor.wordHighlightBackground": "#B49BFF22",
    "editorCursor.foreground": "#80D7F4",
    "editorLineNumber.foreground": "#66758F",
    "editorLineNumber.activeForeground": "#B9C9E0",
    "editorIndentGuide.background1": "#253149",
    "editorIndentGuide.activeBackground1": "#526688",
    "editorWhitespace.foreground": "#35435D",
    "editorBracketMatch.background": "#80D7F422",
    "editorBracketMatch.border": "#80D7F477",
    "editorBracketHighlight.foreground1": "#80D7F4",
    "editorBracketHighlight.foreground2": "#BCA6FF",
    "editorBracketHighlight.foreground3": "#F6CE87",
    "editorError.foreground": "#FDA4AF",
    "editorWarning.foreground": "#F6CE87",
    "editorInfo.foreground": "#80D7F4",
    "editorGutter.addedBackground": "#74DDC5",
    "editorGutter.modifiedBackground": "#80D7F4",
    "editorGutter.deletedBackground": "#FDA4AF",
    "editorWidget.background": "#1A2337",
    "editorWidget.border": "#35435D",
    "editorSuggestWidget.selectedBackground": "#304363",
    "editorHoverWidget.background": "#1A2337",
    "editorHoverWidget.border": "#35435D",
    "editorOverviewRuler.border": "#101626",
    "sideBar.background": "#0D1321",
    "sideBar.foreground": "#B9C9E0",
    "sideBarSectionHeader.background": "#141D2E",
    "sideBarTitle.foreground": "#A0AEC3",
    "activityBar.background": "#0B101C",
    "activityBar.foreground": "#80D7F4",
    "activityBar.inactiveForeground": "#75859F",
    "activityBarBadge.background": "#BCA6FF",
    "activityBarBadge.foreground": "#101626",
    "titleBar.activeBackground": "#0D1321",
    "titleBar.activeForeground": "#DFE7F2",
    "titleBar.inactiveBackground": "#0B101C",
    "tab.activeBackground": "#101626",
    "tab.activeForeground": "#DFE7F2",
    "tab.activeBorderTop": "#80D7F4",
    "tab.inactiveBackground": "#0D1321",
    "tab.inactiveForeground": "#8FA0BA",
    "tab.border": "#0D1321",
    "editorGroupHeader.tabsBackground": "#0D1321",
    "panel.background": "#0D1321",
    "panel.border": "#253149",
    "panelTitle.activeBorder": "#80D7F4",
    "statusBar.background": "#1C2D46",
    "statusBar.foreground": "#DFE7F2",
    "statusBar.debuggingBackground": "#443663",
    "statusBar.noFolderBackground": "#141D2E",
    "button.background": "#80D7F4",
    "button.foreground": "#101626",
    "button.hoverBackground": "#A6E5FA",
    "input.background": "#192338",
    "input.foreground": "#DFE7F2",
    "input.border": "#35435D",
    "dropdown.background": "#192338",
    "dropdown.border": "#35435D",
    "list.activeSelectionBackground": "#304363",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#202E47",
    "list.hoverBackground": "#1A263D",
    "list.highlightForeground": "#80D7F4",
    "textLink.foreground": "#80D7F4",
    "textLink.activeForeground": "#A6E5FA",
    "textCodeBlock.background": "#192338",
    "scrollbarSlider.background": "#52668855",
    "scrollbarSlider.hoverBackground": "#52668888",
    "scrollbarSlider.activeBackground": "#526688AA"
  },
  "tokenColors": [
    { "name": "Comments", "scope": ["comment"], "settings": { "foreground": "#8795AD", "fontStyle": "italic" } },
    { "name": "Strings and descriptions", "scope": ["string"], "settings": { "foreground": "#B4CFAB" } },
    { "name": "Language structure", "scope": ["keyword", "storage"], "settings": { "foreground": "#BCA6FF" } },
    { "name": "Numbers and parameters", "scope": ["constant.numeric", "variable.parameter", "constant.language"], "settings": { "foreground": "#F6CE87" } },
    { "name": "Types", "scope": ["support.type", "entity.name.type"], "settings": { "foreground": "#F6CE87" } },
    { "name": "Functions and gates", "scope": ["entity.name.function", "support.function.quantum.qparam"], "settings": { "foreground": "#74DDC5" } },
    { "name": "Document names", "scope": ["entity.name.namespace.qparam"], "settings": { "foreground": "#E3DAFF", "fontStyle": "bold" } },
    { "name": "Specification clauses", "scope": ["keyword.control.specification.qparam"], "settings": { "foreground": "#80D7F4" } },
    { "name": "Explicit assumptions and open proofs", "scope": ["keyword.control.assumption.qparam", "entity.name.assumption.qparam"], "settings": { "foreground": "#FDA4AF" } },
    { "name": "Quantum states", "scope": ["entity.name.state.qparam", "entity.name.state.math.qparam"], "settings": { "foreground": "#C6ABFF" } },
    { "name": "Math operators", "scope": ["keyword.operator", "keyword.operator.math.qparam"], "settings": { "foreground": "#80D7F4" } },
    { "name": "Math commands", "scope": ["support.function.math.qparam", "support.function.layout.math.qparam"], "settings": { "foreground": "#95CAE8" } },
    { "name": "Math delimiters", "scope": ["punctuation.definition.math.begin.qparam", "punctuation.definition.math.end.qparam"], "settings": { "foreground": "#80D7F4", "fontStyle": "bold" } },
    { "name": "Punctuation", "scope": ["punctuation.section", "punctuation.separator"], "settings": { "foreground": "#9AAEC9" } },
    { "name": "Escapes", "scope": ["constant.character.escape"], "settings": { "foreground": "#F6CE87" } },
    { "name": "Invalid syntax", "scope": ["invalid"], "settings": { "foreground": "#FDA4AF" } }
  ]
}
