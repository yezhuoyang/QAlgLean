algorithm gLoop1(q : Qubit[], c : Bit[], W1 : Nat, w1 : Nat, m : Nat, D : Nat, expBase : Nat, dlogBase : Nat, addrBase : Nat, ppBase : Nat, tOff : Nat, cb : Nat) {
  capacity q $\operatorname{top}$
  capacity c $\left(\operatorname{cb} + \left(\operatorname{W1} \cdot \left(\left(\left(\left(2\right)^{\operatorname{w1}} - \operatorname{w1}\right) + \left(2 \cdot D\right)\right) - 2\right)\right)\right)$
  repeat j in 0..W1 {
    call cxCascade(q, c, min(w1, m - j*w1), 1, expBase+j*w1, 1, addrBase) @ id()
    call powerProduct(q, c, w1, addrBase, ppBase) @ id()
    repeat S in 0..2^w1 {
      repeat jOut in 0..D {
        if $\left(\operatorname{mod}\left(\operatorname{shr}\left(\operatorname{Tanf}_{\left(\left(\operatorname{tOff} + \left(j \cdot \left(2\right)^{\operatorname{w1}}\right)\right) + S\right)}, \operatorname{jOut}\right), 2\right) = 1\right)$ {
          CX(q[ppBase+S], q[dlogBase + 3*jOut])
        }
      }
    }
    call gidneyAddNoCarry(q, c, D, cb + j*(2^w1 - w1 + 2*D - 2)) @ shift(dlogBase)
    call mxDescending(q, c, D, dlogBase, 3, cb + j*(2^w1 - w1 + 2*D - 2) + D - 1) @ id()
    repeat b in 0..D {
      when $c_{\left(\left(\left(\left(\operatorname{cb} + \left(j \cdot \left(\left(\left(\left(2\right)^{\operatorname{w1}} - \operatorname{w1}\right) + \left(2 \cdot D\right)\right) - 2\right)\right)\right) + D\right) - 1\right) + b\right)}$ {
        repeat S in 0..2^w1 {
          if $\left(\operatorname{mod}\left(\operatorname{shr}\left(\operatorname{Tanf}_{\left(\left(\operatorname{tOff} + \left(j \cdot \left(2\right)^{\operatorname{w1}}\right)\right) + S\right)}, b\right), 2\right) = 1\right)$ {
            Z(q[ppBase+S])
          }
        }
      }
    }
    call powerProductRelease(q, c, w1, addrBase, ppBase, cb + j*(2^w1 - w1 + 2*D - 2) + 2*D - 1) @ id()
    call cxCascade(q, c, min(w1, m - j*w1), 1, expBase+j*w1, 1, addrBase) @ id()
  }
}

