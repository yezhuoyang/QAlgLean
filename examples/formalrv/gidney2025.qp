  requires $\left(\left(\operatorname{resBase} + \left(3 \cdot \left(\operatorname{ell} + 2\right)\right)\right) \le \operatorname{helpBase}\right)$
  requires $\left(\left(\operatorname{helpBase} + \left(3 \cdot \left(\operatorname{ell} + 2\right)\right)\right) \le \operatorname{addrBase}\right)$
  requires $\left(\left(\operatorname{addrBase} + \left(2 \cdot \operatorname{w3}\right)\right) \le \operatorname{ppBase}\right)$
  requires $\left(\left(\operatorname{addrBase} + \operatorname{w1}\right) \le \operatorname{ppBase}\right)$
  requires $\left(\left(\operatorname{addrBase} + \operatorname{w4}\right) \le \operatorname{ppBase}\right)$
  requires $\left(\left(\operatorname{ppBase} + \left(2\right)^{\operatorname{w1}}\right) \le \operatorname{top}\right)$
