right) \cdot \left(\left(D + \operatorname{cl}\right) - 2\right)\right)\right)\right) + \left(\operatorname{W1} \cdot \left(\left(\left(\left(2\right)^{\operatorname{w1}} - \operatorname{w1}\right) + \left(2 \cdot D\right)\right) - 2\right)\right)\right) + D\right) + \left(\operatorname{W1} \cdot \left(\left(\left(\left(2\right)^{\left\lfloor\frac{\operatorname{w1}}{2}\right\rfloor} + \left(2\right)^{\left(\operatorname{w1} - \left\lfloor\frac{\operatorname{w1}}{2}\right\rfloor\right)}\right) - \operatorname{w1}\right) - 2\right)\right)\right) + f\right) + 1\right)\right)$
  requires $\left(\left(\left(\left(\left(\left(\operatorname{top} + \operatorname{cb}\right) + \operatorname{mx}\right) + \left(\left(\operatorname{mx} - 1\right) \cdot \left(\operatorname{gradBits} - 1\right)\right)\right) + \operatorname{my}\right) + \left(\left(\operatorname{my} - 1\right) \cdot \left(\operatorname{gradBits} - 1\right)\right)\right) \le \operatorname{recBase}\right)$
  requires $\left(\left(\operatorname{recBase} + \left(P \cdot \left(\left(\left(\operatorname{W3a} - 2\right) \cdot \operatorname{W3b}\right) + 2\right)\right)\right) \le \operatorname{recTop}\right)$
