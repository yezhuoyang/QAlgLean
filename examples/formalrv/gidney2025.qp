  requires $\left(2 \le \operatorname{w1}\right)$
  requires $\left(2 \le D\right)$
  requires $\left(m \le \left(\operatorname{W1} \cdot \operatorname{w1}\right)\right)$
  requires $\left(\left(\operatorname{W1} \cdot \operatorname{w1}\right) < \left(m + \operatorname{w1}\right)\right)$
  requires $\left(\operatorname{offL1} = 0\right)$
  requires $\left(\operatorname{mx} \le m\right)$
  requires $\left(2 \le \operatorname{w4}\right)$
  requires $\left(1 \le f\right)$
  requires $\left(\left(\operatorname{ell} + 1\right) \le \left(\operatorname{W4} \cdot \operatorname{w4}\right)\right)$
  requires $\left(2 \le \operatorname{ell}\right)$
  requires $\left(0 < \operatorname{w3}\right)$
  requires $\left(i < P\right)$
  requires $\left(\operatorname{Mtrunc}\left(\operatorname{modN}, \operatorname{shT}\right) \le \operatorname{trunc}\right)$
  requires $\left(\operatorname{trunc} \le \left(2\right)^{f}\right)$
