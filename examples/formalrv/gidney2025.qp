algorithm gLoop3Step(q : Qubit[], c : Bit[], w3 : Nat, ell : Nat, modulus : Nat, dlogBase : Nat, resBase : Nat, addrBase : Nat, ppBase : Nat, helpBase : Nat, j : Nat, k : Nat, tOff : Nat, rslot : Nat, cb : Nat) {
