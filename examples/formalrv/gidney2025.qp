// FormalRV gadget: FormalRV/Audit/Gidney2025/Gidney2025.prog:1825
algorithm gidneyCompare(q : Qubit[], c : Bit[], n : Nat, cb : Nat) {
  capacity q $\left(\left(3 \cdot n\right) + 3\right)$
  capacity c $\left(\operatorname{cb} + n\right)$
  call gidneyForward(q, c, n) @ id()
  CX(q[3*(n-1)+2], q[3*n+2])
  Z(q[3*n+2])
  CX(q[3*(n-1)+2], q[3*n+2])
  repeat k in 0..n {
    if $\left(k \ne 0\right)$ {
      CX(q[3*(n-1-k)+2], q[3*(n-k)+1])
      CX(q[3*(n-1-k)+2], q[3*(n-k)])
    }
    if $\left(\left(\left(n - 1\right) - k\right) \ne 0\right)$ {
      CX(q[3*(n-2-k)+2], q[3*(n-1-k)+2])
    }
    H(q[3*(n-1-k)+2])
    measure q[(3*(n-1-k)+2)] -> c[cb+k]
    when $c_{\left(\operatorname{cb} + k\right)}$ {
      CZ(q[3*(n-1-k)], q[3*(n-1-k)+1])
      X(q[3*(n-1-k)+2])
    }
  }
}

