// FormalRV gadget: FormalRV/Audit/Gidney2025/Gidney2025.prog:1747
algorithm prepMaskedP(q : Qubit[], c : Bit[], W : Nat, p : Nat, flag : Nat) {
  capacity q $\operatorname{max}\left(\left(\operatorname{flag} + 1\right), \left(3 \cdot W\right)\right)$
