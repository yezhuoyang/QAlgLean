  requires $\forall y < \left(2\right)^{m}, \left(\left(\operatorname{dlogAfter}\left(\left(i + 1\right), y\right) < \left(\left(\operatorname{pAt}\left(i\right) - 1\right) \cdot \left(2\right)^{\left(D - \operatorname{cl}\right)}\right)\right)\right)$
  requires $\left(\left(\operatorname{expBase} + m\right) \le \operatorname{dlogBase}\right)$
  requires $\left(\left(\operatorname{dlogBase} + \left(3 \cdot \left(D + 2\right)\right)\right) \le \operatorname{accBase}\right)$
