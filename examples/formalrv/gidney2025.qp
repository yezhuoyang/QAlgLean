// FormalRV gadget: FormalRV/Audit/Gidney2025/Gidney2025.prog:304
algorithm gPrimes(q : Qubit[], c : Bit[], cb : Nat) {
  capacity q $\operatorname{top}$
  capacity c $\left(\operatorname{cb} + \left(P \cdot \left(\left(\left(\left(\left(\left(\operatorname{W1} \cdot \left(\left(\left(\left(2\right)^{\operatorname{w1}} - \operatorname{w1}\right) + \left(2 \cdot D\right)\right) - 2\right)\right) + \left(\left(D - \operatorname{cl}\right) \cdot \left(\left(D + \operatorname{cl}\right) - 2\right)\right)\right) + \left(\left(\left(\left(\left(\left(2\right)^{\left(2 \cdot \operatorname{w3}\right)} - \left(2 \cdot \operatorname{w3}\right)\right) - 1\right) + \left(\left(\operatorname{W3a} - 2\right) \cdot \left(\left(\left(\operatorname{W3b} \cdot \left(\left(\left(2\right)^{\left(2 \cdot \operatorname{w3}\right)} - \left(2 \cdot \operatorname{w3}\right)\right) + \left(3 \cdot \operatorname{ell}\right)\right)\right) + \operatorname{ell}\right) + 1\right)\right)\right) + \operatorname{ell}\right) + 1\right)\right) + \left(\operatorname{W4} \cdot \left(\left(\left(\left(\left(2 \cdot \left(\left(2\right)^{\operatorname{w4}} - \operatorname{w4}\right)\right) + \left(5 \cdot f\right)\right) + \left(2\right)^{\left\lfloor\frac{\operatorname{w4}}{2}\right\rfloor}\right) + \left(2\right)^{\left(\operatorname{w4} - \left\lfloor\frac{\operatorname{w4}}{2}\right\rfloor\right)}\right) - \operatorname{w4}\right)\right)\right) + \left(\left(\left(\left(\left(\operatorname{W3a} - 2\right) \cdot \left(\left(2 \cdot \operatorname{W3b}\right) \cdot \left(\left(\left(\left(2 \cdot \left(\left(\left(2\right)^{\left(2 \cdot \operatorname{w3}\right)} - \left(2 \cdot \operatorname{w3}\right)\right) - 1\right)\right) + \left(5 \cdot \operatorname{ell}\right)\right) + 5\right) + \left(2 \cdot \left(\left(\left(2\right)^{\operatorname{w3}} - \operatorname{w3}\right) - 1\right)\right)\right)\right)\right) + \left(2 \cdot \operatorname{ell}\right)\right) + 2\right) + \left(2 \cdot \left(\left(\left(2\right)^{\operatorname{w3}} - \operatorname{w3}\right) - 1\right)\right)\right)\right) + \left(\left(D - \operatorname{cl}\right) \cdot \left(\left(D + \operatorname{cl}\right) - 2\right)\right)\right)\right)\right)$
  repeat i in 0..P {
    call gOnePrime(q, c, i, cb + i*(W1*(2^w1 - w1 + 2*D - 2) + (D-cl)*(D+cl-2) + (2^(2*w3) - 2*w3 - 1 + (W3a-2)*(W3b*(2^(2*w3) - 2*w3 + 3*ell) + ell + 1) + ell + 1) + W4*(2*(2^w4 - w4) + 5*f + 2^(w4 div 2) + 2^(w4 - w4 div 2) - w4) + ((W3a-2)*(2*W3b*(2*(2^(2*w3) - 2*w3 - 1) + 5*ell + 5 + 2*(2^w3 - w3 - 1))) + 2*ell + 2 + 2*(2^w3 - w3 - 1)) + (D-cl)*(D+cl-2))) @ id()
  }
}

spec gPrimes {
  bind $\alpha$
  requires $\left(0 < \operatorname{W1}\right)$
  requires $\left(2 \le \operatorname{w1}\right)$
  requires $\left(2 \le D\right)$
  requires $\left(0 < P\right)$
  requires $\left(m \le \left(\operatorname{W1} \cdot \operatorname{w1}\right)\right)$
  requires $\left(\left(\operatorname{W1} \cdot \operatorname{w1}\right) < \left(m + \operatorname{w1}\right)\right)$
  requires $\left(\operatorname{offL1} = 0\right)$
  requires $\left(2 \le \operatorname{cl}\right)$
  requires $\left(\operatorname{cl} \le D\right)$
  requires $\left(m < \left(2\right)^{\left(D - \operatorname{cl}\right)}\right)$
  requires $\left(\operatorname{mx} \le m\right)$
  requires $\left(2 \le \operatorname{W3a}\right)$
  requires $\left(\operatorname{ell} \le \left(\operatorname{W3b} \cdot \operatorname{w3}\right)\right)$
  requires $\left(\left(\operatorname{W3a} \cdot \operatorname{w3}\right) \le \operatorname{cl}\right)$
  requires $\left(\left(\operatorname{W3a} \cdot \operatorname{w3}\right) \le D\right)$
  requires $\left(\left(\operatorname{resBase} + \left(3 \cdot \left(\operatorname{W3b} \cdot \operatorname{w3}\right)\right)\right) \le \operatorname{helpBase}\right)$
