rname{w4}}{2}\right\rfloor}\right) + \left(2\right)^{\left(\operatorname{w4} - \left\lfloor\frac{\operatorname{w4}}{2}\right\rfloor\right)}\right) - \operatorname{w4}\right)\right)\right), 1\right)}}\right)\right)\right)\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\sum_{\operatorname{res} < \left(2\right)^{\left(\operatorname{ell} + 1\right)}} \left(\sum_{\operatorname{acc0} < \operatorname{trunc}} \left(\left(\alpha\left(\left(z + \left(\left(2\right)^{\operatorname{dim}} \cdot \left(\operatorname{res} + \left(\left(2\right)^{\left(\operatorname{ell} + 1\right)} \cdot \operatorname{acc0}\right)\right)\right)\right)\right) \cdot \left(\left(\left(\left(\left(\left(\left(\ket{z}_{q_{\operatorname{band}\left(0, \operatorname{cb}, 1\right)}} \otimes \ket{\operatorname{shr}\left(z, \left(\operatorname{cb} + \left(\operatorname{W4} \cdot \left(\left(\left(\left(\left(2 \cdot \left(\left(2\right)^{\operatorname{w4}} - \operatorname{w4}\right)\right) + \left(5 \cdot f\right)\right) + \left(2\right)^{\left\lfloor\frac{\operatorname{w4}}{2}\right\rfloor}\right) + \left(2\right)^{\left(\operatorname{w4} - \left\lfloor\frac{\operatorname{w4}}{2}\right\rfloor\right)}\right) - \operatorname{w4}\right)\right)\right)\right)}_{q_{\operatorname{band}\left(\left(\operatorname{cb} + \left(\operatorname{W4} \cdot \left(\left(\left(\left(\left(2 \cdot \left(\left(2\right)^{\operatorname{w4}} - \operatorname{w4}\right)\right) + \left(5 \cdot f\right)\right) + \left(2\right)^{\left\lfloor\frac{\operatorname{w4}}{2}\right\rfloor}\right) + \left(2\right)^{\left(\operatorname{w4} - \left\lfloor\frac{\operatorname{w4}}{2}\right\rfloor\right)}\right) - \operatorname{w4}\right)\right)\right), \operatorname{dim}, 1\right)}}\right) \otimes \ket{\operatorname{mod}\left(\left(\operatorname{acc0} + \sum_{j < \operatorname{W4}} \left(\operatorname{lookup4Val}\left(\operatorname{w4}, i, j, \operatorname{mod}\left(\operatorname{shr}\left(\operatorname{res}, \left(j \cdot \operatorname{w4}\right)\right), \left(2\right)^{\operatorname{w4}}\right)\right)\right)\right), \operatorname{trunc}\right)}_{q_{\operatorname{band}\left(\left(\operatorname{accBase} + 1\right), \left(\left(\operatorname{accBase} + \left(3 \cdot \left(f + 1\right)\right)\right) + 1\right), 3\right)}}\right) \otimes \ket{\operatorname{res}}_{q_{\operatorname{band}\left(\left(\operatorname{resBase} + 1\right), \left(\left(\operatorname{resBase} + \left(3 \cdot \left(\operatorname{W4} \cdot \operatorname{w4}\right)\right)\right) + 1\right), 3\right)}}\right) \otimes \ket{0}_{q_{\operatorname{band}\left(\operatorname{addrBase}, \left(\operatorname{addrBase} + \operatorname{w4}\right), 1\right)}}\right) \otimes \ket{0}_{q_{\operatorname{band}\left(\operatorname{ppBase}, \left(\operatorname{ppBase} + \left(2\right)^{\operatorname{w4}}\right), 1\right)}}\right) \otimes \ket{0}_{q_{\operatorname{band}\left(\operatorname{accBase}, \left(\operatorname{accBase} + \left(3 \cdot \left(f + 1\right)\right)\right), 3\right)}}\right) \otimes \ket{0}_{q_{\operatorname{band}\left(\left(\operatorname{accBase} + 2\right), \left(\left(\operatorname{accBase} + \left(3 \cdot \left(f + 2\right)\right)\right) + 2\right), 3\right)}}\right)\right)\right)\right)\right)$
  outcomes none
  resource toffoli := $\operatorname{toffL4}\left(\operatorname{w4}, \operatorname{W4}, f\right)$
  resource t := $\left(7 \cdot \operatorname{toffL4}\left(\operatorname{w4}, \operatorname{W4}, f\right)\right)$
  resource rot := $0$
  resource meas := $\operatorname{measL4}\left(\operatorname{w4}, \operatorname{W4}, f\right)$
