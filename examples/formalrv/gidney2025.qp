}

// FormalRV gadget: FormalRV/Audit/Gidney2025/Gidney2025.prog:1119
algorithm gUnloop3Step(q : Qubit[], c : Bit[], w3 : Nat, ell : Nat, modulus : Nat, dlogBase : Nat, resBase : Nat, addrBase : Nat, ppBase : Nat, helpBase : Nat, j : Nat, k : Nat, tOff : Nat, rOff : Nat, cb : Nat) {
  capacity q $\operatorname{top}$
  capacity c $\left(\left(\left(\left(\operatorname{cb} + \left(2 \cdot \left(\left(\left(2\right)^{\left(2 \cdot \operatorname{w3}\right)} - \left(2 \cdot \operatorname{w3}\right)\right) - 1\right)\right)\right) + \left(5 \cdot \operatorname{ell}\right)\right) + 5\right) + \left(2 \cdot \left(\left(\left(2\right)^{\operatorname{w3}} - \operatorname{w3}\right) - 1\right)\right)\right)$
  call cxCascade(q, c, w3, 3, dlogBase+3*(j*w3)+1, 1, addrBase+w3) @ id()
  call cxCascade(q, c, w3, 3, resBase+3*(k*w3)+1, 1, addrBase) @ id()
  call lookupPP(q, c, 2*w3, ell+1, addrBase, ppBase, helpBase, 3, tOff, cb) @ id()
  call gidneyModAddSub(q, c, ell, cb + 2^(2*w3) - 2*w3 - 1) @ shift(helpBase)
  call mxDescending(q, c, ell+1, helpBase, 3, cb + 2^(2*w3) - 2*w3 - 1 + ell) @ id()
  CX(q[helpBase+3*ell+1], q[helpBase+3*(ell+1)+2])
  call conditionalAddPNC(q, c, ell+1, 3*(ell+1)+2, modulus, cb + 2^(2*w3) - 2*w3 - 1 + 2*ell + 1) @ shift(helpBase)
  H(q[helpBase+3*(ell+1)+2])
  measure q[(helpBase+3*(ell+1)+2)] -> c[cb + 2^(2*w3) - 2*w3 - 1 + 2*ell + 1 + ell]
  when $c_{\left(\left(\left(\left(\left(\left(\operatorname{cb} + \left(2\right)^{\left(2 \cdot \operatorname{w3}\right)}\right) - \left(2 \cdot \operatorname{w3}\right)\right) - 1\right) + \left(2 \cdot \operatorname{ell}\right)\right) + 1\right) + \operatorname{ell}\right)}$ {
    X(q[helpBase+3*(ell+1)+2])
  }
  when $c_{\left(\left(\left(\left(\left(\left(\operatorname{cb} + \left(2\right)^{\left(2 \cdot \operatorname{w3}\right)}\right) - \left(2 \cdot \operatorname{w3}\right)\right) - 1\right) + \left(2 \cdot \operatorname{ell}\right)\right) + 1\right) + \operatorname{ell}\right)}$ {
    X(q[helpBase + 3*(ell+1) + 2])
  }
  when $c_{\left(\operatorname{cb} + \operatorname{rOff}\right)}$ {
    X(q[helpBase + 3*(ell+1) + 2])
  }
  measure q[(helpBase + 3*(ell+1) + 2)] -> c[cb + 2^(2*w3) - 2*w3 - 1 + 2*ell + 1 + ell + 1]
  when $c_{\left(\left(\left(\left(\left(\left(\left(\operatorname{cb} + \left(2\right)^{\left(2 \cdot \operatorname{w3}\right)}\right) - \left(2 \cdot \operatorname{w3}\right)\right) - 1\right) + \left(2 \cdot \operatorname{ell}\right)\right) + 1\right) + \operatorname{ell}\right) + 1\right)}$ {
    X(q[helpBase + 3*(ell+1) + 2])
  }
  when $c_{\left(\left(\left(\left(\left(\left(\left(\operatorname{cb} + \left(2\right)^{\left(2 \cdot \operatorname{w3}\right)}\right) - \left(2 \cdot \operatorname{w3}\right)\right) - 1\right) + \left(2 \cdot \operatorname{ell}\right)\right) + 1\right) + \operatorname{ell}\right) + 1\right)}$ {
    call lookupPP(q, c, 2*w3, ell+1, addrBase, ppBase, helpBase, 3, tOff + 2^(2*w3), cb + 2^(2*w3) - 2*w3 - 1 + 3*ell + 3) @ id()
    repeat b in 0..ell+1 {
      X(q[helpBase+3*b+1])
    }
    call gidneyCompare(q, c, ell+1, cb + 2*(2^(2*w3) - 2*w3 - 1) + 3*ell + 3) @ shift(helpBase)
    repeat b in 0..ell+1 {
      X(q[helpBase+3*b+1])
    }
    call mxDescending(q, c, ell+1, helpBase, 3, cb + 2*(2^(2*w3) - 2*w3 - 1) + 4*ell + 4) @ id()
  }
  call powerProduct(q, c, w3, addrBase, ppBase) @ id()
  call powerProduct(q, c, w3, addrBase + w3, ppBase + 2^w3) @ id()
  repeat mL in 0..2^w3 {
    repeat mH in 0..2^w3 {
      when $\bigoplus_{i < \left(\operatorname{ell} + 1\right)} \left(\left(c_{\left(\left(\left(\left(\left(\operatorname{cb} + \left(2\right)^{\left(2 \cdot \operatorname{w3}\right)}\right) - \left(2 \cdot \operatorname{w3}\right)\right) - 1\right) + \operatorname{ell}\right) + i\right)} \land \left(\operatorname{mod}\left(\operatorname{shr}\left(\operatorname{Tbar}_{\left(\left(\left(\operatorname{tOff} \cdot 4096\right) + \left(i \cdot \left(2\right)^{\operatorname{w3}}\right)\right) + \operatorname{mL}\right)}, \operatorname{mH}\right), 2\right) = 1\right)\right)\right)$ {
        CZ(q[ppBase + mL], q[ppBase + 2^w3 + mH])
      }
    }
  }
  repeat mL in 0..2^w3 {
    repeat mH in 0..2^w3 {
      when $\bigoplus_{i < \left(\operatorname{ell} + 1\right)} \left(\left(c_{\left(\left(\left(\left(\operatorname{cb} + \left(2 \cdot \left(\left(\left(2\right)^{\left(2 \cdot \operatorname{w3}\right)} - \left(2 \cdot \operatorname{w3}\right)\right) - 1\right)\right)\right) + \left(4 \cdot \operatorname{ell}\right)\right) + 4\right) + i\right)} \land \left(\operatorname{mod}\left(\operatorname{shr}\left(\operatorname{Tbar}_{\left(\left(\left(\left(\operatorname{tOff} + \left(2\right)^{\left(2 \cdot \operatorname{w3}\right)}\right) \cdot 4096\right) + \left(i \cdot \left(2\right)^{\operatorname{w3}}\right)\right) + \operatorname{mL}\right)}, \operatorname{mH}\right), 2\right) = 1\right)\right)\right)$ {
        CZ(q[ppBase + mL], q[ppBase + 2^w3 + mH])
      }
    }
  }
  call powerProductRelease(q, c, w3, addrBase, ppBase, cb + 2*(2^(2*w3) - 2*w3 - 1) + 5*ell + 5) @ id()
  call powerProductRelease(q, c, w3, addrBase + w3, ppBase + 2^w3, cb + 2*(2^(2*w3) - 2*w3 - 1) + 5*ell + 5 + 2^w3 - w3 - 1) @ id()
  call cxCascade(q, c, w3, 3, resBase+3*(k*w3)+1, 1, addrBase) @ id()
  call cxCascade(q, c, w3, 3, dlogBase+3*(j*w3)+1, 1, addrBase+w3) @ id()
}

spec gUnloop3Step {
