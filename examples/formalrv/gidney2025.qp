// FormalRV gadget: FormalRV/Audit/Gidney2025/Gidney2025.prog:1709
algorithm gidneyAddMeasured(q : Qubit[], c : Bit[], n : Nat, cb : Nat) {
  capacity q $\left(3 \cdot n\right)$
  capacity c $\left(\operatorname{cb} + n\right)$
  call gidneyForward(q, c, n) @ id()
  call finalCxCascade(q, c, n) @ id()
  call gidneyMeasReverse(q, c, n, cb) @ id()
}

// FormalRV gadget: FormalRV/Audit/Gidney2025/Gidney2025.prog:1714
algorithm gidneyMeasReverse(q : Qubit[], c : Bit[], n : Nat, cb : Nat) {
  capacity q $\left(3 \cdot n\right)$
  capacity c $\left(\operatorname{cb} + n\right)$
  call gidneyMeasLastRev(q, c, n-1, cb) @ id()
  repeat k in 0..max(0, n-2) {
    call gidneyMeasInteriorRev(q, c, n-2-k, cb+1+k) @ id()
  }
  call gidneyMeasFirstRev(q, c, cb+n-1) @ id()
}

spec gidneyMeasReverse {
