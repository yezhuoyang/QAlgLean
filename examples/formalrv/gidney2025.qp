{w3}}, \left(\forall \operatorname{mH} < \left(2\right)^{\operatorname{w3}}, \left(\left(\operatorname{bit}\left(\operatorname{Tbar}_{\left(\left(\left(\left(\left(\left(\left(i \cdot \operatorname{primeStride}\right) + \operatorname{offL3b}\right) + \left(\left(2 \cdot \left(\left(\left(\left(\left(\left(\left(\operatorname{W3a} - 1\right) - \operatorname{u2}\right) \cdot \left(2 \cdot \operatorname{W3b}\right)\right) + \operatorname{W3b}\right) + \operatorname{W3b}\right) - 1\right) - \operatorname{k2}\right)\right) \cdot \left(2\right)^{\left(2 \cdot \operatorname{w3}\right)}\right)\right) + \left(\operatorname{cube} \cdot \left(2\right)^{\left(2 \cdot \operatorname{w3}\right)}\right)\right) \cdot 4096\right) + \left(b \cdot \left(2\right)^{\operatorname{w3}}\right)\right) + \operatorname{mL}\right)}, \operatorname{mH}\right) = \operatorname{bit}\left(\operatorname{Tanf}_{\left(\left(\left(\left(\left(\left(i \cdot \operatorname{primeStride}\right) + \operatorname{offL3b}\right) + \left(\left(2 \cdot \left(\left(\left(\left(\left(\left(\left(\operatorname{W3a} - 1\right) - \operatorname{u2}\right) \cdot \left(2 \cdot \operatorname{W3b}\right)\right) + \operatorname{W3b}\right) + \operatorname{W3b}\right) - 1\right) - \operatorname{k2}\right)\right) \cdot \left(2\right)^{\left(2 \cdot \operatorname{w3}\right)}\right)\right) + \left(\operatorname{cube} \cdot \left(2\right)^{\left(2 \cdot \operatorname{w3}\right)}\right)\right) + \operatorname{mL}\right) + \left(\left(2\right)^{\operatorname{w3}} \cdot \operatorname{mH}\right)\right)}, b\right)\right)\right)\right)\right)\right)\right)\right)\right)\right)\right)\right)\right)\right)\right)\right)\right)\right)\right)\right)$
