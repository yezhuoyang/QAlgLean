  requires $\forall \operatorname{cube} < 2, \left(\forall b < \left(\operatorname{ell} + 1\right), \left(\forall \operatorname{mL} < \left(2\right)^{\operatorname{w3}}, \left(\forall \operatorname{mH} < \left(2\right)^{\operatorname{w3}}, \left(\left(\operatorname{bit}\left(\operatorname{Tbar}_{\left(\left(\left(\left(\operatorname{tOff} + \left(\operatorname{cube} \cdot \left(2\right)^{\left(2 \cdot \operatorname{w3}\right)}\right)\right) \cdot 4096\right) + \left(b \cdot \left(2\right)^{\operatorname{w3}}\right)\right) + \operatorname{mL}\right)}, \operatorname{mH}\right) = \operatorname{bit}\left(\operatorname{Tanf}_{\left(\left(\left(\operatorname{tOff} + \left(\operatorname{cube} \cdot \left(2\right)^{\left(2 \cdot \operatorname{w3}\right)}\right)\right) + \operatorname{mL}\right) + \left(\left(2\right)^{\operatorname{w3}} \cdot \operatorname{mH}\right)\right)}, b\right)\right)\right)\right)\right)\right)$
