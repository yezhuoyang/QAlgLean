define mxPut(W : Math, base : Math, stride : Math, y : Math)
equation mxPut(W, base, stride, y) := $\sum_{k < W} \left(\left(\operatorname{bit}\left(y, k\right) \cdot \left(2\right)^{\left(\operatorname{base} + \left(\operatorname{stride} \cdot k\right)\right)}\right)\right)$

define mxClean(W : Math, base : Math, stride : Math, cb : Math, z : Math)
equation mxClean(W, base, stride, cb, z) := $\prod_{k < W} \left(\left(\left(1 - \operatorname{bit}\left(z, \left(\operatorname{base} + \left(\operatorname{stride} \cdot k\right)\right)\right)\right) \cdot \left(1 - \operatorname{bit}\left(z, \left(\operatorname{cb} + k\right)\right)\right)\right)\right)$

define mxSign(W : Math, mr : Math, y : Math)
equation mxSign(W, mr, y) := $\left(-\left(1\right)\right)^{\sum_{k < W} \left(\left(\operatorname{bit}\left(\operatorname{mr}, k\right) \cdot \operatorname{bit}\left(y, k\right)\right)\right)}$

define popCountBelow(n : Math, a : Math)
equation popCountBelow(n, a) := $\sum_{i < n} \left(\operatorname{bit}\left(a, i\right)\right)$

define powMod(b : Math, ex : Math, md : Math)
equation powMod(b, ex, md) := $\begin{cases} 0 & \left(\operatorname{md} \le 1\right) \\ \operatorname{mod}\left(\left(b\right)^{\operatorname{ex}}, \operatorname{md}\right) & \text{otherwise} \end{cases}$

define modInv(a : Math, p : Math)
equation modInv(a, p) := $\operatorname{powMod}\left(a, \left(p - 2\right), p\right)$

define Mtrunc(nMod : Math, tSh : Math)
equation Mtrunc(nMod, tSh) := $\left\lfloor\frac{\operatorname{nMod}}{\left(2\right)^{\operatorname{tSh}}}\right\rfloor$

define contribOf(LL : Math, p : Math)
equation contribOf(LL, p) := $\left(\left\lfloor\frac{\operatorname{LL}}{p}\right\rfloor \cdot \operatorname{modInv}\left(\left\lfloor\frac{\operatorname{LL}}{p}\right\rfloor, p\right)\right)$

define bitXor(n : Math, x : Math, y : Math)
equation bitXor(0, x, y) := $0$

equation bitXor(n+1, x, y) := $\left(\operatorname{bitXor}\left(n, x, y\right) + \left(\operatorname{xor}\left(\operatorname{bit}\left(x, n\right), \operatorname{bit}\left(y, n\right)\right) \cdot \left(2\right)^{n}\right)\right)$

define bitAnd(n : Math, x : Math, y : Math)
equation bitAnd(0, x, y) := $0$

equation bitAnd(n+1, x, y) := $\left(\operatorname{bitAnd}\left(n, x, y\right) + \left(\left(\operatorname{bit}\left(x, n\right) \cdot \operatorname{bit}\left(y, n\right)\right) \cdot \left(2\right)^{n}\right)\right)$

define isSubmask(n : Math, s : Math, a : Math)
equation isSubmask(0, s, a) := $1$

equation isSubmask(n+1, s, a) := $\left(\operatorname{isSubmask}\left(n, s, a\right) \cdot \left(1 - \left(\operatorname{bit}\left(s, n\right) \cdot \left(1 - \operatorname{bit}\left(a, n\right)\right)\right)\right)\right)$

define pAt(i : Math)
equation pAt(i) := $\operatorname{Pmod}_{i}$

define gpAt(i : Math)
equation gpAt(i) := $\operatorname{Gpr}_{i}$

define resProd(nP : Math)
equation resProd(nP) := $\prod_{i < \operatorname{nP}} \left(\operatorname{pAt}\left(i\right)\right)$

define winBitG(wW : Math, mxW : Math, j : Math, b : Math)
equation winBitG(wW, mxW, j, b) := $\begin{cases} \left(2\right)^{\left(\left(j \cdot \operatorname{wW}\right) + b\right)} & \left(\left(\left(j \cdot \operatorname{wW}\right) + b\right) < \operatorname{mxW}\right) \\ 0 & \text{otherwise} \end{cases}$

define winBitH(wW : Math, mxW : Math, j : Math, b : Math)
equation winBitH(wW, mxW, j, b) := $\left(\begin{cases} 0 & \left(\left(\left(j \cdot \operatorname{wW}\right) + b\right) < \operatorname{mxW}\right) \\ \left(2\right)^{\left(\left(\left(j \cdot \operatorname{wW}\right) + b\right) - \operatorname{mxW}\right)} & \text{otherwise} \end{cases} \cdot \begin{cases} 1 & \left(\left(\left(j \cdot \operatorname{wW}\right) + b\right) < m\right) \\ 0 & \text{otherwise} \end{cases}\right)$

define winProd(wW : Math, mxW : Math, j : Math, a : Math)
equation winProd(wW, mxW, j, a) := $\operatorname{mod}\left(\left(\operatorname{powMod}\left(\operatorname{baseG}, \sum_{b < \operatorname{wW}} \left(\left(\operatorname{bit}\left(a, b\right) \cdot \operatorname{winBitG}\left(\operatorname{wW}, \operatorname{mxW}, j, b\right)\right)\right), \operatorname{modN}\right) \cdot \operatorname{powMod}\left(\operatorname{baseH}, \sum_{b < \operatorname{wW}} \left(\left(\operatorname{bit}\left(a, b\right) \cdot \operatorname{winBitH}\left(\operatorname{wW}, \operatorname{mxW}, j, b\right)\right)\right), \operatorname{modN}\right)\right), \operatorname{modN}\right)$

define dwAt(wW : Math, i : Math, j : Math, a : Math)
equation dwAt(wW, i, j, a) := $\operatorname{DLW}_{\left(\left(\left(\left(i \cdot \operatorname{W1}\right) + j\right) \cdot \left(2\right)^{\operatorname{wW}}\right) + a\right)}$

define dwAtP(nP : Math, wW : Math, i : Math, j : Math, a : Math)
equation dwAtP(nP, wW, i, j, a) := $\begin{cases} 0 & \left(\operatorname{nP} \le i\right) \\ \operatorname{dwAt}\left(\operatorname{wW}, i, j, a\right) & \text{otherwise} \end{cases}$

define dwPrev(nP : Math, wW : Math, i : Math, j : Math, a : Math)
equation dwPrev(nP, wW, i, j, a) := $\begin{cases} 0 & \left(i = 0\right) \\ \operatorname{dwAtP}\left(\operatorname{nP}, \operatorname{wW}, \left(i - 1\right), j, a\right) & \text{otherwise} \end{cases}$

define lookup1(nP : Math, mxW : Math, DW : Math, wW : Math, i : Math, j : Math, addr : Math)
equation lookup1(nP, mxW, DW, wW, i, j, addr) := $\operatorname{mod}\left(\left(\left(\operatorname{dwAtP}\left(\operatorname{nP}, \operatorname{wW}, i, j, \operatorname{addr}\right) + \left(2\right)^{\operatorname{DW}}\right) - \operatorname{mod}\left(\operatorname{dwPrev}\left(\operatorname{nP}, \operatorname{wW}, i, j, \operatorname{addr}\right), \left(2\right)^{\operatorname{DW}}\right)\right), \left(2\right)^{\operatorname{DW}}\right)$

define pyLoop1At(j : Math, nP : Math, mxW : Math, DW : Math, wW : Math, i : Math, x0 : Math, y : Math)
equation pyLoop1At(0, nP, mxW, DW, wW, i, x0, y) := $\operatorname{x0}$

equation pyLoop1At(j+1, nP, mxW, DW, wW, i, x0, y) := $\operatorname{mod}\left(\left(\operatorname{pyLoop1At}\left(j, \operatorname{nP}, \operatorname{mxW}, \operatorname{DW}, \operatorname{wW}, i, \operatorname{x0}, y\right) + \operatorname{lookup1}\left(\operatorname{nP}, \operatorname{mxW}, \operatorname{DW}, \operatorname{wW}, i, j, \operatorname{mod}\left(\operatorname{shr}\left(y, \left(j \cdot \operatorname{wW}\right)\right), \left(2\right)^{\operatorname{wW}}\right)\right)\right), \left(2\right)^{\operatorname{DW}}\right)$

define pyLoop1(nP : Math, mxW : Math, DW : Math, wW : Math, WW : Math, i : Math, x0 : Math, y : Math)
equation pyLoop1(nP, mxW, DW, wW, WW, i, x0, y) := $\operatorname{pyLoop1At}\left(\operatorname{WW}, \operatorname{nP}, \operatorname{mxW}, \operatorname{DW}, \operatorname{wW}, i, \operatorname{x0}, y\right)$

define l2thr(clW : Math, md : Math, n : Math)
equation l2thr(clW, md, n) := $\left(\operatorname{md} \cdot \left(2\right)^{\left(n - \operatorname{clW}\right)}\right)$

define l2sub(clW : Math, md : Math, x : Math, n : Math)
equation l2sub(clW, md, x, n) := $\left(\left(x - \operatorname{mod}\left(x, \left(2\right)^{\left(n + 1\right)}\right)\right) + \operatorname{mod}\left(\left(\left(\operatorname{mod}\left(x, \left(2\right)^{\left(n + 1\right)}\right) + \left(2\right)^{\left(n + 1\right)}\right) - \operatorname{mod}\left(\operatorname{l2thr}\left(\operatorname{clW}, \operatorname{md}, n\right), \left(2\right)^{\left(n + 1\right)}\right)\right), \left(2\right)^{\left(n + 1\right)}\right)\right)$

define l2fix(clW : Math, md : Math, y : Math, n : Math)
equation l2fix(clW, md, y, n) := $\begin{cases} \left(\left(y - \operatorname{mod}\left(y, \left(2\right)^{n}\right)\right) + \operatorname{mod}\left(\left(\operatorname{mod}\left(y, \left(2\right)^{n}\right) + \operatorname{l2thr}\left(\operatorname{clW}, \operatorname{md}, n\right)\right), \left(2\right)^{n}\right)\right) & \left(\operatorname{bit}\left(y, n\right) = 1\right) \\ y & \text{otherwise} \end{cases}$

define loop2Step(clW : Math, md : Math, x : Math, n : Math)
equation loop2Step(clW, md, x, n) := $\operatorname{l2fix}\left(\operatorname{clW}, \operatorname{md}, \operatorname{l2sub}\left(\operatorname{clW}, \operatorname{md}, x, n\right), n\right)$

define pyLoop2At(k : Math, DW : Math, clW : Math, md : Math, x0 : Math)
equation pyLoop2At(0, DW, clW, md, x0) := $\operatorname{x0}$

equation pyLoop2At(k+1, DW, clW, md, x0) := $\operatorname{loop2Step}\left(\operatorname{clW}, \operatorname{md}, \operatorname{pyLoop2At}\left(k, \operatorname{DW}, \operatorname{clW}, \operatorname{md}, \operatorname{x0}\right), \left(\left(\operatorname{DW} - 1\right) - k\right)\right)$

define pyLoop2(DW : Math, clW : Math, md : Math, x0 : Math)
equation pyLoop2(DW, clW, md, x0) := $\operatorname{pyLoop2At}\left(\left(\operatorname{DW} - \operatorname{clW}\right), \operatorname{DW}, \operatorname{clW}, \operatorname{md}, \operatorname{x0}\right)$

define u2borrow(clW : Math, md : Math, x : Math, n : Math)
equation u2borrow(clW, md, x, n) := $\begin{cases} \left(\left(x - \operatorname{mod}\left(x, \left(2\right)^{n}\right)\right) + \operatorname{mod}\left(\left(\left(\operatorname{mod}\left(x, \left(2\right)^{n}\right) + \left(2\right)^{n}\right) - \operatorname{mod}\left(\operatorname{l2thr}\left(\operatorname{clW}, \operatorname{md}, n\right), \left(2\right)^{n}\right)\right), \left(2\right)^{n}\right)\right) & \left(\operatorname{bit}\left(x, n\right) = 1\right) \\ x & \text{otherwise} \end{cases}$

define u2add(clW : Math, md : Math, y : Math, n : Math)
equation u2add(clW, md, y, n) := $\left(\left(y - \operatorname{mod}\left(y, \left(2\right)^{\left(n + 1\right)}\right)\right) + \operatorname{mod}\left(\left(\operatorname{mod}\left(y, \left(2\right)^{\left(n + 1\right)}\right) + \operatorname{l2thr}\left(\operatorname{clW}, \operatorname{md}, n\right)\right), \left(2\right)^{\left(n + 1\right)}\right)\right)$

define unloop2Step(clW : Math, md : Math, x : Math, n : Math)
equation unloop2Step(clW, md, x, n) := $\operatorname{u2add}\left(\operatorname{clW}, \operatorname{md}, \operatorname{u2borrow}\left(\operatorname{clW}, \operatorname{md}, x, n\right), n\right)$

define pyUnloop2At(k : Math, DW : Math, clW : Math, md : Math, x0 : Math)
equation pyUnloop2At(0, DW, clW, md, x0) := $\operatorname{x0}$

equation pyUnloop2At(k+1, DW, clW, md, x0) := $\operatorname{unloop2Step}\left(\operatorname{clW}, \operatorname{md}, \operatorname{pyUnloop2At}\left(k, \operatorname{DW}, \operatorname{clW}, \operatorname{md}, \operatorname{x0}\right), \left(\operatorname{clW} + k\right)\right)$

define pyUnloop2(DW : Math, clW : Math, md : Math, x0 : Math)
