      H(q[ppBase + S + 2^(k - 1 - i)])
      measure q[(ppBase + S + 2^(k - 1 - i))] -> c[cb + (2^i - 1)*2^(k - i) - i + (S - 1)]
      when $c_{\left(\left(\left(\operatorname{cb} + \left(\left(\left(2\right)^{i} - 1\right) \cdot \left(2\right)^{\left(k - i\right)}\right)\right) - i\right) + \left(S - 1\right)\right)}$ {
        CZ(q[ppBase + S], q[addrBase + k - 1 - i])
        X(q[ppBase + S + 2^(k - 1 - i)])
      }
    }
  }
  repeat i in 0..k {
    CX(q[addrBase + i], q[ppBase + 2^i])
  }
  X(q[ppBase])
}

spec powerProductRelease {
  bind $\left(\operatorname{keep} < \left(\left(\operatorname{cb} - \left(\operatorname{ppBase} + \left(2\right)^{k}\right)\right) + 1\right)\right)$
  bind $\alpha$
  requires $\left(\left(\operatorname{addrBase} + k\right) \le \operatorname{ppBase}\right)$
  requires $\left(\left(\operatorname{ppBase} + \left(2\right)^{k}\right) \le \operatorname{cb}\right)$
  requires $\left(\left(\operatorname{cb} + \left(\left(\left(2\right)^{k} - k\right) - 1\right)\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\sum_{a < \left(2\right)^{k}} \left(\left(\alpha\left(\left(z + \left(\left(2\right)^{\operatorname{dim}} \cdot a\right)\right)\right) \cdot \left(\left(\left(\left(\ket{z}_{q_{\operatorname{band}\left(0, \left(\left(\operatorname{ppBase} + \left(2\right)^{k}\right) + \operatorname{keep}\right), 1\right)}} \otimes \ket{\operatorname{shr}\left(z, \left(\operatorname{cb} + \left(\left(\left(2\right)^{k} - k\right) - 1\right)\right)\right)}_{q_{\operatorname{band}\left(\left(\operatorname{cb} + \left(\left(\left(2\right)^{k} - k\right) - 1\right)\right), \operatorname{dim}, 1\right)}}\right) \otimes \ket{a}_{q_{\operatorname{band}\left(\operatorname{addrBase}, \left(\operatorname{addrBase} + k\right), 1\right)}}\right) \otimes \ket{\sum_{S < \left(2\right)^{k}} \left(\left(\operatorname{ppSpec}\left(k, a, S\right) \cdot \left(2\right)^{S}\right)\right)}_{q_{\operatorname{band}\left(\operatorname{ppBase}, \left(\operatorname{ppBase} + \left(2\right)^{k}\right), 1\right)}}\right) \otimes \ket{0}_{q_{\operatorname{band}\left(\operatorname{cb}, \left(\operatorname{cb} + \left(\left(\left(2\right)^{k} - k\right) - 1\right)\right), 1\right)}}\right)\right)\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\sum_{a < \left(2\right)^{k}} \left(\left(\alpha\left(\left(z + \left(\left(2\right)^{\operatorname{dim}} \cdot a\right)\right)\right) \cdot \left(\left(\left(\ket{z}_{q_{\operatorname{band}\left(0, \left(\left(\operatorname{ppBase} + \left(2\right)^{k}\right) + \operatorname{keep}\right), 1\right)}} \otimes \ket{\operatorname{shr}\left(z, \left(\operatorname{cb} + \left(\left(\left(2\right)^{k} - k\right) - 1\right)\right)\right)}_{q_{\operatorname{band}\left(\left(\operatorname{cb} + \left(\left(\left(2\right)^{k} - k\right) - 1\right)\right), \operatorname{dim}, 1\right)}}\right) \otimes \ket{a}_{q_{\operatorname{band}\left(\operatorname{addrBase}, \left(\operatorname{addrBase} + k\right), 1\right)}}\right) \otimes \ket{0}_{q_{\operatorname{band}\left(\operatorname{ppBase}, \left(\operatorname{ppBase} + \left(2\right)^{k}\right), 1\right)}}\right)\right)\right)\right)$
  outcomes none
}

// FormalRV gadget: FormalRV/Audit/Gidney2025/Gidney2025.prog:2034
algorithm accYSwapG(q : Qubit[], c : Bit[], bits : Nat, aBase : Nat, aStride : Nat, yBase : Nat, yStride : Nat) {
  capacity q $\operatorname{max}\left(\left(\operatorname{aBase} + \left(\operatorname{aStride} \cdot \operatorname{bits}\right)\right), \left(\operatorname{yBase} + \left(\operatorname{yStride} \cdot \operatorname{bits}\right)\right)\right)$
  capacity c $0$
  call cxCascade(q, c, bits, aStride, aBase, yStride, yBase) @ id()
  call cxCascade(q, c, bits, yStride, yBase, aStride, aBase) @ id()
  call cxCascade(q, c, bits, aStride, aBase, yStride, yBase) @ id()
}

spec accYSwapG {
  bind $\alpha$
  requires $\left(0 < \operatorname{aStride}\right)$
  requires $\left(0 < \operatorname{yStride}\right)$
  requires $\forall i < \operatorname{bits}, \left(\left(\left(\left(\operatorname{aBase} + \left(\operatorname{aStride} \cdot i\right)\right) < \operatorname{dim}\right) \land \left(\left(\operatorname{yBase} + \left(\operatorname{yStride} \cdot i\right)\right) < \operatorname{dim}\right)\right)\right)$
  requires $\forall i < \operatorname{bits}, \left(\forall k < \operatorname{bits}, \left(\left(\left(\operatorname{aBase} + \left(\operatorname{aStride} \cdot i\right)\right) \ne \left(\operatorname{yBase} + \left(\operatorname{yStride} \cdot k\right)\right)\right)\right)\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{z}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{swapRegS}\left(z, \operatorname{aBase}, \operatorname{aStride}, \operatorname{yBase}, \operatorname{yStride}, \operatorname{bits}\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  outcomes none
}

spec prepConst {
  bind $\left(x < \left(2\right)^{W}\right)$
  requires $\left(\left(3 \cdot W\right) \le \operatorname{dim}\right)$
  assumes $\ket{x}_{q_{\operatorname{band}\left(0, \left(3 \cdot W\right), 3\right)}}$
  ensures $\ket{\operatorname{bitXor}\left(W, x, d\right)}_{q_{\operatorname{band}\left(0, \left(3 \cdot W\right), 3\right)}}$
  outcomes none
}

spec prepMaskedP {
  bind $\left(b < 2\right)$
  bind $\left(x < \left(2\right)^{W}\right)$
  requires $\left(\left(3 \cdot W\right) \le \operatorname{dim}\right)$
  requires $\left(\operatorname{flag} < \operatorname{dim}\right)$
  requires $\forall i < W, \left(\left(\operatorname{flag} \ne \left(3 \cdot i\right)\right)\right)$
  assumes $\left(\ket{b}_{q_{\operatorname{flag}}} \otimes \ket{x}_{q_{\operatorname{band}\left(0, \left(3 \cdot W\right), 3\right)}}\right)$
  ensures $\left(\ket{b}_{q_{\operatorname{flag}}} \otimes \ket{\operatorname{bitXor}\left(W, x, \left(b \cdot p\right)\right)}_{q_{\operatorname{band}\left(0, \left(3 \cdot W\right), 3\right)}}\right)$
  outcomes none
}
