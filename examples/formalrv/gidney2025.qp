// FormalRV gadget: FormalRV/Audit/Gidney2025/Gidney2025.prog:2005
algorithm powerProductRelease(q : Qubit[], c : Bit[], k : Nat, addrBase : Nat, ppBase : Nat, cb : Nat) {
  capacity q $\left(\operatorname{ppBase} + \left(2\right)^{k}\right)$
  capacity c $\left(\left(\left(\operatorname{cb} + \left(2\right)^{k}\right) - k\right) - 1\right)$
  repeat i in 0..k {
