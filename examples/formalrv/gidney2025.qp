  call gLoop1(q, c, W1, w1, m, D, expBase, dlogBase, addrBase, ppBase, i*primeStride + offL1, cb) @ id()
  call gLoop2(q, c, D, cl, Pm1[i], dlogBase, cb + W1*(2^w1 - w1 + 2*D - 2)) @ id()
  call gLoop3(q, c, w3, W3a, W3b, ell, Pmod[i], dlogBase, resBase, addrBase, ppBase, helpBase, i*primeStride + offL3c, recBase + i*((W3a-2)*W3b + 2), cb + W1*(2^w1 - w1 + 2*D - 2) + (D-cl)*(D+cl-2)) @ id()
  call gLoop4(q, c, w4, W4, f, trunc, resBase, accBase, addrBase, ppBase, i*primeStride + offL4, cb + W1*(2^w1 - w1 + 2*D - 2) + (D-cl)*(D+cl-2) + (2^(2*w3) - 2*w3 - 1 + (W3a-2)*(W3b*(2^(2*w3) - 2*w3 + 3*ell) + ell + 1) + ell + 1)) @ id()
  call gUnloop3(q, c, w3, W3a, W3b, ell, Pmod[i], dlogBase, resBase, addrBase, ppBase, helpBase, i*primeStride + offL3b, i*primeStride + offL3c, i*primeStride + offL3a, recBase + i*((W3a-2)*W3b + 2), cb + W1*(2^w1 - w1 + 2*D - 2) + (D-cl)*(D+cl-2) + (2^(2*w3) - 2*w3 - 1 + (W3a-2)*(W3b*(2^(2*w3) - 2*w3 + 3*ell) + ell + 1) + ell + 1) + W4*(2*(2^w4 - w4) + 5*f + 2^(w4 div 2) + 2^(w4 - w4 div 2) - w4)) @ id()
  call gUnloop2(q, c, D, cl, Pm1[i], dlogBase, cb + W1*(2^w1 - w1 + 2*D - 2) + (D-cl)*(D+cl-2) + (2^(2*w3) - 2*w3 - 1 + (W3a-2)*(W3b*(2^(2*w3) - 2*w3 + 3*ell) + ell + 1) + ell + 1) + W4*(2*(2^w4 - w4) + 5*f + 2^(w4 div 2) + 2^(w4 - w4 div 2) - w4) + ((W3a-2)*(2*W3b*(2*(2^(2*w3) - 2*w3 - 1) + 5*ell + 5 + 2*(2^w3 - w3 - 1))) + 2*ell + 2 + 2*(2^w3 - w3 - 1))) @ id()
}

spec gOnePrime {
  bind $\alpha$
  requires $\left(2 \le \operatorname{pAt}\left(i\right)\right)$
  requires $\left(\left(\operatorname{pAt}\left(i\right) - 1\right) < \left(2\right)^{\operatorname{cl}}\right)$
  requires $\left(\operatorname{pAt}\left(i\right) \le \left(2\right)^{\operatorname{ell}}\right)$
  requires $\left(\operatorname{Pmod}_{i} = \operatorname{pAt}\left(i\right)\right)$
  requires $\left(\operatorname{Pm1}_{i} = \left(\operatorname{pAt}\left(i\right) - 1\right)\right)$
  requires $\left(2 \le \operatorname{cl}\right)$
  requires $\left(\operatorname{cl} \le D\right)$
  requires $\left(2 \le \operatorname{W3a}\right)$
  requires $\left(\operatorname{ell} \le \left(\operatorname{W3b} \cdot \operatorname{w3}\right)\right)$
  requires $\left(\left(\operatorname{W3a} \cdot \operatorname{w3}\right) \le \operatorname{cl}\right)$
  requires $\left(\left(\operatorname{W3a} \cdot \operatorname{w3}\right) \le D\right)$
  requires $\left(\left(\operatorname{resBase} + \left(3 \cdot \left(\operatorname{W3b} \cdot \operatorname{w3}\right)\right)\right) \le \operatorname{helpBase}\right)$
