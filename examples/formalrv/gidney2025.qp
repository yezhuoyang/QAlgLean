define lookup3cVal(i : Math, addr : Math)
equation lookup3cVal(i, addr) := $\operatorname{powMod}\left(\operatorname{gpAt}\left(i\right), \operatorname{addr}, \operatorname{pAt}\left(i\right)\right)$

define lookup3aVal(wW : Math, i : Math, j : Math, k : Math, addr : Math)
equation lookup3aVal(wW, i, j, k, addr) := $\operatorname{mod}\left(\left(\operatorname{mod}\left(\left(\operatorname{mod}\left(\operatorname{addr}, \left(2\right)^{\operatorname{wW}}\right) \cdot \left(2\right)^{\left(k \cdot \operatorname{wW}\right)}\right), \operatorname{pAt}\left(i\right)\right) \cdot \operatorname{powMod}\left(\operatorname{gpAt}\left(i\right), \left(\operatorname{shr}\left(\operatorname{addr}, \operatorname{wW}\right) \cdot \left(2\right)^{\left(j \cdot \operatorname{wW}\right)}\right), \operatorname{pAt}\left(i\right)\right)\right), \operatorname{pAt}\left(i\right)\right)$

define l3Round(k : Math, wW : Math, i : Math, j : Math, lHi : Math, res : Math)
equation l3Round(0, wW, i, j, lHi, res) := $0$

equation l3Round(k+1, wW, i, j, lHi, res) := $\operatorname{mod}\left(\left(\operatorname{l3Round}\left(k, \operatorname{wW}, i, j, \operatorname{lHi}, \operatorname{res}\right) + \operatorname{lookup3aVal}\left(\operatorname{wW}, i, j, k, \left(\left(\operatorname{lHi} \cdot \left(2\right)^{\operatorname{wW}}\right) + \operatorname{mod}\left(\operatorname{shr}\left(\operatorname{res}, \left(k \cdot \operatorname{wW}\right)\right), \left(2\right)^{\operatorname{wW}}\right)\right)\right)\right), \operatorname{pAt}\left(i\right)\right)$

define l3Outer(u : Math, wW : Math, WB : Math, i : Math, dlog : Math, res : Math)
equation l3Outer(0, wW, WB, i, dlog, res) := $\operatorname{res}$

equation l3Outer(u+1, wW, WB, i, dlog, res) := $\operatorname{l3Round}\left(\operatorname{WB}, \operatorname{wW}, i, \left(u + 2\right), \operatorname{mod}\left(\operatorname{shr}\left(\operatorname{dlog}, \left(\left(u + 2\right) \cdot \operatorname{wW}\right)\right), \left(2\right)^{\operatorname{wW}}\right), \operatorname{l3Outer}\left(u, \operatorname{wW}, \operatorname{WB}, i, \operatorname{dlog}, \operatorname{res}\right)\right)$

define pyLoop3(wW : Math, WA : Math, WB : Math, i : Math, dlog : Math)
equation pyLoop3(wW, WA, WB, i, dlog) := $\operatorname{l3Outer}\left(\left(\operatorname{WA} - 2\right), \operatorname{wW}, \operatorname{WB}, i, \operatorname{dlog}, \operatorname{lookup3cVal}\left(i, \operatorname{mod}\left(\operatorname{dlog}, \left(2\right)^{\left(2 \cdot \operatorname{wW}\right)}\right)\right)\right)$

define lookup3aInvVal(wW : Math, i : Math, j : Math, k : Math, addr : Math)
equation lookup3aInvVal(wW, i, j, k, addr) := $\operatorname{mod}\left(\left(\operatorname{mod}\left(\left(\operatorname{mod}\left(\operatorname{addr}, \left(2\right)^{\operatorname{wW}}\right) \cdot \left(2\right)^{\left(k \cdot \operatorname{wW}\right)}\right), \operatorname{pAt}\left(i\right)\right) \cdot \operatorname{powMod}\left(\operatorname{modInv}\left(\operatorname{gpAt}\left(i\right), \operatorname{pAt}\left(i\right)\right), \left(\operatorname{shr}\left(\operatorname{addr}, \operatorname{wW}\right) \cdot \left(2\right)^{\left(j \cdot \operatorname{wW}\right)}\right), \operatorname{pAt}\left(i\right)\right)\right), \operatorname{pAt}\left(i\right)\right)$

define l3Old(u : Math, wW : Math, WB : Math, i : Math, dlog : Math)
equation l3Old(u, wW, WB, i, dlog) := $\operatorname{l3Outer}\left(u, \operatorname{wW}, \operatorname{WB}, i, \operatorname{dlog}, \operatorname{lookup3cVal}\left(i, \operatorname{mod}\left(\operatorname{dlog}, \left(2\right)^{\left(2 \cdot \operatorname{wW}\right)}\right)\right)\right)$

define l3Wrap(k : Math, wW : Math, i : Math, j : Math, lHi : Math, res : Math)
equation l3Wrap(k, wW, i, j, lHi, res) := $\begin{cases} 1 & \left(\operatorname{l3Round}\left(k, \operatorname{wW}, i, j, \operatorname{lHi}, \operatorname{res}\right) < \operatorname{mod}\left(\left(\operatorname{pAt}\left(i\right) - \operatorname{lookup3aVal}\left(\operatorname{wW}, i, j, k, \left(\left(\operatorname{lHi} \cdot \left(2\right)^{\operatorname{wW}}\right) + \operatorname{mod}\left(\operatorname{shr}\left(\operatorname{res}, \left(k \cdot \operatorname{wW}\right)\right), \left(2\right)^{\operatorname{wW}}\right)\right)\right)\right), \operatorname{pAt}\left(i\right)\right)\right) \\ 0 & \text{otherwise} \end{cases}$

define l3PhaseRound(u : Math, rec : Math, wW : Math, WA : Math, WB : Math, lW : Math, i : Math, dlog : Math)
equation l3PhaseRound(u, rec, wW, WA, WB, lW, i, dlog) := $\left(\sum_{k < \operatorname{WB}} \left(\left(\operatorname{bit}\left(\operatorname{rec}, \left(\left(u \cdot \operatorname{WB}\right) + k\right)\right) \cdot \operatorname{l3Wrap}\left(k, \operatorname{wW}, i, \left(u + 2\right), \operatorname{mod}\left(\operatorname{shr}\left(\operatorname{dlog}, \left(\left(u + 2\right) \cdot \operatorname{wW}\right)\right), \left(2\right)^{\operatorname{wW}}\right), \operatorname{l3Old}\left(u, \operatorname{wW}, \operatorname{WB}, i, \operatorname{dlog}\right)\right)\right)\right) + \sum_{b < \left(\operatorname{lW} + 1\right)} \left(\left(\operatorname{bit}\left(\operatorname{rec}, \left(\left(\left(\left(\operatorname{WA} - 2\right) \cdot \operatorname{WB}\right) + \left(u \cdot \left(\operatorname{lW} + 1\right)\right)\right) + b\right)\right) \cdot \operatorname{bit}\left(\operatorname{l3Old}\left(u, \operatorname{wW}, \operatorname{WB}, i, \operatorname{dlog}\right), b\right)\right)\right)\right)$

define l3Phase(rec : Math, wW : Math, WA : Math, WB : Math, lW : Math, i : Math, dlog : Math)
equation l3Phase(rec, wW, WA, WB, lW, i, dlog) := $\sum_{u < \left(\operatorname{WA} - 2\right)} \left(\operatorname{l3PhaseRound}\left(u, \operatorname{rec}, \operatorname{wW}, \operatorname{WA}, \operatorname{WB}, \operatorname{lW}, i, \operatorname{dlog}\right)\right)$

define l3RecPos(t : Math, wW : Math, WA : Math, WB : Math, lW : Math, recB : Math, cbF : Math)
equation l3RecPos(t, wW, WA, WB, lW, recB, cbF) := $\begin{cases} \left(\operatorname{recB} + t\right) & \left(t < \left(\left(\operatorname{WA} - 2\right) \cdot \operatorname{WB}\right)\right) \\ \left(\left(\left(\left(\left(\left(\operatorname{cbF} + \left(2\right)^{\left(2 \cdot \operatorname{wW}\right)}\right) - \left(2 \cdot \operatorname{wW}\right)\right) - 1\right) + \left(\left\lfloor\frac{\left(t - \left(\left(\operatorname{WA} - 2\right) \cdot \operatorname{WB}\right)\right)}{\left(\operatorname{lW} + 1\right)}\right\rfloor \cdot \left(\left(\left(\operatorname{WB} \cdot \left(\left(\left(2\right)^{\left(2 \cdot \operatorname{wW}\right)} - \left(2 \cdot \operatorname{wW}\right)\right) + \left(3 \cdot \operatorname{lW}\right)\right)\right) + \operatorname{lW}\right) + 1\right)\right)\right) + \left(\operatorname{WB} \cdot \left(\left(\left(2\right)^{\left(2 \cdot \operatorname{wW}\right)} - \left(2 \cdot \operatorname{wW}\right)\right) + \left(3 \cdot \operatorname{lW}\right)\right)\right)\right) + \operatorname{mod}\left(\left(t - \left(\left(\operatorname{WA} - 2\right) \cdot \operatorname{WB}\right)\right), \left(\operatorname{lW} + 1\right)\right)\right) & \text{otherwise} \end{cases}$

define l3RecOf(z : Math, wW : Math, WA : Math, WB : Math, lW : Math, recB : Math, cbF : Math)
equation l3RecOf(z, wW, WA, WB, lW, recB, cbF) := $\sum_{t < \left(\left(\operatorname{WA} - 2\right) \cdot \left(\left(\operatorname{WB} + \operatorname{lW}\right) + 1\right)\right)} \left(\left(\operatorname{bit}\left(z, \operatorname{l3RecPos}\left(t, \operatorname{wW}, \operatorname{WA}, \operatorname{WB}, \operatorname{lW}, \operatorname{recB}, \operatorname{cbF}\right)\right) \cdot \left(2\right)^{t}\right)\right)$

define u3Acc(n : Math, wW : Math, lW : Math, md : Math, WB : Math, tB : Math, a0 : Math, x : Math, r : Math)
equation u3Acc(0, wW, lW, md, WB, tB, a0, x, r) := $\operatorname{a0}$

equation u3Acc(n+1, wW, lW, md, WB, tB, a0, x, r) := $\operatorname{modAddBackVal}\left(\operatorname{lW}, \operatorname{md}, \operatorname{mod}\left(\left(\operatorname{u3Acc}\left(n, \operatorname{wW}, \operatorname{lW}, \operatorname{md}, \operatorname{WB}, \operatorname{tB}, \operatorname{a0}, x, r\right) + \operatorname{lookupVal}\left(\left(2 \cdot \operatorname{wW}\right), \left(\operatorname{lW} + 1\right), \left(\operatorname{tB} + \left(\left(2 \cdot \left(\left(\operatorname{WB} - 1\right) - n\right)\right) \cdot \left(2\right)^{\left(2 \cdot \operatorname{wW}\right)}\right)\right), \left(\operatorname{mod}\left(\operatorname{shr}\left(r, \left(\left(\left(\operatorname{WB} - 1\right) - n\right) \cdot \operatorname{wW}\right)\right), \left(2\right)^{\operatorname{wW}}\right) + \left(\left(2\right)^{\operatorname{wW}} \cdot x\right)\right)\right)\right), \left(2\right)^{\left(\operatorname{lW} + 1\right)}\right)\right)$

define u3Wrap(n : Math, wW : Math, lW : Math, md : Math, WB : Math, tB : Math, a0 : Math, x : Math, r : Math)
equation u3Wrap(n, wW, lW, md, WB, tB, a0, x, r) := $\operatorname{bit}\left(\operatorname{mod}\left(\left(\operatorname{u3Acc}\left(n, \operatorname{wW}, \operatorname{lW}, \operatorname{md}, \operatorname{WB}, \operatorname{tB}, \operatorname{a0}, x, r\right) + \operatorname{lookupVal}\left(\left(2 \cdot \operatorname{wW}\right), \left(\operatorname{lW} + 1\right), \left(\operatorname{tB} + \left(\left(2 \cdot \left(\left(\operatorname{WB} - 1\right) - n\right)\right) \cdot \left(2\right)^{\left(2 \cdot \operatorname{wW}\right)}\right)\right), \left(\operatorname{mod}\left(\operatorname{shr}\left(r, \left(\left(\left(\operatorname{WB} - 1\right) - n\right) \cdot \operatorname{wW}\right)\right), \left(2\right)^{\operatorname{wW}}\right) + \left(\left(2\right)^{\operatorname{wW}} \cdot x\right)\right)\right)\right), \left(2\right)^{\left(\operatorname{lW} + 1\right)}\right), \operatorname{lW}\right)$

define ventSignM(W : Math, mr : Math, tB : Math, ts : Math, z : Math)
equation ventSignM(W, mr, tB, ts, z) := $\left(-\left(1\right)\right)^{\sum_{b < W} \left(\left(\operatorname{bit}\left(\operatorname{mr}, b\right) \cdot \operatorname{bit}\left(z, \left(\operatorname{tB} + \left(\operatorname{ts} \cdot b\right)\right)\right)\right)\right)}$

define l3ResW(WB : Math, wW : Math, lW : Math)
equation l3ResW(WB, wW, lW) := $\begin{cases} \left(\operatorname{lW} + 1\right) & \left(\left(\operatorname{WB} \cdot \operatorname{wW}\right) < \left(\operatorname{lW} + 1\right)\right) \\ \left(\operatorname{WB} \cdot \operatorname{wW}\right) & \text{otherwise} \end{cases}$

define lookup4Val(wW : Math, i : Math, j : Math, addr : Math)
equation lookup4Val(wW, i, j, addr) := $\operatorname{mod}\left(\operatorname{shr}\left(\operatorname{mod}\left(\operatorname{mod}\left(\left(\left(\operatorname{contribOf}\left(\operatorname{resProd}\left(P\right), \operatorname{pAt}\left(i\right)\right) \cdot \left(2\right)^{\left(j \cdot \operatorname{wW}\right)}\right) \cdot \operatorname{addr}\right), \operatorname{resProd}\left(P\right)\right), \operatorname{modN}\right), \operatorname{shT}\right), \operatorname{Mtrunc}\left(\operatorname{modN}, \operatorname{shT}\right)\right)$

define anfFold(s : Math, a : Math, W : Math, tOff : Math, addr : Math)
equation anfFold(0, a, W, tOff, addr) := $0$

equation anfFold(s+1, a, W, tOff, addr) := $\operatorname{bitXor}\left(W, \operatorname{anfFold}\left(s, a, W, \operatorname{tOff}, \operatorname{addr}\right), \left(\operatorname{isSubmask}\left(a, s, \operatorname{addr}\right) \cdot \operatorname{Tanf}_{\left(\operatorname{tOff} + s\right)}\right)\right)$

define lookupVal(a : Math, W : Math, tOff : Math, addr : Math)
equation lookupVal(a, W, tOff, addr) := $\operatorname{anfFold}\left(\left(2\right)^{a}, a, W, \operatorname{tOff}, \operatorname{addr}\right)$

define modAddBackVal(bits : Math, p : Math, b : Math)
equation modAddBackVal(bits, p, b) := $\operatorname{mod}\left(\left(b + \left(\operatorname{bit}\left(b, \operatorname{bits}\right) \cdot p\right)\right), \left(2\right)^{\left(\operatorname{bits} + 1\right)}\right)$

define cmpCarry(n : Math, a : Math, b : Math)
equation cmpCarry(n, a, b) := $\begin{cases} 1 & \left(\left(2\right)^{n} \le \left(a + b\right)\right) \\ 0 & \text{otherwise} \end{cases}$

define rzIndex(g : Math, i : Math)
equation rzIndex(g, i) := $\left(\left(g - i\right) - 1\right)$

define gnConst(g : Math, w : Math, j : Math, mrec : Math)
equation gnConst(g, w, j, mrec) := $\sum_{d < \operatorname{min}\left(g, \left(w - j\right)\right)} \left(\begin{cases} 0 & \left(d = 0\right) \\ \left(\operatorname{bit}\left(\operatorname{mrec}, \left(j + d\right)\right) \cdot \left(2\right)^{\left(\left(g - d\right) - 1\right)}\right) & \text{otherwise} \end{cases}\right)$

define ehSum(d : Math)
equation ehSum(d) := $\left(d + 2\right)$

define ehDisc(d : Math, nMod : Math)
equation ehDisc(d, nMod) := $\left(\left(\operatorname{ehSum}\left(d\right) \cdot \operatorname{ehSum}\left(d\right)\right) - \left(4 \cdot \operatorname{nMod}\right)\right)$

define ehFactor(d : Math, nMod : Math)
equation ehFactor(d, nMod) := $\frac{\left(\operatorname{ehSum}\left(d\right) - \sqrt{\operatorname{ehDisc}\left(d, \operatorname{nMod}\right)}\right)}{2}$

define ekeraBalancedFactor(Delta : Math, tB : Math, tau : Math)
equation ekeraBalancedFactor(Delta, tB, tau) := $\begin{cases} \left(1 - \frac{\left(2\right)^{\left(\operatorname{Delta} + 2\right)}}{\left(\left(2\right)^{\left(2 \cdot \operatorname{tB}\right)} \cdot \left(2\right)^{\operatorname{tau}}\right)}\right) & \left(\left(2\right)^{\left(\operatorname{Delta} + 2\right)} < \left(\left(2\right)^{\left(2 \cdot \operatorname{tB}\right)} \cdot \left(2\right)^{\operatorname{tau}}\right)\right) \\ 0 & \text{otherwise} \end{cases}$

define bmodAbs(u : Math, nMod : Math)
equation bmodAbs(u, nMod) := $\begin{cases} \operatorname{mod}\left(u, \operatorname{nMod}\right) & \left(\operatorname{mod}\left(u, \operatorname{nMod}\right) < \left\lfloor\frac{\left(\operatorname{nMod} + 1\right)}{2}\right\rfloor\right) \\ \left(\operatorname{nMod} - \operatorname{mod}\left(u, \operatorname{nMod}\right)\right) & \text{otherwise} \end{cases}$

define ehGoodPair(mW : Math, lW : Math, d : Math, j : Math, k : Math)
equation ehGoodPair(mW, lW, d, j, k) := $\left(\operatorname{bmodAbs}\left(\left(\left(d \cdot j\right) + \left(\left(2\right)^{\operatorname{mW}} \cdot k\right)\right), \left(2\right)^{\left(\operatorname{lW} + \operatorname{mW}\right)}\right) \le \left(2\right)^{\left(\operatorname{mW} - 2\right)}\right)$

define toffLk(a : Math)
equation toffLk(a) := $\left(\left(\left(2\right)^{a} - a\right) - 1\right)$

define cliffPPTotal(k : Math)
equation cliffPPTotal(k) := $\left(\left(\left(5 \cdot \left(\left(\left(2\right)^{k} - k\right) - 1\right)\right) + \left(2 \cdot k\right)\right) + 2\right)$

define cxTable(a : Math, W : Math, tOff : Math)
equation cxTable(a, W, tOff) := $\sum_{s < \left(2\right)^{a}} \left(\operatorname{popCountBelow}\left(W, \operatorname{Tanf}_{\left(\operatorname{tOff} + s\right)}\right)\right)$

define cliffLk(a : Math, W : Math, tOff : Math)
equation cliffLk(a, W, tOff) := $\left(\operatorname{cliffPPTotal}\left(a\right) + \operatorname{cxTable}\left(a, W, \operatorname{tOff}\right)\right)$

define toffVent(n : Math)
equation toffVent(n) := $\left(\operatorname{toffLk}\left(\left\lfloor\frac{n}{2}\right\rfloor\right) + \operatorname{toffLk}\left(\left(n - \left\lfloor\frac{n}{2}\right\rfloor\right)\right)\right)$

define czParity(n : Math)
equation czParity(n) := $\left(\left(2\right)^{\left\lfloor\frac{n}{2}\right\rfloor} \cdot \left(2\right)^{\left(n - \left\lfloor\frac{n}{2}\right\rfloor\right)}\right)$

define cliffVent(n : Math)
equation cliffVent(n) := $\left(\left(\operatorname{cliffPPTotal}\left(\left\lfloor\frac{n}{2}\right\rfloor\right) + \operatorname{cliffPPTotal}\left(\left(n - \left\lfloor\frac{n}{2}\right\rfloor\right)\right)\right) + \left(3 \cdot \operatorname{czParity}\left(n\right)\right)\right)$

define cliffAddConst(W : Math, d : Math)
equation cliffAddConst(W, d) := $\left(\left(\left(2 \cdot \operatorname{popCountBelow}\left(W, d\right)\right) + \left(14 \cdot W\right)\right) - 6\right)$

define cliffAddConstNC(W : Math, d : Math)
equation cliffAddConstNC(W, d) := $\left(\left(\left(2 \cdot \operatorname{popCountBelow}\left(W, d\right)\right) + \left(14 \cdot W\right)\right) - 15\right)$

define cliffCondAdd(W : Math, p : Math)
equation cliffCondAdd(W, p) := $\left(\left(\left(2 \cdot \operatorname{popCountBelow}\left(W, p\right)\right) + \left(14 \cdot W\right)\right) - 15\right)$

define cliffCmp(n : Math)
equation cliffCmp(n) := $\left(\left(11 \cdot n\right) - 3\right)$

define cliffBack(bits : Math, p : Math)
equation cliffBack(bits, p) := $\left(\left(\left(2 \cdot \operatorname{popCountBelow}\left(\left(\operatorname{bits} + 1\right), p\right)\right) + \left(14 \cdot \operatorname{bits}\right)\right) + 2\right)$

define toffL1(WW : Math, wW : Math, DW : Math)
equation toffL1(WW, wW, DW) := $\left(\operatorname{WW} \cdot \left(\left(\operatorname{toffLk}\left(\operatorname{wW}\right) + \operatorname{DW}\right) - 1\right)\right)$

define measL1(WW : Math, wW : Math, DW : Math)
equation measL1(WW, wW, DW) := $\left(\operatorname{WW} \cdot \left(\left(\operatorname{toffLk}\left(\operatorname{wW}\right) + \left(2 \cdot \operatorname{DW}\right)\right) - 1\right)\right)$

define cliffL1(WW : Math, wW : Math, mW : Math, DW : Math, tOff : Math)
equation cliffL1(WW, wW, mW, DW, tOff) := $\sum_{j < \operatorname{WW}} \left(\left(\left(\left(\left(\left(2 \cdot \operatorname{min}\left(\operatorname{wW}, \left(\operatorname{mW} - \left(j \cdot \operatorname{wW}\right)\right)\right)\right) + \operatorname{cliffLk}\left(\operatorname{wW}, \operatorname{DW}, \left(\operatorname{tOff} + \left(j \cdot \left(2\right)^{\operatorname{wW}}\right)\right)\right)\right) + \operatorname{cliffAdd}\left(\operatorname{DW}\right)\right) + \left(2 \cdot \operatorname{DW}\right)\right) + \operatorname{cxTable}\left(\operatorname{wW}, \operatorname{DW}, \left(\operatorname{tOff} + \left(j \cdot \left(2\right)^{\operatorname{wW}}\right)\right)\right)\right)\right)$

define cliffL2Step(n : Math, clW : Math, md : Math)
equation cliffL2Step(n, clW, md) := $\left(\operatorname{cliffAddConstNC}\left(\left(n + 1\right), \left(\left(2\right)^{\left(n + 1\right)} - \left(\operatorname{md} \cdot \left(2\right)^{\left(n - \operatorname{clW}\right)}\right)\right)\right) + \operatorname{cliffCondAdd}\left(n, \left(\operatorname{md} \cdot \left(2\right)^{\left(n - \operatorname{clW}\right)}\right)\right)\right)$

define cliffU2Step(n : Math, clW : Math, md : Math)
equation cliffU2Step(n, clW, md) := $\left(\operatorname{cliffCondAdd}\left(n, \left(\left(2\right)^{n} - \left(\operatorname{md} \cdot \left(2\right)^{\left(n - \operatorname{clW}\right)}\right)\right)\right) + \operatorname{cliffAddConstNC}\left(\left(n + 1\right), \left(\operatorname{md} \cdot \left(2\right)^{\left(n - \operatorname{clW}\right)}\right)\right)\right)$

define toffL2(DW : Math, clW : Math)
equation toffL2(DW, clW) := $\sum_{u < \left(\operatorname{DW} - \operatorname{clW}\right)} \left(\left(\left(2 \cdot \left(\left(\operatorname{DW} - 1\right) - u\right)\right) - 1\right)\right)$

define cliffL2(DW : Math, clW : Math, md : Math)
equation cliffL2(DW, clW, md) := $\sum_{u < \left(\operatorname{DW} - \operatorname{clW}\right)} \left(\operatorname{cliffL2Step}\left(\left(\left(\operatorname{DW} - 1\right) - u\right), \operatorname{clW}, \operatorname{md}\right)\right)$

define toffU2(DW : Math, clW : Math)
equation toffU2(DW, clW) := $\sum_{u < \left(\operatorname{DW} - \operatorname{clW}\right)} \left(\left(\left(2 \cdot \left(\operatorname{clW} + u\right)\right) - 1\right)\right)$

define cliffU2(DW : Math, clW : Math, md : Math)
equation cliffU2(DW, clW, md) := $\sum_{u < \left(\operatorname{DW} - \operatorname{clW}\right)} \left(\operatorname{cliffU2Step}\left(\left(\operatorname{clW} + u\right), \operatorname{clW}, \operatorname{md}\right)\right)$

define toffL3Step(wW : Math, ellW : Math)
equation toffL3Step(wW, ellW) := $\left(\operatorname{toffLk}\left(\left(2 \cdot \operatorname{wW}\right)\right) + \left(2 \cdot \operatorname{ellW}\right)\right)$

define measL3Step(wW : Math, ellW : Math)
equation measL3Step(wW, ellW) := $\left(\left(\operatorname{toffLk}\left(\left(2 \cdot \operatorname{wW}\right)\right) + \left(3 \cdot \operatorname{ellW}\right)\right) + 2\right)$

define cliffL3Step(wW : Math, ellW : Math, md : Math, tOff : Math)
equation cliffL3Step(wW, ellW, md, tOff) := $\left(\left(\left(\left(\left(\left(4 \cdot \operatorname{wW}\right) + \operatorname{cliffLk}\left(\left(2 \cdot \operatorname{wW}\right), \left(\operatorname{ellW} + 1\right), \operatorname{tOff}\right)\right) + \operatorname{cliffAdd}\left(\left(\operatorname{ellW} + 1\right)\right)\right) + \left(2 \cdot \left(\operatorname{ellW} + 1\right)\right)\right) + \operatorname{cliffBack}\left(\operatorname{ellW}, \operatorname{md}\right)\right) + \operatorname{cxTable}\left(\left(2 \cdot \operatorname{wW}\right), \left(\operatorname{ellW} + 1\right), \operatorname{tOff}\right)\right)$

define toffL3(wW : Math, WA : Math, WB : Math, ellW : Math)
equation toffL3(wW, WA, WB, ellW) := $\left(\operatorname{toffLk}\left(\left(2 \cdot \operatorname{wW}\right)\right) + \left(\left(\left(\operatorname{WA} - 2\right) \cdot \operatorname{WB}\right) \cdot \operatorname{toffL3Step}\left(\operatorname{wW}, \operatorname{ellW}\right)\right)\right)$

define measL3(wW : Math, WA : Math, WB : Math, ellW : Math)
equation measL3(wW, WA, WB, ellW) := $\left(\left(\left(\operatorname{toffLk}\left(\left(2 \cdot \operatorname{wW}\right)\right) + \left(\left(\operatorname{WA} - 2\right) \cdot \left(\left(\left(\operatorname{WB} \cdot \operatorname{measL3Step}\left(\operatorname{wW}, \operatorname{ellW}\right)\right) + \operatorname{ellW}\right) + 1\right)\right)\right) + \operatorname{ellW}\right) + 1\right)$

define cliffL3(wW : Math, WA : Math, WB : Math, ellW : Math, md : Math, tOff : Math)
equation cliffL3(wW, WA, WB, ellW, md, tOff) := $\left(\left(\left(\left(\left(\left(4 \cdot \operatorname{wW}\right) + \operatorname{cliffLk}\left(\left(2 \cdot \operatorname{wW}\right), \left(\operatorname{ellW} + 1\right), \operatorname{tOff}\right)\right) + \sum_{j < \left(\operatorname{WA} - 2\right)} \left(\sum_{k < \operatorname{WB}} \left(\operatorname{cliffL3Step}\left(\operatorname{wW}, \operatorname{ellW}, \operatorname{md}, \left(\left(\operatorname{tOff} + \left(2\right)^{\left(2 \cdot \operatorname{wW}\right)}\right) + \left(\left(\left(\left(j + 2\right) \cdot \operatorname{WB}\right) + k\right) \cdot \left(2\right)^{\left(2 \cdot \operatorname{wW}\right)}\right)\right)\right)\right)\right)\right) + \left(\left(\left(\operatorname{WA} - 2\right) \cdot 5\right) \cdot \left(\operatorname{ellW} + 1\right)\right)\right) + \operatorname{ellW}\right) + 1\right)$

define toffL4Step(wW : Math, fW : Math)
equation toffL4Step(wW, fW) := $\left(\left(\left(\left(2 \cdot \operatorname{toffLk}\left(\operatorname{wW}\right)\right) + \left(3 \cdot \operatorname{fW}\right)\right) + 1\right) + \operatorname{toffVent}\left(\operatorname{wW}\right)\right)$

define measL4Step(wW : Math, fW : Math)
equation measL4Step(wW, fW) := $\left(\left(\left(\left(2 \cdot \operatorname{toffLk}\left(\operatorname{wW}\right)\right) + \left(5 \cdot \operatorname{fW}\right)\right) + 4\right) + \operatorname{toffVent}\left(\operatorname{wW}\right)\right)$

define cliffL4Step(wW : Math, fW : Math, tr : Math, tOff : Math)
equation cliffL4Step(wW, fW, tr, tOff) := $\left(\left(\left(\left(\left(\left(\left(\left(\left(\left(2 \cdot \operatorname{wW}\right) + \operatorname{cliffLk}\left(\operatorname{wW}, \left(\operatorname{fW} + 1\right), \operatorname{tOff}\right)\right) + \operatorname{cliffAdd}\left(\left(\operatorname{fW} + 1\right)\right)\right) + \left(2 \cdot \left(\operatorname{fW} + 1\right)\right)\right) + \operatorname{cliffBack}\left(\operatorname{fW}, \operatorname{tr}\right)\right) + \operatorname{cliffLk}\left(\operatorname{wW}, \left(\operatorname{fW} + 1\right), \left(\operatorname{tOff} + \left(2\right)^{\operatorname{wW}}\right)\right)\right) + \operatorname{cliffCmp}\left(\left(\operatorname{fW} + 1\right)\right)\right) + \left(2 \cdot \left(\operatorname{fW} + 1\right)\right)\right) + \operatorname{cliffVent}\left(\operatorname{wW}\right)\right) + \left(3 \cdot \operatorname{czParity}\left(\operatorname{wW}\right)\right)\right)$

define toffL4(wW : Math, WF : Math, fW : Math)
equation toffL4(wW, WF, fW) := $\left(\operatorname{WF} \cdot \operatorname{toffL4Step}\left(\operatorname{wW}, \operatorname{fW}\right)\right)$

define measL4(wW : Math, WF : Math, fW : Math)
equation measL4(wW, WF, fW) := $\left(\operatorname{WF} \cdot \operatorname{measL4Step}\left(\operatorname{wW}, \operatorname{fW}\right)\right)$

define cliffL4(wW : Math, WF : Math, fW : Math, tr : Math, tOff : Math)
equation cliffL4(wW, WF, fW, tr, tOff) := $\sum_{j < \operatorname{WF}} \left(\operatorname{cliffL4Step}\left(\operatorname{wW}, \operatorname{fW}, \operatorname{tr}, \left(\operatorname{tOff} + \left(\left(j \cdot 2\right) \cdot \left(2\right)^{\operatorname{wW}}\right)\right)\right)\right)$

define toffU3Step(wW : Math, ellW : Math)
equation toffU3Step(wW, ellW) := $\left(\left(\left(\left(2 \cdot \operatorname{toffLk}\left(\left(2 \cdot \operatorname{wW}\right)\right)\right) + \left(3 \cdot \operatorname{ellW}\right)\right) + 1\right) + \operatorname{toffVent}\left(\left(2 \cdot \operatorname{wW}\right)\right)\right)$

define measU3Step(wW : Math, ellW : Math)
equation measU3Step(wW, ellW) := $\left(\left(\left(\left(2 \cdot \operatorname{toffLk}\left(\left(2 \cdot \operatorname{wW}\right)\right)\right) + \left(5 \cdot \operatorname{ellW}\right)\right) + 5\right) + \operatorname{toffVent}\left(\left(2 \cdot \operatorname{wW}\right)\right)\right)$

define cliffU3Step(wW : Math, ellW : Math, md : Math, tOff : Math)
equation cliffU3Step(wW, ellW, md, tOff) := $\left(\left(\left(\left(\left(\left(\left(\left(\left(\left(\left(\left(4 \cdot \operatorname{wW}\right) + \operatorname{cliffLk}\left(\left(2 \cdot \operatorname{wW}\right), \left(\operatorname{ellW} + 1\right), \operatorname{tOff}\right)\right) + \operatorname{cliffAdd}\left(\left(\operatorname{ellW} + 1\right)\right)\right) + \left(2 \cdot \left(\operatorname{ellW} + 1\right)\right)\right) + \operatorname{cliffBack}\left(\operatorname{ellW}, \operatorname{md}\right)\right) + 3\right) + \operatorname{cliffLk}\left(\left(2 \cdot \operatorname{wW}\right), \left(\operatorname{ellW} + 1\right), \left(\operatorname{tOff} + \left(2\right)^{\left(2 \cdot \operatorname{wW}\right)}\right)\right)\right) + \operatorname{cliffCmp}\left(\left(\operatorname{ellW} + 1\right)\right)\right) + \left(2 \cdot \left(\operatorname{ellW} + 1\right)\right)\right) + \operatorname{cliffVent}\left(\left(2 \cdot \operatorname{wW}\right)\right)\right) + \left(3 \cdot \operatorname{czParity}\left(\left(2 \cdot \operatorname{wW}\right)\right)\right)\right) + \left(2 \cdot \left(\operatorname{ellW} + 1\right)\right)\right)$

define toffU3(wW : Math, WA : Math, WB : Math, ellW : Math)
equation toffU3(wW, WA, WB, ellW) := $\left(\left(\left(\left(\left(\operatorname{WA} - 2\right) \cdot 2\right) \cdot \operatorname{WB}\right) \cdot \operatorname{toffU3Step}\left(\operatorname{wW}, \operatorname{ellW}\right)\right) + \operatorname{toffVent}\left(\left(2 \cdot \operatorname{wW}\right)\right)\right)$

define measU3(wW : Math, WA : Math, WB : Math, ellW : Math)
equation measU3(wW, WA, WB, ellW) := $\left(\left(\left(\left(\left(\left(\operatorname{WA} - 2\right) \cdot 2\right) \cdot \operatorname{WB}\right) \cdot \operatorname{measU3Step}\left(\operatorname{wW}, \operatorname{ellW}\right)\right) + \left(2 \cdot \left(\operatorname{ellW} + 1\right)\right)\right) + \operatorname{toffVent}\left(\left(2 \cdot \operatorname{wW}\right)\right)\right)$

define cliffU3(wW : Math, WA : Math, WB : Math, ellW : Math, md : Math, tOff : Math, vA : Math, vC : Math)
equation cliffU3(wW, WA, WB, ellW, md, tOff, vA, vC) := $\left(\left(\left(\left(\left(\sum_{u < \left(\operatorname{WA} - 2\right)} \left(\sum_{k < \operatorname{WB}} \left(\operatorname{cliffU3Step}\left(\operatorname{wW}, \operatorname{ellW}, \operatorname{md}, \left(\operatorname{tOff} + \left(\left(2 \cdot \left(\left(\left(u + 2\right) \cdot \left(2 \cdot \operatorname{WB}\right)\right) + k\right)\right) \cdot \left(2\right)^{\left(2 \cdot \operatorname{wW}\right)}\right)\right)\right)\right)\right) + \sum_{u < \left(\operatorname{WA} - 2\right)} \left(\sum_{k < \operatorname{WB}} \left(\operatorname{cliffU3Step}\left(\operatorname{wW}, \operatorname{ellW}, \operatorname{md}, \left(\operatorname{tOff} + \left(\left(2 \cdot \left(\left(\left(\left(u + 2\right) \cdot \left(2 \cdot \operatorname{WB}\right)\right) + \operatorname{WB}\right) + k\right)\right) \cdot \left(2\right)^{\left(2 \cdot \operatorname{wW}\right)}\right)\right)\right)\right)\right)\right) + \left(\left(\left(\operatorname{WA} - 2\right) \cdot 4\right) \cdot \left(\operatorname{ellW} + 1\right)\right)\right) + \left(3 \cdot \left(\operatorname{ellW} + 1\right)\right)\right) + \left(4 \cdot \operatorname{wW}\right)\right) + \operatorname{cliffVent}\left(\left(2 \cdot \operatorname{wW}\right)\right)\right)$

define toffOnePrime(i : Math)
equation toffOnePrime(i) := $\left(\left(\left(\left(\left(\operatorname{toffL1}\left(\operatorname{W1}, \operatorname{w1}, D\right) + \operatorname{toffL2}\left(D, \operatorname{cl}\right)\right) + \operatorname{toffL3}\left(\operatorname{w3}, \operatorname{W3a}, \operatorname{W3b}, \operatorname{ell}\right)\right) + \operatorname{toffL4}\left(\operatorname{w4}, \operatorname{W4}, f\right)\right) + \operatorname{toffU3}\left(\operatorname{w3}, \operatorname{W3a}, \operatorname{W3b}, \operatorname{ell}\right)\right) + \operatorname{toffU2}\left(D, \operatorname{cl}\right)\right)$

define measOnePrime(i : Math)
equation measOnePrime(i) := $\left(\left(\left(\left(\left(\operatorname{measL1}\left(\operatorname{W1}, \operatorname{w1}, D\right) + \operatorname{toffL2}\left(D, \operatorname{cl}\right)\right) + \operatorname{measL3}\left(\operatorname{w3}, \operatorname{W3a}, \operatorname{W3b}, \operatorname{ell}\right)\right) + \operatorname{measL4}\left(\operatorname{w4}, \operatorname{W4}, f\right)\right) + \operatorname{measU3}\left(\operatorname{w3}, \operatorname{W3a}, \operatorname{W3b}, \operatorname{ell}\right)\right) + \operatorname{toffU2}\left(D, \operatorname{cl}\right)\right)$

define cliffOnePrime(i : Math)
equation cliffOnePrime(i) := $\left(\left(\left(\left(\left(\operatorname{cliffL1}\left(\operatorname{W1}, \operatorname{w1}, m, D, \left(\left(i \cdot \operatorname{primeStride}\right) + \operatorname{offL1}\right)\right) + \operatorname{cliffL2}\left(D, \operatorname{cl}, \left(\operatorname{pAt}\left(i\right) - 1\right)\right)\right) + \operatorname{cliffL3}\left(\operatorname{w3}, \operatorname{W3a}, \operatorname{W3b}, \operatorname{ell}, \operatorname{pAt}\left(i\right), \left(\left(i \cdot \operatorname{primeStride}\right) + \operatorname{offL3c}\right)\right)\right) + \operatorname{cliffL4}\left(\operatorname{w4}, \operatorname{W4}, f, \operatorname{trunc}, \left(\left(i \cdot \operatorname{primeStride}\right) + \operatorname{offL4}\right)\right)\right) + \operatorname{cliffU3}\left(\operatorname{w3}, \operatorname{W3a}, \operatorname{W3b}, \operatorname{ell}, \operatorname{pAt}\left(i\right), \left(\left(i \cdot \operatorname{primeStride}\right) + \operatorname{offL3b}\right), \left(\left(i \cdot \operatorname{primeStride}\right) + \operatorname{offL3a}\right), \left(\left(i \cdot \operatorname{primeStride}\right) + \operatorname{offL3c}\right)\right)\right) + \operatorname{cliffU2}\left(D, \operatorname{cl}, \left(\operatorname{pAt}\left(i\right) - 1\right)\right)\right)$

define toffTail(tOff : Math)
equation toffTail(tOff) := $\left(\operatorname{toffL1}\left(\operatorname{W1}, \operatorname{w1}, D\right) + \left(\operatorname{W1} \cdot \operatorname{toffVent}\left(\operatorname{w1}\right)\right)\right)$

define measTail(tOff : Math)
equation measTail(tOff) := $\left(\left(\operatorname{measL1}\left(\operatorname{W1}, \operatorname{w1}, D\right) + D\right) + \left(\operatorname{W1} \cdot \operatorname{toffVent}\left(\operatorname{w1}\right)\right)\right)$

define cliffTail(tOff : Math)
equation cliffTail(tOff) := $\left(\left(\operatorname{cliffL1}\left(\operatorname{W1}, \operatorname{w1}, m, D, \operatorname{tOff}\right) + D\right) + \sum_{j < \operatorname{W1}} \left(\left(\left(2 \cdot \operatorname{min}\left(\operatorname{w1}, \left(m - \left(j \cdot \operatorname{w1}\right)\right)\right)\right) + \operatorname{cliffVent}\left(\operatorname{w1}\right)\right)\right)\right)$

define toffApprox(nP : Math)
equation toffApprox(nP) := $\left(\sum_{i < \operatorname{nP}} \left(\operatorname{toffOnePrime}\left(i\right)\right) + \operatorname{toffTail}\left(\left(\operatorname{nP} \cdot \operatorname{primeStride}\right)\right)\right)$

define measApprox(nP : Math)
equation measApprox(nP) := $\left(\sum_{i < \operatorname{nP}} \left(\operatorname{measOnePrime}\left(i\right)\right) + \operatorname{measTail}\left(\left(\operatorname{nP} \cdot \operatorname{primeStride}\right)\right)\right)$

define cliffApprox(nP : Math)
equation cliffApprox(nP) := $\left(\left(\operatorname{maskBits} + \sum_{i < \operatorname{nP}} \left(\operatorname{cliffOnePrime}\left(i\right)\right)\right) + \operatorname{cliffTail}\left(\left(\operatorname{nP} \cdot \operatorname{primeStride}\right)\right)\right)$

define ppSpec(k : Math, a : Math, S : Math)
equation ppSpec(k, a, S) := $\prod_{j < k} \left(\left(\left(1 - \operatorname{bit}\left(S, j\right)\right) + \left(\operatorname{bit}\left(S, j\right) \cdot \operatorname{bit}\left(a, j\right)\right)\right)\right)$

define toffPP(k : Math)
equation toffPP(k) := $\left(\left(\left(2\right)^{k} - k\right) - 1\right)$

define cliffPP(k : Math)
equation cliffPP(k) := $\left(k + 1\right)$

define dlogAfter(i : Math, y : Math)
equation dlogAfter(0, y) := $0$

equation dlogAfter(i+1, y) := $\operatorname{pyLoop1}\left(P, \operatorname{mx}, D, \operatorname{w1}, \operatorname{W1}, i, \operatorname{dlogAfter}\left(i, y\right), y\right)$

define resAt(i : Math, y : Math)
equation resAt(i, y) := $\operatorname{powMod}\left(\operatorname{gpAt}\left(i\right), \operatorname{dlogAfter}\left(\left(i + 1\right), y\right), \operatorname{pAt}\left(i\right)\right)$

define accContrib(i : Math, r : Math)
equation accContrib(i, r) := $\sum_{j < \operatorname{W4}} \left(\operatorname{lookup4Val}\left(\operatorname{w4}, i, j, \operatorname{mod}\left(\operatorname{shr}\left(r, \left(j \cdot \operatorname{w4}\right)\right), \left(2\right)^{\operatorname{w4}}\right)\right)\right)$

define approxResidue(nP : Math, y : Math)
equation approxResidue(nP, y) := $\sum_{i < \operatorname{nP}} \left(\operatorname{accContrib}\left(i, \operatorname{resAt}\left(i, y\right)\right)\right)$

define cWidthPrimes(nP : Math)
equation cWidthPrimes(nP) := $\left(\operatorname{nP} \cdot \left(\left(\left(\left(\left(\left(\operatorname{W1} \cdot \left(\left(\left(\left(2\right)^{\operatorname{w1}} - \operatorname{w1}\right) + \left(2 \cdot D\right)\right) - 2\right)\right) + \left(\left(D - \operatorname{cl}\right) \cdot \left(\left(D + \operatorname{cl}\right) - 2\right)\right)\right) + \left(\left(\left(\left(\left(\left(2\right)^{\left(2 \cdot \operatorname{w3}\right)} - \left(2 \cdot \operatorname{w3}\right)\right) - 1\right) + \left(\left(\operatorname{W3a} - 2\right) \cdot \left(\left(\left(\operatorname{W3b} \cdot \left(\left(\left(2\right)^{\left(2 \cdot \operatorname{w3}\right)} - \left(2 \cdot \operatorname{w3}\right)\right) + \left(3 \cdot \operatorname{ell}\right)\right)\right) + \operatorname{ell}\right) + 1\right)\right)\right) + \operatorname{ell}\right) + 1\right)\right) + \left(\operatorname{W4} \cdot \left(\left(\left(\left(\left(2 \cdot \left(\left(2\right)^{\operatorname{w4}} - \operatorname{w4}\right)\right) + \left(5 \cdot f\right)\right) + \left(2\right)^{\left\lfloor\frac{\operatorname{w4}}{2}\right\rfloor}\right) + \left(2\right)^{\left(\operatorname{w4} - \left\lfloor\frac{\operatorname{w4}}{2}\right\rfloor\right)}\right) - \operatorname{w4}\right)\right)\right) + \left(\left(\left(\left(\left(\operatorname{W3a} - 2\right) \cdot \left(\left(2 \cdot \operatorname{W3b}\right) \cdot \left(\left(\left(\left(2 \cdot \left(\left(\left(2\right)^{\left(2 \cdot \operatorname{w3}\right)} - \left(2 \cdot \operatorname{w3}\right)\right) - 1\right)\right) + \left(5 \cdot \operatorname{ell}\right)\right) + 5\right) + \left(2 \cdot \left(\left(\left(2\right)^{\operatorname{w3}} - \operatorname{w3}\right) - 1\right)\right)\right)\right)\right) + \left(2 \cdot \operatorname{ell}\right)\right) + 2\right) + \left(2 \cdot \left(\left(\left(2\right)^{\operatorname{w3}} - \operatorname{w3}\right) - 1\right)\right)\right)\right) + \left(\left(D - \operatorname{cl}\right) \cdot \left(\left(D + \operatorname{cl}\right) - 2\right)\right)\right)\right)$

define cWidthApprox(nP : Math)
equation cWidthApprox(nP) := $\left(\left(\left(\operatorname{cWidthPrimes}\left(\operatorname{nP}\right) + \left(\operatorname{W1} \cdot \left(\left(\left(\left(2\right)^{\operatorname{w1}} - \operatorname{w1}\right) + \left(2 \cdot D\right)\right) - 2\right)\right)\right) + D\right) + \left(\operatorname{W1} \cdot \left(\left(\left(\left(2\right)^{\left\lfloor\frac{\operatorname{w1}}{2}\right\rfloor} + \left(2\right)^{\left(\operatorname{w1} - \left\lfloor\frac{\operatorname{w1}}{2}\right\rfloor\right)}\right) - \operatorname{w1}\right) - 2\right)\right)\right)$

define vMLast(i : Math, x : Math)
equation vMLast(i, x) := $\operatorname{relV}\left(\left(\left(3 \cdot i\right) + 2\right), \operatorname{cxV}\left(\left(\left(3 \cdot \left(i - 1\right)\right) + 2\right), \left(\left(3 \cdot i\right) + 2\right), x\right)\right)$

define vRevSeg(m : Math, j : Math, x : Math)
equation vRevSeg(0, j, x) := $x$

equation vRevSeg(m+1, j, x) := $\operatorname{vMInt}\left(\left(j - m\right), \operatorname{vRevSeg}\left(m, j, x\right)\right)$

define getRegS(z : Math, base : Math, stride : Math, n : Math)
equation getRegS(z, base, stride, n) := $\sum_{i < n} \left(\left(\operatorname{bit}\left(z, \left(\operatorname{base} + \left(\operatorname{stride} \cdot i\right)\right)\right) \cdot \left(2\right)^{i}\right)\right)$

define xorRegS(z : Math, base : Math, stride : Math, n : Math, v : Math)
equation xorRegS(z, base, stride, n, v) := $\operatorname{xor}\left(z, \sum_{i < n} \left(\left(\operatorname{bit}\left(v, i\right) \cdot \left(2\right)^{\left(\operatorname{base} + \left(\operatorname{stride} \cdot i\right)\right)}\right)\right)\right)$

define swapRegS(z : Math, aBase : Math, aStride : Math, yBase : Math, yStride : Math, n : Math)
equation swapRegS(z, aBase, aStride, yBase, yStride, n) := $\operatorname{xorRegS}\left(\operatorname{xorRegS}\left(z, \operatorname{aBase}, \operatorname{aStride}, n, \operatorname{xor}\left(\operatorname{getRegS}\left(z, \operatorname{aBase}, \operatorname{aStride}, n\right), \operatorname{getRegS}\left(z, \operatorname{yBase}, \operatorname{yStride}, n\right)\right)\right), \operatorname{yBase}, \operatorname{yStride}, n, \operatorname{xor}\left(\operatorname{getRegS}\left(z, \operatorname{aBase}, \operatorname{aStride}, n\right), \operatorname{getRegS}\left(z, \operatorname{yBase}, \operatorname{yStride}, n\right)\right)\right)$

// FormalRV program: FormalRV/Audit/Gidney2025/Gidney2025.prog:187
algorithm gidney2025(q : Qubit[], c : Bit[]) {
  capacity q $\operatorname{top}$
  capacity c $\operatorname{recTop}$
  repeat b in 0..m {
    H(q[expBase+b])
  }
  call gApproxModexp(q, c, 0) @ id()
  call mzDescending(q, c, f+1, accBase+1, 3, P*(W1*(2^w1 - w1 + 2*D - 2) + (D-cl)*(D+cl-2) + (2^(2*w3) - 2*w3 - 1 + (W3a-2)*(W3b*(2^(2*w3) - 2*w3 + 3*ell) + ell + 1) + ell + 1) + W4*(2*(2^w4 - w4) + 5*f + 2^(w4 div 2) + 2^(w4 - w4 div 2) - w4) + ((W3a-2)*(2*W3b*(2*(2^(2*w3) - 2*w3 - 1) + 5*ell + 5 + 2*(2^w3 - w3 - 1))) + 2*ell + 2 + 2*(2^w3 - w3 - 1)) + (D-cl)*(D+cl-2)) + W1*(2^w1 - w1 + 2*D - 2) + D + W1*(2^(w1 div 2) + 2^(w1 - w1 div 2) - w1 - 2)) @ id()
  call gGradientPrep(q, c, gradBits, gradBase) @ id()
  call gQftMeasure(q, c, expBase, mx, gradBase, gradBits, P*(W1*(2^w1 - w1 + 2*D - 2) + (D-cl)*(D+cl-2) + (2^(2*w3) - 2*w3 - 1 + (W3a-2)*(W3b*(2^(2*w3) - 2*w3 + 3*ell) + ell + 1) + ell + 1) + W4*(2*(2^w4 - w4) + 5*f + 2^(w4 div 2) + 2^(w4 - w4 div 2) - w4) + ((W3a-2)*(2*W3b*(2*(2^(2*w3) - 2*w3 - 1) + 5*ell + 5 + 2*(2^w3 - w3 - 1))) + 2*ell + 2 + 2*(2^w3 - w3 - 1)) + (D-cl)*(D+cl-2)) + W1*(2^w1 - w1 + 2*D - 2) + D + W1*(2^(w1 div 2) + 2^(w1 - w1 div 2) - w1 - 2) + f + 1) @ id()
  call gQftMeasure(q, c, expBase+mx, my, gradBase, gradBits, P*(W1*(2^w1 - w1 + 2*D - 2) + (D-cl)*(D+cl-2) + (2^(2*w3) - 2*w3 - 1 + (W3a-2)*(W3b*(2^(2*w3) - 2*w3 + 3*ell) + ell + 1) + ell + 1) + W4*(2*(2^w4 - w4) + 5*f + 2^(w4 div 2) + 2^(w4 - w4 div 2) - w4) + ((W3a-2)*(2*W3b*(2*(2^(2*w3) - 2*w3 - 1) + 5*ell + 5 + 2*(2^w3 - w3 - 1))) + 2*ell + 2 + 2*(2^w3 - w3 - 1)) + (D-cl)*(D+cl-2)) + W1*(2^w1 - w1 + 2*D - 2) + D + W1*(2^(w1 div 2) + 2^(w1 - w1 div 2) - w1 - 2) + f + 1 + mx + (mx-1)*(gradBits-1)) @ id()
}

spec gidney2025 {
  requires $\left(2 \le \operatorname{cl}\right)$
  requires $\left(\operatorname{cl} \le D\right)$
  requires $\left(m < \left(2\right)^{\left(D - \operatorname{cl}\right)}\right)$
