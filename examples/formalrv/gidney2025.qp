}

// FormalRV gadget: FormalRV/Audit/Gidney2025/Gidney2025.prog:1727
algorithm gidneyMeasLastRev(q : Qubit[], c : Bit[], i : Nat, cb : Nat) {
  capacity q $\left(\left(3 \cdot i\right) + 3\right)$
  capacity c $\left(\operatorname{cb} + 1\right)$
  if $\left(i \ne 0\right)$ {
    CX(q[3*(i-1)+2], q[3*i+2])
  }
  H(q[3*i+2])
  measure q[(3*i+2)] -> c[cb]
  when $c_{\operatorname{cb}}$ {
    X(q[3*i+1])
    CZ(q[3*i], q[3*i+1])
    X(q[3*i+1])
    X(q[3*i+2])
  }
}

spec gidneyMeasLastRev {
  bind $\left(s < 2\right)$
