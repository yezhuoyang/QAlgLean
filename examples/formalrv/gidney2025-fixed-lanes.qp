  resource clifford := $\left(\left(\left(\left(\left(\left(\left(m + \left(\left(\operatorname{maskBits} + \left(\left(\left(\sum_{j < \operatorname{W1}} \left(\left(\left(\left(2 \cdot \operatorname{min}\left(\operatorname{w1}, \left(m - \left(j \cdot \operatorname{w1}\right)\right)\right)\right) + \left(\left(2 \cdot K\right) \cdot \operatorname{min}\left(\operatorname{w1}, \left(m - \left(j \cdot \operatorname{w1}\right)\right)\right)\right)\right) + \sum_{k < K} \left(\left(\left(\left(\operatorname{cliffLk}\left(\operatorname{w1}, D, \left(\left(\left(\left(\left(\left(P + K\right) + 1\right) \cdot \operatorname{primeStride}\right) + \operatorname{offL1}\right) + \left(k \cdot \operatorname{primeStride}\right)\right) + \left(j \cdot \left(2\right)^{\operatorname{w1}}\right)\right)\right) + \operatorname{cliffAdd}\left(D\right)\right) + \left(2 \cdot D\right)\right) + \operatorname{cxTable}\left(\operatorname{w1}, D, \left(\left(\left(\left(\left(\left(P + K\right) + 1\right) \cdot \operatorname{primeStride}\right) + \operatorname{offL1}\right) + \left(k \cdot \operatorname{primeStride}\right)\right) + \left(j \cdot \left(2\right)^{\operatorname{w1}}\right)\right)\right)\right)\right)\right)\right) + \sum_{t < \left(\left\lfloor\frac{P}{K}\right\rfloor - 1\right)} \left(\sum_{j < \operatorname{W1}} \left(\left(\left(\left(2 \cdot \operatorname{min}\left(\operatorname{w1}, \left(m - \left(j \cdot \operatorname{w1}\right)\right)\right)\right) + \left(\left(2 \cdot K\right) \cdot \operatorname{min}\left(\operatorname{w1}, \left(m - \left(j \cdot \operatorname{w1}\right)\right)\right)\right)\right) + \sum_{k < K} \left(\left(\left(\left(\operatorname{cliffLk}\left(\operatorname{w1}, D, \left(\left(\left(\left(\left(t + 1\right) \cdot \operatorname{primeStride}\right) + \operatorname{offL1}\right) + \left(\left(k \cdot \left\lfloor\frac{P}{K}\right\rfloor\right) \cdot \operatorname{primeStride}\right)\right) + \left(j \cdot \left(2\right)^{\operatorname{w1}}\right)\right)\right) + \operatorname{cliffAdd}\left(D\right)\right) + \left(2 \cdot D\right)\right) + \operatorname{cxTable}\left(\operatorname{w1}, D, \left(\left(\left(\left(\left(t + 1\right) \cdot \operatorname{primeStride}\right) + \operatorname{offL1}\right) + \left(\left(k \cdot \left\lfloor\frac{P}{K}\right\rfloor\right) \cdot \operatorname{primeStride}\right)\right) + \left(j \cdot \left(2\right)^{\operatorname{w1}}\right)\right)\right)\right)\right)\right)\right)\right)\right) + \sum_{j < \operatorname{W1}} \left(\left(\left(\left(2 \cdot \operatorname{min}\left(\operatorname{w1}, \left(m - \left(j \cdot \operatorname{w1}\right)\right)\right)\right) + \left(\left(2 \cdot K\right) \cdot \operatorname{min}\left(\operatorname{w1}, \left(m - \left(j \cdot \operatorname{w1}\right)\right)\right)\right)\right) + \sum_{k < K} \left(\left(\left(\left(\operatorname{cliffLk}\left(\operatorname{w1}, D, \left(\left(\left(\left(\left(P + 1\right) \cdot \operatorname{primeStride}\right) + \operatorname{offL1}\right) + \left(k \cdot \operatorname{primeStride}\right)\right) + \left(j \cdot \left(2\right)^{\operatorname{w1}}\right)\right)\right) + \operatorname{cliffAdd}\left(D\right)\right) + \left(2 \cdot D\right)\right) + \operatorname{cxTable}\left(\operatorname{w1}, D, \left(\left(\left(\left(\left(P + 1\right) \cdot \operatorname{primeStride}\right) + \operatorname{offL1}\right) + \left(k \cdot \operatorname{primeStride}\right)\right) + \left(j \cdot \left(2\right)^{\operatorname{w1}}\right)\right)\right)\right)\right)\right)\right)\right) + \sum_{t < \left\lfloor\frac{P}{K}\right\rfloor} \left(\sum_{k < K} \left(\left(\left(\left(\left(\operatorname{cliffL2}\left(D, \operatorname{cl}, \left(\operatorname{pAt}\left(\left(\left(k \cdot \left\lfloor\frac{P}{K}\right\rfloor\right) + t\right)\right) - 1\right)\right) + \operatorname{cliffL3}\left(\operatorname{w3}, \operatorname{W3a}, \operatorname{W3b}, \operatorname{ell}, \operatorname{pAt}\left(\left(\left(k \cdot \left\lfloor\frac{P}{K}\right\rfloor\right) + t\right)\right), \left(\left(\left(\left(k \cdot \left\lfloor\frac{P}{K}\right\rfloor\right) + t\right) \cdot \operatorname{primeStride}\right) + \operatorname{offL3c}\right)\right)\right) + \operatorname{cliffL4}\left(\operatorname{w4}, \operatorname{W4}, f, \operatorname{trunc}, \left(\left(\left(\left(k \cdot \left\lfloor\frac{P}{K}\right\rfloor\right) + t\right) \cdot \operatorname{primeStride}\right) + \operatorname{offL4}\right)\right)\right) + \operatorname{cliffU3}\left(\operatorname{w3}, \operatorname{W3a}, \operatorname{W3b}, \operatorname{ell}, \operatorname{pAt}\left(\left(\left(k \cdot \left\lfloor\frac{P}{K}\right\rfloor\right) + t\right)\right), \left(\left(\left(\left(k \cdot \left\lfloor\frac{P}{K}\right\rfloor\right) + t\right) \cdot \operatorname{primeStride}\right) + \operatorname{offL3b}\right), \left(\left(\left(\left(k \cdot \left\lfloor\frac{P}{K}\right\rfloor\right) + t\right) \cdot \operatorname{primeStride}\right) + \operatorname{offL3a}\right), \left(\left(\left(\left(k \cdot \left\lfloor\frac{P}{K}\right\rfloor\right) + t\right) \cdot \operatorname{primeStride}\right) + \operatorname{offL3c}\right)\right)\right) + \operatorname{cliffU2}\left(D, \operatorname{cl}, \left(\operatorname{pAt}\left(\left(\left(k \cdot \left\lfloor\frac{P}{K}\right\rfloor\right) + t\right)\right) - 1\right)\right)\right)\right)\right)\right)\right) + \operatorname{cliffTail}\left(\left(P \cdot \operatorname{primeStride}\right)\right)\right)\right) + f\right) + 1\right) + \operatorname{gradBits}\right) + \operatorname{min}\left(\operatorname{gradBits}, 2\right)\right) + \operatorname{cliffQft}\left(\operatorname{mx}, \operatorname{gradBits}\right)\right) + \operatorname{cliffQft}\left(\operatorname{my}, \operatorname{gradBits}\right)\right)$
}
