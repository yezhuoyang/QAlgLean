spec gWin {
  requires $\left(\left(\operatorname{W1} \cdot \left(\left(\left(\left(2\right)^{\operatorname{w1}} - \operatorname{w1}\right) + \left(2 \cdot D\right)\right) - 2\right)\right) \le \operatorname{cStride}\right)$
