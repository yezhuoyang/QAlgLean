\left(2 \cdot \left(\left(\left(2\right)^{\operatorname{w3}} - \operatorname{w3}\right) - 1\right)\right)\right)\right)\right) + \left(2 \cdot \operatorname{ell}\right)\right) + 2\right) + \left(2 \cdot \left(\left(\left(2\right)^{\operatorname{w3}} - \operatorname{w3}\right) - 1\right)\right)\right)\right) + \left(\left(D - \operatorname{cl}\right) \cdot \left(\left(D + \operatorname{cl}\right) - 2\right)\right)\right)\right)\right) + \left(P \cdot \left(\left(\left(\operatorname{W3a} - 2\right) \cdot \operatorname{W3b}\right) + 2\right)\right)\right)\right)$
  call gWin(q, c, (P + K + 1)*primeStride + offL1, primeStride, (P div K)*(W1*(2^w1 - w1 + 2*D - 2) + (D-cl)*(D+cl-2) + (2^(2*w3) - 2*w3 - 1 + (W3a-2)*(W3b*(2^(2*w3) - 2*w3 + 3*ell) + ell + 1) + ell + 1) + W4*(2*(2^w4 - w4) + 5*f + 2^(w4 div 2) + 2^(w4 - w4 div 2) - w4) + ((W3a-2)*(2*W3b*(2*(2^(2*w3) - 2*w3 - 1) + 5*ell + 5 + 2*(2^w3 - w3 - 1))) + 2*ell + 2 + 2*(2^w3 - w3 - 1)) + (D-cl)*(D+cl-2)), cb) @ id()
