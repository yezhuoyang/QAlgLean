    repeat jOut in 0..D {
      if $\left(\operatorname{mod}\left(\operatorname{shr}\left(\operatorname{Tanf}_{\left(\left(\operatorname{tOff} + \left(j \cdot \left(2\right)^{\operatorname{w1}}\right)\right) + S\right)}, \operatorname{jOut}\right), 2\right) = 1\right)$ {
        CX(q[ppBase+S], q[dlogBase + 3*jOut])
      }
    }
  }
  call gidneyAddNoCarry(q, c, D, cb) @ shift(dlogBase)
  call mxDescending(q, c, D, dlogBase, 3, cb + D - 1) @ id()
