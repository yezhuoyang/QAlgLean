// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:537
algorithm relocMajChain(q : Qubit[], c : Bit[], n : Nat, accBase : Nat, addBase : Nat) {
  capacity q $\left(\left(\operatorname{addBase} + n\right) + 1\right)$
  capacity c $0$
  repeat k in 0..n {
    if $\left(k = 0\right)$ {
      call cuccaroMAJ(q, c, addBase + n, accBase, addBase) @ id()
    } else {
      call cuccaroMAJ(q, c, addBase + k - 1, accBase + k, addBase + k) @ id()
    }
  }
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:544
algorithm relocUmaChainRev(q : Qubit[], c : Bit[], n : Nat, accBase : Nat, addBase : Nat) {
  capacity q $\left(\left(\operatorname{addBase} + n\right) + 1\right)$
  capacity c $0$
  repeat k in 0..n {
    if $\left(\left(\left(n - 1\right) - k\right) = 0\right)$ {
      call cuccaroUMA(q, c, addBase + n, accBase, addBase) @ id()
    } else {
      call cuccaroUMA(q, c, addBase + n - 2 - k, accBase + n - 1 - k, addBase + n - 1 - k) @ id()
    }
  }
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:551
algorithm cuccaroMAJ(q : Qubit[], c : Bit[], a : Nat, b : Nat, cin : Nat) {
  capacity q $\left(\operatorname{max}\left(a, \operatorname{max}\left(b, \operatorname{cin}\right)\right) + 1\right)$
  capacity c $0$
  CX(q[cin], q[b])
  CX(q[cin], q[a])
  CCX(q[a], q[b], q[cin])
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:556
algorithm cuccaroUMA(q : Qubit[], c : Bit[], a : Nat, b : Nat, cin : Nat) {
  capacity q $\left(\operatorname{max}\left(a, \operatorname{max}\left(b, \operatorname{cin}\right)\right) + 1\right)$
  capacity c $0$
  CCX(q[a], q[b], q[cin])
  CX(q[cin], q[a])
  CX(q[a], q[b])
}

spec mulInPlaceConst {
  bind $\alpha$
  requires $\left(0 < \operatorname{bits}\right)$
  requires $\left(\operatorname{mod}\left(\left(\operatorname{cst} \cdot \operatorname{cstInv}\right), \left(2\right)^{\operatorname{bits}}\right) = 1\right)$
  requires $\left(\operatorname{cstInv} < \left(2\right)^{\operatorname{bits}}\right)$
  requires $\left(\operatorname{cst} < \left(2\right)^{\operatorname{bits}}\right)$
  requires $\left(\left(\operatorname{regBase} + \operatorname{bits}\right) \le \operatorname{accBase}\right)$
  requires $\left(\left(\operatorname{accBase} + \operatorname{bits}\right) \le \operatorname{addBase}\right)$
  requires $\left(\left(\left(\operatorname{addBase} + \operatorname{bits}\right) + 1\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{setReg}\left(\operatorname{setReg}\left(z, \operatorname{accBase}, \operatorname{bits}, 0\right), \operatorname{addBase}, \left(\operatorname{bits} + 1\right), 0\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{setReg}\left(\operatorname{setReg}\left(\operatorname{setReg}\left(z, \operatorname{accBase}, \operatorname{bits}, 0\right), \operatorname{addBase}, \left(\operatorname{bits} + 1\right), 0\right), \operatorname{regBase}, \operatorname{bits}, \left(\operatorname{cst} \cdot \operatorname{getReg}\left(z, \operatorname{regBase}, \operatorname{bits}\right)\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  outcomes none
  resource toffoli := $\operatorname{toffMulInPlace}\left(\operatorname{bits}\right)$
  resource t := $\left(7 \cdot \operatorname{toffMulInPlace}\left(\operatorname{bits}\right)\right)$
  resource clifford := $\operatorname{cliffMulInPlace}\left(\operatorname{bits}, \operatorname{cst}, \operatorname{cstInv}\right)$
  resource rot := $0$
  resource meas := $0$
  resource qubits := $\left(\left(3 \cdot \operatorname{bits}\right) + 1\right)$
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:578
algorithm hadamards(q : Qubit[], c : Bit[], base : Nat, n : Nat) {
  capacity q $\left(\operatorname{base} + n\right)$
  capacity c $0$
  repeat i in 0..n {
    H(q[base + i])
  }
}

spec hadamards {
  bind $\alpha$
  requires $\left(0 < n\right)$
  requires $\left(\left(\operatorname{base} + n\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{setReg}\left(z, \operatorname{base}, n, 0\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\sum_{e < \left(2\right)^{n}} \left(\left(\left(\alpha\left(z\right) \cdot \frac{1}{\sqrt{\left(2\right)^{n}}}\right) \cdot \ket{\operatorname{setReg}\left(z, \operatorname{base}, n, e\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)\right)$
  outcomes none
  resource toffoli := $0$
  resource t := $0$
  resource clifford := $n$
  resource rot := $0$
  resource meas := $0$
  resource depth := $1$
  resource width := $n$
  resource ops := $n$
  resource qubits := $n$
}

