// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:523
algorithm cxCascade(q : Qubit[], c : Bit[], n : Nat, cStride : Nat, cBase : Nat, tStride : Nat, tBase : Nat) {
  capacity q $\operatorname{max}\left(\left(\operatorname{cBase} + \left(\operatorname{cStride} \cdot n\right)\right), \left(\operatorname{tBase} + \left(\operatorname{tStride} \cdot n\right)\right)\right)$
