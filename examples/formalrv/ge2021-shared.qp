// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:447
algorithm geSubRunway(q : Qubit[], c : Bit[], n : Nat, cm : Nat, rBase : Nat, uBase : Nat, addBase : Nat) {
  capacity q $\left(\left(\operatorname{addBase} + n\right) + 1\right)$
