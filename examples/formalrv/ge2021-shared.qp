  requires $\left(\left(\operatorname{runBase} + \left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{pieceLen}\right)\right) \le \operatorname{outBase}\right)$
  requires $\left(\left(\operatorname{outBase} + \operatorname{outWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) \le \operatorname{addrBase}\right)$
