algorithm gLaRunwayAt(q : Qubit[], c : Bit[], w : Nat, W : Nat, bits : Nat, gSep : Nat, pieceLen : Nat, addrBase : Nat, ancBase : Nat, ppLow : Nat, ppHigh : Nat, runBase : Nat, outBase : Nat, ctrl : Nat, tOff : Nat, cb : Nat) {
  capacity q $\operatorname{dim}$
  capacity c $\operatorname{dim}$
  call unaryQROMSegCoh(q, c, w, W, addrBase, ancBase, outBase, 1, gSep, pieceLen + 1, ctrl, 0, tOff, cb) @ id()
  call gRunwayAdd(q, c, bits, gSep, pieceLen, runBase, outBase) @ id()
  call ge2021Unlookup(q, c, W, outBase, 1, gSep, pieceLen + 1, w, addrBase, ppLow, ppHigh, tOff, cb + 2^w - 1) @ id()
}

