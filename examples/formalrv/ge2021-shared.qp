algorithm geCopyFoldedWindow(q : Qubit[], c : Bit[], bits : Nat, gSep : Nat, pieceLen : Nat, R : Nat, wMul : Nat, k : Nat, addrBase : Nat) {
  capacity q $\operatorname{max}\left(\left(R + \left(\left\lfloor\frac{\left(\left(\operatorname{bits} + \operatorname{gSep}\right) - 1\right)}{\operatorname{gSep}}\right\rfloor \cdot \left(\operatorname{pieceLen} + 1\right)\right)\right), \left(\operatorname{addrBase} + \operatorname{wMul}\right)\right)$
