  requires $\left(\left(\operatorname{ancBase} + w\right) \le \operatorname{ppLow}\right)$
  requires $\left(\left(\operatorname{ppLow} + \left(2\right)^{\operatorname{halfLo}\left(w\right)}\right) \le \operatorname{ppHigh}\right)$
  requires $\left(\left(\operatorname{ppHigh} + \left(2\right)^{\operatorname{halfHi}\left(w\right)}\right) \le \operatorname{ctrl}\right)$
