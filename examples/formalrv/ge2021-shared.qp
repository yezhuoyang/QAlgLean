// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:814
algorithm gLaRwAtLoaded(q : Qubit[], c : Bit[], wExp : Nat, wMul : Nat, W : Nat, bits : Nat, gSep : Nat, pieceLen : Nat, srcBase : Nat, tgtBase : Nat, outBase : Nat, addrZone : Nat, eBase : Nat, eWin : Nat, m : Nat, k : Nat, ctrl : Nat, tOff : Nat, cb : Nat) {
  capacity q $\operatorname{dim}$
  capacity c $\operatorname{dim}$
  call copyWindowTo(q, c, wExp, eBase, eWin, addrZone) @ id()
  call geCopyFoldedWindow(q, c, bits, gSep, pieceLen, srcBase, wMul, k, addrZone + wExp) @ id()
  call gLaRunwayAt(q, c, wExp + wMul, W, bits, gSep, pieceLen, addrZone, addrZone + (wExp + wMul), addrZone + 2*(wExp + wMul), addrZone + 2*(wExp + wMul) + 2^((wExp + wMul) div 2), tgtBase, outBase, ctrl, tOff, cb) @ id()
  call geCopyFoldedWindow(q, c, bits, gSep, pieceLen, srcBase, wMul, k, addrZone + wExp) @ id()
  call copyWindowTo(q, c, wExp, eBase, eWin, addrZone) @ id()
}

