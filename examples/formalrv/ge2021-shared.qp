  requires $\forall u < W, \left(\forall S < \left(2\right)^{\operatorname{halfHi}\left(w\right)}, \left(\left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, u\right) \ne \left(\operatorname{ppHigh} + S\right)\right)\right)\right)$
  requires $\forall u < W, \left(\forall j < w, \left(\left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, u\right) \ne \left(\operatorname{addrBase} + j\right)\right)\right)\right)$
  requires $\forall u < W, \left(\left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, u\right) < \operatorname{dim}\right)\right)$
  requires $\left(\left(\operatorname{addrBase} + w\right) \le \operatorname{ppLow}\right)$
  requires $\left(\left(\operatorname{ppLow} + \left(2\right)^{\operatorname{halfLo}\left(w\right)}\right) \le \operatorname{ppHigh}\right)$
  requires $\left(\left(\operatorname{ppHigh} + \left(2\right)^{\operatorname{halfHi}\left(w\right)}\right) \le \operatorname{dim}\right)$
  requires $\left(\left(\operatorname{ppHigh} + \left(2\right)^{\operatorname{halfHi}\left(w\right)}\right) \le \operatorname{cb}\right)$
  requires $\forall u < W, \left(\left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, u\right) < \operatorname{cb}\right)\right)$
  requires $\left(\left(\left(\left(\operatorname{cb} + W\right) + \left(\left(\left(2\right)^{\operatorname{halfLo}\left(w\right)} - \operatorname{halfLo}\left(w\right)\right) - 1\right)\right) + \left(\left(\left(2\right)^{\operatorname{halfHi}\left(w\right)} - \operatorname{halfHi}\left(w\right)\right) - 1\right)\right) \le \operatorname{dim}\right)$
  requires $\forall i < W, \left(\forall \operatorname{lo} < \left(2\right)^{\operatorname{halfLo}\left(w\right)}, \left(\left(\operatorname{Tbar}_{\left(\left(\left(\operatorname{tOff} \cdot \left(W \cdot \left(2\right)^{\operatorname{halfLo}\left(w\right)}\right)\right) + \left(i \cdot \left(2\right)^{\operatorname{halfLo}\left(w\right)}\right)\right) + \operatorname{lo}\right)} = \operatorname{gePhaseWord}\left(w, \operatorname{tOff}, i, \operatorname{lo}\right)\right)\right)\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{posSet}\left(W, \operatorname{setReg}\left(\operatorname{setReg}\left(\operatorname{setReg}\left(z, \operatorname{ppLow}, \left(2\right)^{\operatorname{halfLo}\left(w\right)}, 0\right), \operatorname{ppHigh}, \left(2\right)^{\operatorname{halfHi}\left(w\right)}, 0\right), \operatorname{cb}, \left(\left(W + \left(\left(\left(2\right)^{\operatorname{halfLo}\left(w\right)} - \operatorname{halfLo}\left(w\right)\right) - 1\right)\right) + \left(\left(\left(2\right)^{\operatorname{halfHi}\left(w\right)} - \operatorname{halfHi}\left(w\right)\right) - 1\right)\right), 0\right), \operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, T_{\left(\operatorname{tOff} + \operatorname{getReg}\left(z, \operatorname{addrBase}, w\right)\right)}\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \left(\ket{\operatorname{posSet}\left(W, \operatorname{setReg}\left(\operatorname{setReg}\left(z, \operatorname{ppLow}, \left(2\right)^{\operatorname{halfLo}\left(w\right)}, 0\right), \operatorname{ppHigh}, \left(2\right)^{\operatorname{halfHi}\left(w\right)}, 0\right), \operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, 0\right)}_{q_{\operatorname{band}\left(0, \operatorname{cb}, 1\right)}} \otimes \ket{\operatorname{shr}\left(\operatorname{posSet}\left(W, \operatorname{setReg}\left(\operatorname{setReg}\left(z, \operatorname{ppLow}, \left(2\right)^{\operatorname{halfLo}\left(w\right)}, 0\right), \operatorname{ppHigh}, \left(2\right)^{\operatorname{halfHi}\left(w\right)}, 0\right), \operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, 0\right), \left(\left(\left(\operatorname{cb} + W\right) + \left(\left(\left(2\right)^{\operatorname{halfLo}\left(w\right)} - \operatorname{halfLo}\left(w\right)\right) - 1\right)\right) + \left(\left(\left(2\right)^{\operatorname{halfHi}\left(w\right)} - \operatorname{halfHi}\left(w\right)\right) - 1\right)\right)\right)}_{q_{\operatorname{band}\left(\left(\left(\left(\operatorname{cb} + W\right) + \left(\left(\left(2\right)^{\operatorname{halfLo}\left(w\right)} - \operatorname{halfLo}\left(w\right)\right) - 1\right)\right) + \left(\left(\left(2\right)^{\operatorname{halfHi}\left(w\right)} - \operatorname{halfHi}\left(w\right)\right) - 1\right)\right), \operatorname{dim}, 1\right)}}\right)\right)\right)$
  outcomes $\left(\Pr\left(\left(c_{i} = 1\right)\right) = \frac{1}{2}\right)$
  resource toffoli := $\operatorname{toffPhaseup}\left(w\right)$
  resource t := $\left(7 \cdot \operatorname{toffPhaseup}\left(w\right)\right)$
  resource clifford := $\operatorname{cliffUnlookup}\left(W, w, \operatorname{tOff}\right)$
  resource rot := $0$
  resource meas := $\operatorname{measUnlookup}\left(W, w\right)$
}

