// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:1288
algorithm gIdealIQFT(q : Qubit[], c : Bit[], expWire : Nat, nE : Nat, nA : Nat) {
  capacity q $\left(\operatorname{expWire} + \operatorname{nE}\right)$
  capacity c $0$
  repeat p in 0..nE {
    call gIdealIQFTRead(q, c, 1, expWire, p, nA) @ id()
  }
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:1292
algorithm gIdealIQFTRead(q : Qubit[], c : Bit[], wExp : Nat, expWire : Nat, m : Nat, nA : Nat) {
  capacity q $\left(\operatorname{expWire} + \left(\left(m + 1\right) \cdot \operatorname{wExp}\right)\right)$
  capacity c $0$
  repeat i in 0..wExp {
    repeat u in (m*wExp div nA)*nA..m*wExp + i {
      controlled(q[expWire + u]) {
        RzDyadic(q[expWire + m*wExp + i], m*wExp + i - u)
      }
    }
    H(q[expWire + m*wExp + i])
  }
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:1299
algorithm gExpAllMeasure(q : Qubit[], c : Bit[], wExp : Nat, expWire : Nat, numMults : Nat, cb : Nat) {
  capacity q $\left(\operatorname{expWire} + \left(\operatorname{numMults} \cdot \operatorname{wExp}\right)\right)$
  capacity c $\left(\operatorname{cb} + \left(\operatorname{numMults} \cdot \operatorname{wExp}\right)\right)$
  repeat g in 0..numMults*wExp {
    measure q[expWire + g] -> c[cb + g]
    when $c_{\left(\operatorname{cb} + g\right)}$ {
      X(q[expWire + g])
    }
  }
}

spec gExpAllMeasure {
  bind $\left(z < \left(2\right)^{\operatorname{dim}}\right)$
  requires $\left(0 < \left(\operatorname{numMults} \cdot \operatorname{wExp}\right)\right)$
  requires $\left(\left(\operatorname{expWire} + \left(\operatorname{numMults} \cdot \operatorname{wExp}\right)\right) \le \operatorname{dim}\right)$
  requires $\left(\left(\operatorname{cb} + \left(\operatorname{numMults} \cdot \operatorname{wExp}\right)\right) \le \operatorname{dim}\right)$
  requires $\forall i < \left(\operatorname{numMults} \cdot \operatorname{wExp}\right), \left(\forall j < \left(\operatorname{numMults} \cdot \operatorname{wExp}\right), \left(\left(\left(\operatorname{expWire} + i\right) \ne \left(\operatorname{cb} + j\right)\right)\right)\right)$
  requires $\left(\left(\operatorname{expWire} + \left(\operatorname{numMults} \cdot \operatorname{wExp}\right)\right) \le \operatorname{cb}\right)$
  assumes $\ket{\operatorname{setReg}\left(z, \operatorname{cb}, \left(\operatorname{numMults} \cdot \operatorname{wExp}\right), 0\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}$
  ensures $\ket{\operatorname{setReg}\left(\operatorname{setReg}\left(z, \operatorname{expWire}, \left(\operatorname{numMults} \cdot \operatorname{wExp}\right), 0\right), \operatorname{cb}, \left(\operatorname{numMults} \cdot \operatorname{wExp}\right), \operatorname{getReg}\left(z, \operatorname{expWire}, \left(\operatorname{numMults} \cdot \operatorname{wExp}\right)\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}$
  outcomes $\left(\Pr\left(\left(c_{\operatorname{band}\left(\left(\operatorname{cb} - \left(\operatorname{expWire} + \left(\operatorname{numMults} \cdot \operatorname{wExp}\right)\right)\right), \left(\left(\operatorname{cb} + \left(\operatorname{numMults} \cdot \operatorname{wExp}\right)\right) - \left(\operatorname{expWire} + \left(\operatorname{numMults} \cdot \operatorname{wExp}\right)\right)\right), 1\right)} = \operatorname{getReg}\left(z, \operatorname{expWire}, \left(\operatorname{numMults} \cdot \operatorname{wExp}\right)\right)\right)\right) = 1\right)$
  resource toffoli := $0$
  resource t := $0$
  resource clifford := $\left(\operatorname{numMults} \cdot \operatorname{wExp}\right)$
  resource rot := $0$
  resource meas := $\left(\operatorname{numMults} \cdot \operatorname{wExp}\right)$
  resource ops := $\left(\left(2 \cdot \operatorname{numMults}\right) \cdot \operatorname{wExp}\right)$
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:1325
algorithm readout(q : Qubit[], c : Bit[], bits : Nat, gSep : Nat, pieceLen : Nat, pBase : Nat, wBase : Nat, numMults : Nat, cb : Nat) {
  capacity q $\left(\operatorname{wBase} + \left(\left\lfloor\frac{\left(\left(\operatorname{bits} + \operatorname{gSep}\right) - 1\right)}{\operatorname{gSep}}\right\rfloor \cdot \left(\operatorname{pieceLen} + 1\right)\right)\right)$
  capacity c $\left(\operatorname{cb} + \left(\left\lfloor\frac{\left(\left(\operatorname{bits} + \operatorname{gSep}\right) - 1\right)}{\operatorname{gSep}}\right\rfloor \cdot \left(\operatorname{pieceLen} + 1\right)\right)\right)$
  repeat i in 0..((((bits + gSep - 1) div gSep))*(pieceLen + 1)) {
    measure q[pBase + (numMults%2)*(wBase - pBase) + i] -> c[cb + i]
  }
}

spec readout {
  bind $\left(z < \left(2\right)^{\operatorname{dim}}\right)$
  requires $\left(1 \le \left(\operatorname{bits} + \operatorname{gSep}\right)\right)$
  requires $\left(0 < \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right)$
  requires $\left(\left(\operatorname{pBase} + \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) \le \operatorname{wBase}\right)$
  requires $\left(\left(\operatorname{wBase} + \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) \le \operatorname{dim}\right)$
  requires $\left(\left(\operatorname{cb} + \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) \le \operatorname{dim}\right)$
  requires $\forall i < \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right), \left(\forall j < \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right), \left(\left(\left(\left(\operatorname{pBase} + \left(\operatorname{mod}\left(\operatorname{numMults}, 2\right) \cdot \left(\operatorname{wBase} - \operatorname{pBase}\right)\right)\right) + i\right) \ne \left(\operatorname{cb} + j\right)\right)\right)\right)$
  requires $\left(\left(\operatorname{wBase} + \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) \le \operatorname{cb}\right)$
  assumes $\ket{\operatorname{setReg}\left(z, \operatorname{cb}, \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right), 0\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}$
  ensures $\left(\ket{\operatorname{setReg}\left(z, \operatorname{cb}, \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right), \operatorname{getReg}\left(z, \left(\operatorname{pBase} + \left(\operatorname{mod}\left(\operatorname{numMults}, 2\right) \cdot \left(\operatorname{wBase} - \operatorname{pBase}\right)\right)\right), \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}} \land \left(c_{\operatorname{band}\left(\left(\operatorname{cb} - \left(\operatorname{wBase} + \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right)\right), \left(\left(\operatorname{cb} + \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) - \left(\operatorname{wBase} + \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right)\right), 1\right)} = \operatorname{getReg}\left(z, \left(\operatorname{pBase} + \left(\operatorname{mod}\left(\operatorname{numMults}, 2\right) \cdot \left(\operatorname{wBase} - \operatorname{pBase}\right)\right)\right), \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right)\right)\right)$
  outcomes $\left(\Pr\left(\left(c_{\operatorname{band}\left(\left(\operatorname{cb} - \left(\operatorname{wBase} + \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right)\right), \left(\left(\operatorname{cb} + \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) - \left(\operatorname{wBase} + \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right)\right), 1\right)} = \operatorname{getReg}\left(z, \left(\operatorname{pBase} + \left(\operatorname{mod}\left(\operatorname{numMults}, 2\right) \cdot \left(\operatorname{wBase} - \operatorname{pBase}\right)\right)\right), \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right)\right)\right) = 1\right)$
  resource toffoli := $0$
  resource t := $0$
  resource clifford := $0$
  resource rot := $0$
  resource meas := $\operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)$
  resource depth := $1$
  resource width := $\operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)$
  resource ops := $\operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)$
  resource qubits := $\operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)$
}

