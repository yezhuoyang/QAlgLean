define outWidth(bits : Math, gSep : Math, pieceLen : Math)
equation outWidth(bits, gSep, pieceLen) := $\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \left(\operatorname{pieceLen} + 1\right)\right)$

define halfLo(w : Math)
equation halfLo(w) := $\left\lfloor\frac{w}{2}\right\rfloor$

define halfHi(w : Math)
equation halfHi(w) := $\left(w - \left\lfloor\frac{w}{2}\right\rfloor\right)$

define zoneStride(wExp : Math, wMul : Math)
equation zoneStride(wExp, wMul) := $\left(\left(\left(2 \cdot \left(\operatorname{wExp} + \operatorname{wMul}\right)\right) + \left(2\right)^{\operatorname{halfLo}\left(\left(\operatorname{wExp} + \operatorname{wMul}\right)\right)}\right) + \left(2\right)^{\operatorname{halfHi}\left(\left(\operatorname{wExp} + \operatorname{wMul}\right)\right)}\right)$

define posWire(posBase : Math, posStride : Math, segLen : Math, segStride : Math, i : Math)
equation posWire(posBase, posStride, segLen, segStride, i) := $\left(\left(\operatorname{posBase} + \left(\operatorname{segStride} \cdot \left\lfloor\frac{i}{\operatorname{segLen}}\right\rfloor\right)\right) + \left(\operatorname{posStride} \cdot \operatorname{mod}\left(i, \operatorname{segLen}\right)\right)\right)$

define posGet(n : Math, z : Math, posBase : Math, posStride : Math, segLen : Math, segStride : Math)
equation posGet(n, z, posBase, posStride, segLen, segStride) := $\sum_{i < n} \left(\left(\operatorname{bit}\left(z, \operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, i\right)\right) \cdot \left(2\right)^{i}\right)\right)$

define posXor(n : Math, z : Math, posBase : Math, posStride : Math, segLen : Math, segStride : Math, v : Math)
equation posXor(0, z, posBase, posStride, segLen, segStride, v) := $z$

equation posXor(n+1, z, posBase, posStride, segLen, segStride, v) := $\operatorname{xorBitAt}\left(\operatorname{posXor}\left(n, z, \operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, v\right), \operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, n\right), \operatorname{bit}\left(v, n\right)\right)$

define posSet(n : Math, z : Math, posBase : Math, posStride : Math, segLen : Math, segStride : Math, v : Math)
equation posSet(n, z, posBase, posStride, segLen, segStride, v) := $\operatorname{posXor}\left(n, z, \operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, \operatorname{xor}\left(\operatorname{posGet}\left(n, z, \operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}\right), v\right)\right)$

define copySrc(w : Math, yBase : Math, j : Math, i : Math)
equation copySrc(w, yBase, j, i) := $\left(\left(\operatorname{yBase} + \left(j \cdot w\right)\right) + i\right)$

define copyTgt(addrBase : Math, i : Math)
equation copyTgt(addrBase, i) := $\left(\operatorname{addrBase} + i\right)$

define xorLow(k : Math, x : Math, y : Math)
equation xorLow(0, x, y) := $0$

equation xorLow(k+1, x, y) := $\left(\operatorname{xorLow}\left(k, x, y\right) + \left(\left(2\right)^{k} \cdot \operatorname{xor}\left(\operatorname{bit}\left(x, k\right), \operatorname{bit}\left(y, k\right)\right)\right)\right)$

define xorBitAt(x : Math, p : Math, v : Math)
equation xorBitAt(x, p, v) := $\left(\left(\operatorname{mod}\left(x, \left(2\right)^{p}\right) + \left(\left(2\right)^{p} \cdot \operatorname{xor}\left(\operatorname{bit}\left(x, p\right), v\right)\right)\right) + \left(\left(2\right)^{\left(p + 1\right)} \cdot \operatorname{shr}\left(x, \left(p + 1\right)\right)\right)\right)$

define getReg(z : Math, base : Math, n : Math)
equation getReg(z, base, n) := $\operatorname{mod}\left(\operatorname{shr}\left(z, \operatorname{base}\right), \left(2\right)^{n}\right)$

define setReg(z : Math, base : Math, n : Math, v : Math)
equation setReg(z, base, n, v) := $\left(\left(\operatorname{mod}\left(z, \left(2\right)^{\operatorname{base}}\right) + \left(\left(2\right)^{\operatorname{base}} \cdot \operatorname{mod}\left(v, \left(2\right)^{n}\right)\right)\right) + \left(\left(2\right)^{\left(\operatorname{base} + n\right)} \cdot \operatorname{shr}\left(z, \left(\operatorname{base} + n\right)\right)\right)\right)$

define majWord(z : Math, a : Math, b : Math, cin : Math)
equation majWord(z, a, b, cin) := $\operatorname{xorBitAt}\left(\operatorname{xorBitAt}\left(\operatorname{xorBitAt}\left(z, b, \operatorname{bit}\left(z, \operatorname{cin}\right)\right), a, \operatorname{bit}\left(z, \operatorname{cin}\right)\right), \operatorname{cin}, \left(\operatorname{xor}\left(\operatorname{bit}\left(z, a\right), \operatorname{bit}\left(z, \operatorname{cin}\right)\right) \cdot \operatorname{xor}\left(\operatorname{bit}\left(z, b\right), \operatorname{bit}\left(z, \operatorname{cin}\right)\right)\right)\right)$

define umaWord(z : Math, a : Math, b : Math, cin : Math)
equation umaWord(z, a, b, cin) := $\operatorname{xorBitAt}\left(\operatorname{xorBitAt}\left(\operatorname{xorBitAt}\left(z, a, \operatorname{xor}\left(\operatorname{bit}\left(z, \operatorname{cin}\right), \left(\operatorname{bit}\left(z, a\right) \cdot \operatorname{bit}\left(z, b\right)\right)\right)\right), b, \operatorname{xor}\left(\operatorname{bit}\left(z, a\right), \operatorname{xor}\left(\operatorname{bit}\left(z, \operatorname{cin}\right), \left(\operatorname{bit}\left(z, a\right) \cdot \operatorname{bit}\left(z, b\right)\right)\right)\right)\right), \operatorname{cin}, \left(\operatorname{bit}\left(z, a\right) \cdot \operatorname{bit}\left(z, b\right)\right)\right)$

define copyWindow(n : Math, f : Math, w : Math, yBase : Math, j : Math, addrBase : Math)
equation copyWindow(0, f, w, yBase, j, addrBase) := $f$

equation copyWindow(n+1, f, w, yBase, j, addrBase) := $\operatorname{xorBitAt}\left(\operatorname{copyWindow}\left(n, f, w, \operatorname{yBase}, j, \operatorname{addrBase}\right), \operatorname{copyTgt}\left(\operatorname{addrBase}, n\right), \operatorname{bit}\left(f, \operatorname{copySrc}\left(w, \operatorname{yBase}, j, n\right)\right)\right)$

define ppSpec(k : Math, a : Math, S : Math)
equation ppSpec(k, a, S) := $\prod_{j < k} \left(\left(\left(1 - \operatorname{bit}\left(S, j\right)\right) + \left(\operatorname{bit}\left(S, j\right) \cdot \operatorname{bit}\left(a, j\right)\right)\right)\right)$

define ppWord(k : Math, a : Math)
equation ppWord(k, a) := $\sum_{S < \left(2\right)^{k}} \left(\left(\operatorname{ppSpec}\left(k, a, S\right) \cdot \left(2\right)^{S}\right)\right)$

define rev(x : Math, n : Math)
equation rev(x, n) := $\sum_{i < n} \left(\left(\operatorname{bit}\left(x, i\right) \cdot \left(2\right)^{\left(\left(n - 1\right) - i\right)}\right)\right)$

define geE1Word(wExp : Math, nA : Math, m : Math, e : Math)
equation geE1Word(wExp, nA, m, e) := $\sum_{i < \operatorname{wExp}} \left(\begin{cases} \left(\operatorname{bit}\left(e, i\right) \cdot \left(2\right)^{\left(\left(\operatorname{nA} - 1\right) - \left(\left(m \cdot \operatorname{wExp}\right) + i\right)\right)}\right) & \left(\left(\left(m \cdot \operatorname{wExp}\right) + i\right) < \operatorname{nA}\right) \\ 0 & \text{otherwise} \end{cases}\right)$

define geE2Word(wExp : Math, nA : Math, nE : Math, m : Math, e : Math)
equation geE2Word(wExp, nA, nE, m, e) := $\sum_{i < \operatorname{wExp}} \left(\begin{cases} 0 & \left(\left(\left(m \cdot \operatorname{wExp}\right) + i\right) < \operatorname{nA}\right) \\ \begin{cases} \left(\operatorname{bit}\left(e, i\right) \cdot \left(2\right)^{\left(\left(\operatorname{nE} - 1\right) - \left(\left(m \cdot \operatorname{wExp}\right) + i\right)\right)}\right) & \left(\left(\left(m \cdot \operatorname{wExp}\right) + i\right) < \operatorname{nE}\right) \\ 0 & \text{otherwise} \end{cases} & \text{otherwise} \end{cases}\right)$

define ehOffsetExp(N : Math, m : Math)
equation ehOffsetExp(N, m) := $\left(\left\lfloor\frac{\left(N - 1\right)}{2}\right\rfloor - \left(2\right)^{m}\right)$

define geFactor(N : Math, g : Math, gInv : Math, wExp : Math, nA : Math, nE : Math, m : Math, e : Math)
equation geFactor(N, g, gInv, wExp, nA, nE, m, e) := $\operatorname{mod}\left(\left(\left(g\right)^{\operatorname{geE1Word}\left(\operatorname{wExp}, \operatorname{nA}, m, e\right)} \cdot \left(\operatorname{gInv}\right)^{\left(\operatorname{ehOffsetExp}\left(N, \left(\left(2 \cdot \operatorname{nA}\right) - \operatorname{nE}\right)\right) \cdot \operatorname{geE2Word}\left(\operatorname{wExp}, \operatorname{nA}, \operatorname{nE}, m, e\right)\right)}\right), N\right)$

define vwWidth(bits : Math, gSep : Math, pieceLen : Math)
equation vwWidth(bits, gSep, pieceLen) := $\left(\left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right) \cdot \left(\operatorname{gSep} + 1\right)\right) + \operatorname{pieceLen}\right)$

define vwWeight(bits : Math, gSep : Math, pieceLen : Math, v : Math)
equation vwWeight(bits, gSep, pieceLen, v) := $\begin{cases} v & \left(v < \left(\left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right) \cdot \operatorname{gSep}\right) + \operatorname{pieceLen}\right)\right) \\ \left(\left(\left(\left(v - \left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right) \cdot \operatorname{gSep}\right)\right) - \operatorname{pieceLen}\right) \cdot \operatorname{gSep}\right) + \operatorname{pieceLen}\right) & \text{otherwise} \end{cases}$

define vwPos(bits : Math, gSep : Math, pieceLen : Math, R : Math, v : Math)
equation vwPos(bits, gSep, pieceLen, R, v) := $\begin{cases} \left(\left(R + \left(\left\lfloor\frac{v}{\operatorname{gSep}}\right\rfloor \cdot \operatorname{pieceLen}\right)\right) + \operatorname{mod}\left(v, \operatorname{gSep}\right)\right) & \left(v < \left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right) \cdot \operatorname{gSep}\right)\right) \\ \begin{cases} \left(\left(\left(R + \left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right) \cdot \operatorname{pieceLen}\right)\right) + v\right) - \left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right) \cdot \operatorname{gSep}\right)\right) & \left(v < \left(\left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right) \cdot \operatorname{gSep}\right) + \operatorname{pieceLen}\right)\right) \\ \left(\left(R + \left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{pieceLen}\right)\right) + \left(\left(v - \left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right) \cdot \operatorname{gSep}\right)\right) - \operatorname{pieceLen}\right)\right) & \text{otherwise} \end{cases} & \text{otherwise} \end{cases}$

define vwWindow(bits : Math, gSep : Math, pieceLen : Math, R : Math, wMul : Math, k : Math, z : Math)
equation vwWindow(bits, gSep, pieceLen, R, wMul, k, z) := $\sum_{i < \operatorname{wMul}} \left(\left(\begin{cases} \operatorname{bit}\left(z, \operatorname{vwPos}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, R, \left(\left(k \cdot \operatorname{wMul}\right) + i\right)\right)\right) & \left(\left(\left(k \cdot \operatorname{wMul}\right) + i\right) < \operatorname{vwWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) \\ 0 & \text{otherwise} \end{cases} \cdot \left(2\right)^{i}\right)\right)$

define geSourceWindow(bits : Math, gSep : Math, pieceLen : Math, wMul : Math, k : Math, y : Math)
equation geSourceWindow(bits, gSep, pieceLen, wMul, k, y) := $\sum_{i < \operatorname{wMul}} \left(\begin{cases} \left(\operatorname{bit}\left(y, i\right) \cdot \left(2\right)^{\operatorname{vwWeight}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \left(\left(k \cdot \operatorname{wMul}\right) + i\right)\right)}\right) & \left(\left(\left(k \cdot \operatorname{wMul}\right) + i\right) < \operatorname{vwWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) \\ 0 & \text{otherwise} \end{cases}\right)$

define geTableValue(bits : Math, N : Math, g : Math, gInv : Math, wExp : Math, wMul : Math, gSep : Math, pieceLen : Math, nA : Math, nE : Math, m : Math, pass : Math, k : Math, a : Math)
equation geTableValue(bits, N, g, gInv, wExp, wMul, gSep, pieceLen, nA, nE, m, pass, k, a) := $\operatorname{mod}\left(\left(\begin{cases} \operatorname{geFactor}\left(N, g, \operatorname{gInv}, \operatorname{wExp}, \operatorname{nA}, \operatorname{nE}, m, \operatorname{mod}\left(a, \left(2\right)^{\operatorname{wExp}}\right)\right) & \left(\operatorname{pass} = 0\right) \\ \left(N - \operatorname{geFactor}\left(N, \operatorname{gInv}, g, \operatorname{wExp}, \operatorname{nA}, \operatorname{nE}, m, \operatorname{mod}\left(a, \left(2\right)^{\operatorname{wExp}}\right)\right)\right) & \text{otherwise} \end{cases} \cdot \operatorname{geSourceWindow}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{wMul}, k, \left\lfloor\frac{a}{\left(2\right)^{\operatorname{wExp}}}\right\rfloor\right)\right), N\right)$

define gePhaseCoeff(w : Math, tOff : Math, i : Math, s : Math)
equation gePhaseCoeff(w, tOff, i, s) := $\operatorname{mod}\left(\sum_{a < \left(2\right)^{w}} \left(\left(\operatorname{bit}\left(T_{\left(\operatorname{tOff} + a\right)}, i\right) \cdot \operatorname{ppSpec}\left(w, s, a\right)\right)\right), 2\right)$

define gePhaseWord(w : Math, tOff : Math, i : Math, lo : Math)
equation gePhaseWord(w, tOff, i, lo) := $\sum_{\operatorname{hi} < \left(2\right)^{\operatorname{halfHi}\left(w\right)}} \left(\left(\operatorname{gePhaseCoeff}\left(w, \operatorname{tOff}, i, \left(\operatorname{lo} + \left(\left(2\right)^{\operatorname{halfLo}\left(w\right)} \cdot \operatorname{hi}\right)\right)\right) \cdot \left(2\right)^{\operatorname{hi}}\right)\right)$

define runwayLookupAdd(bits : Math, gSep : Math, pieceLen : Math, x : Math, y : Math)
equation runwayLookupAdd(bits, gSep, pieceLen, x, y) := $\sum_{p < \operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right)} \left(\left(\operatorname{mod}\left(\left(\operatorname{mod}\left(\left\lfloor\frac{x}{\left(2\right)^{\left(p \cdot \operatorname{pieceLen}\right)}}\right\rfloor, \left(2\right)^{\operatorname{pieceLen}}\right) + \operatorname{mod}\left(\left\lfloor\frac{y}{\left(2\right)^{\left(p \cdot \operatorname{gSep}\right)}}\right\rfloor, \left(2\right)^{\operatorname{gSep}}\right)\right), \left(2\right)^{\operatorname{pieceLen}}\right) \cdot \left(2\right)^{\left(p \cdot \operatorname{pieceLen}\right)}\right)\right)$

define bmodAbs(u : Math, n : Math)
equation bmodAbs(u, n) := $\begin{cases} \operatorname{mod}\left(u, n\right) & \left(\operatorname{mod}\left(u, n\right) < \left\lfloor\frac{\left(n + 1\right)}{2}\right\rfloor\right) \\ \left(n - \operatorname{mod}\left(u, n\right)\right) & \text{otherwise} \end{cases}$

define ehRecoverable(m : Math, l : Math, d : Math, A : Math, r : Math, j : Math, k : Math)
equation ehRecoverable(m, l, d, A, r, j, k) := $\left(\left(\operatorname{bmodAbs}\left(\left(\left(d \cdot j\right) + \left(\left(2\right)^{m} \cdot k\right)\right), \left(2\right)^{\left(l + m\right)}\right) < A\right) \land \forall a < r, \left(\left(\left(a = 0\right) \lor \left(r \le \operatorname{bmodAbs}\left(\left(a \cdot j\right), \left(2\right)^{\left(l + m\right)}\right)\right)\right)\right)\right)$

define ehTail(m : Math, l : Math, A : Math, r : Math)
equation ehTail(m, l, A, r) := $\left(\left(\left(\frac{41}{100} \cdot \left(\frac{\left(2\right)^{\left(2 \cdot m\right)}}{\left(A\right)^{2}} + \frac{\left(2\right)^{m}}{A}\right)\right) + \left(\frac{\left(2\right)^{\left(2 \cdot m\right)}}{\left(2\right)^{\left(2 \cdot \left(\left(l + m\right) - 5\right)\right)}} + \frac{\left(2\right)^{m}}{\left(2\right)^{\left(\left(l + m\right) - 5\right)}}\right)\right) + \frac{\left(15 \cdot \left(r\right)^{2}\right)}{\left(2\right)^{\left(l + m\right)}}\right)$

define ehRootEq(p : Math, d : Math, N : Math)
equation ehRootEq(p, d, N) := $\left(\left(\left(p \cdot p\right) + N\right) = \left(d \cdot p\right)\right)$

define ehFactorHigh(d : Math, N : Math)
equation ehFactorHigh(d, N) := $\left\lfloor\frac{\left(d + \operatorname{isqrt}\left(\left(\left(d \cdot d\right) - \left(4 \cdot N\right)\right)\right)\right)}{2}\right\rfloor$

define ehFactorLow(d : Math, N : Math)
equation ehFactorLow(d, N) := $\left\lfloor\frac{\left(d - \operatorname{isqrt}\left(\left(\left(d \cdot d\right) - \left(4 \cdot N\right)\right)\right)\right)}{2}\right\rfloor$

define ehSum(d : Math, m : Math)
equation ehSum(d, m) := $\left(2 \cdot \left(\left(d + \left(2\right)^{m}\right) + 1\right)\right)$

define toffRelocAdder(n : Math)
equation toffRelocAdder(n) := $\left(2 \cdot n\right)$

define cliffRelocAdder(n : Math)
equation cliffRelocAdder(n) := $\left(4 \cdot n\right)$

define toffRunwayAdd(bits : Math, gSep : Math, pieceLen : Math)
equation toffRunwayAdd(bits, gSep, pieceLen) := $\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{toffRelocAdder}\left(\operatorname{pieceLen}\right)\right)$

define cliffRunwayAdd(bits : Math, gSep : Math, pieceLen : Math)
equation cliffRunwayAdd(bits, gSep, pieceLen) := $\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{cliffRelocAdder}\left(\operatorname{pieceLen}\right)\right)$

define toffQROM(d : Math)
equation toffQROM(d) := $\left(\left(2\right)^{d} - 1\right)$

define measQROM(d : Math)
equation measQROM(d) := $\left(\left(2\right)^{d} - 1\right)$

define cliffQROM(d : Math, W : Math, base : Math, tOff : Math)
equation cliffQROM(d, W, base, tOff) := $\left(\left(7 \cdot \left(\left(2\right)^{d} - 1\right)\right) + \sum_{a < \left(2\right)^{d}} \left(\sum_{j < W} \left(\operatorname{bit}\left(T_{\left(\left(\operatorname{tOff} + \operatorname{base}\right) + a\right)}, j\right)\right)\right)\right)$

define toffPP(k : Math)
equation toffPP(k) := $\left(\left(\left(2\right)^{k} - k\right) - 1\right)$

define cliffPP(k : Math)
equation cliffPP(k) := $\left(k + 1\right)$

define cliffPPRelease(k : Math)
equation cliffPPRelease(k) := $\left(\left(\left(5 \cdot \operatorname{toffPP}\left(k\right)\right) + k\right) + 1\right)$

define measPPRelease(k : Math)
equation measPPRelease(k) := $\operatorname{toffPP}\left(k\right)$

define toffPhaseup(w : Math)
equation toffPhaseup(w) := $\left(\operatorname{toffPP}\left(\operatorname{halfLo}\left(w\right)\right) + \operatorname{toffPP}\left(\operatorname{halfHi}\left(w\right)\right)\right)$

define phaseBits(W : Math, kL : Math, kH : Math, ppLow : Math, ppHigh : Math, tOff : Math, z : Math)
equation phaseBits(W, kL, kH, ppLow, ppHigh, tOff, z) := $\sum_{i < W} \left(\left(\operatorname{mod}\left(\operatorname{maskedPhase}\left(\operatorname{kL}, \operatorname{kH}, \operatorname{ppLow}, \operatorname{ppHigh}, \left(\left(\operatorname{tOff} \cdot \left(W \cdot \left(2\right)^{\operatorname{kL}}\right)\right) + \left(i \cdot \left(2\right)^{\operatorname{kL}}\right)\right), z\right), 2\right) \cdot \left(2\right)^{i}\right)\right)$

define maskedPhase(kL : Math, kH : Math, ppLow : Math, ppHigh : Math, tOff : Math, z : Math)
equation maskedPhase(kL, kH, ppLow, ppHigh, tOff, z) := $\sum_{\operatorname{mL} < \left(2\right)^{\operatorname{kL}}} \left(\sum_{\operatorname{mH} < \left(2\right)^{\operatorname{kH}}} \left(\left(\left(\operatorname{bit}\left(\operatorname{Tbar}_{\left(\operatorname{tOff} + \operatorname{mL}\right)}, \operatorname{mH}\right) \cdot \operatorname{bit}\left(z, \left(\operatorname{ppLow} + \operatorname{mL}\right)\right)\right) \cdot \operatorname{bit}\left(z, \left(\operatorname{ppHigh} + \operatorname{mH}\right)\right)\right)\right)\right)$

define czUnlookup(W : Math, w : Math, tOff : Math)
equation czUnlookup(W, w, tOff) := $\left(\left(2\right)^{\operatorname{halfLo}\left(w\right)} \cdot \left(2\right)^{\operatorname{halfHi}\left(w\right)}\right)$

define parityPhase(W : Math, kL : Math, kH : Math, ppLow : Math, ppHigh : Math, tOff : Math, r : Math, z : Math)
equation parityPhase(W, kL, kH, ppLow, ppHigh, tOff, r, z) := $\sum_{i < W} \left(\left(\operatorname{bit}\left(r, i\right) \cdot \operatorname{maskedPhase}\left(\operatorname{kL}, \operatorname{kH}, \operatorname{ppLow}, \operatorname{ppHigh}, \left(\left(\operatorname{tOff} \cdot \left(W \cdot \left(2\right)^{\operatorname{kL}}\right)\right) + \left(i \cdot \left(2\right)^{\operatorname{kL}}\right)\right), z\right)\right)\right)$

define cliffUnlookup(W : Math, w : Math, tOff : Math)
equation cliffUnlookup(W, w, tOff) := $\left(\left(\left(\left(\left(\left(2 \cdot W\right) + \operatorname{cliffPP}\left(\operatorname{halfLo}\left(w\right)\right)\right) + \operatorname{cliffPP}\left(\operatorname{halfHi}\left(w\right)\right)\right) + \operatorname{cliffPPRelease}\left(\operatorname{halfLo}\left(w\right)\right)\right) + \operatorname{cliffPPRelease}\left(\operatorname{halfHi}\left(w\right)\right)\right) + \left(3 \cdot \operatorname{czUnlookup}\left(W, w, \operatorname{tOff}\right)\right)\right)$

define measUnlookup(W : Math, w : Math)
equation measUnlookup(W, w) := $\left(\left(W + \operatorname{measPPRelease}\left(\operatorname{halfLo}\left(w\right)\right)\right) + \operatorname{measPPRelease}\left(\operatorname{halfHi}\left(w\right)\right)\right)$

define toffLookupAdd(w : Math, bits : Math, gSep : Math, pieceLen : Math)
equation toffLookupAdd(w, bits, gSep, pieceLen) := $\left(\left(\operatorname{toffQROM}\left(w\right) + \operatorname{toffRunwayAdd}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) + \operatorname{toffPhaseup}\left(w\right)\right)$

define cliffLookupAdd(w : Math, W : Math, bits : Math, gSep : Math, pieceLen : Math, tOff : Math)
equation cliffLookupAdd(w, W, bits, gSep, pieceLen, tOff) := $\left(\left(\operatorname{cliffQROM}\left(w, W, 0, \operatorname{tOff}\right) + \operatorname{cliffRunwayAdd}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) + \operatorname{cliffUnlookup}\left(W, w, \operatorname{tOff}\right)\right)$

define measLookupAdd(w : Math, W : Math)
equation measLookupAdd(w, W) := $\left(\operatorname{measQROM}\left(w\right) + \operatorname{measUnlookup}\left(W, w\right)\right)$

define toffFoldPair(bits : Math, gSep : Math, pieceLen : Math)
equation toffFoldPair(bits, gSep, pieceLen) := $\left(\left(2 \cdot \left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right)\right) \cdot \operatorname{toffRelocAdder}\left(\left(\left(\operatorname{pieceLen} - \operatorname{gSep}\right) + 1\right)\right)\right)$

define cliffFoldPair(bits : Math, gSep : Math, pieceLen : Math)
equation cliffFoldPair(bits, gSep, pieceLen) := $\left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right) \cdot \left(\left(14 \cdot \left(\operatorname{pieceLen} - \operatorname{gSep}\right)\right) + 22\right)\right)$

define toffLaChain(wExp : Math, wMul : Math, bits : Math, gSep : Math, pieceLen : Math, numMults : Math, numWinMul : Math)
equation toffLaChain(wExp, wMul, bits, gSep, pieceLen, numMults, numWinMul) := $\left(\left(2 \cdot \operatorname{numMults}\right) \cdot \left(\left(\operatorname{numWinMul} \cdot \operatorname{toffLookupAdd}\left(\left(\operatorname{wExp} + \operatorname{wMul}\right), \operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) + \operatorname{toffFoldPair}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right)\right)$

define measLaChain(wExp : Math, wMul : Math, W : Math, numMults : Math, numWinMul : Math)
equation measLaChain(wExp, wMul, W, numMults, numWinMul) := $\left(\left(\left(2 \cdot \operatorname{numMults}\right) \cdot \operatorname{numWinMul}\right) \cdot \operatorname{measLookupAdd}\left(\left(\operatorname{wExp} + \operatorname{wMul}\right), W\right)\right)$

define cliffLaChain(wExp : Math, wMul : Math, W : Math, bits : Math, gSep : Math, pieceLen : Math, numMults : Math, numWinMul : Math, tSize : Math)
equation cliffLaChain(wExp, wMul, W, bits, gSep, pieceLen, numMults, numWinMul, tSize) := $\sum_{m < \operatorname{numMults}} \left(\sum_{p < 2} \left(\left(\operatorname{cliffFoldPair}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right) + \sum_{k < \operatorname{numWinMul}} \left(\left(\left(\left(2 \cdot \operatorname{wExp}\right) + \left(2 \cdot \operatorname{min}\left(\operatorname{wMul}, \left(\operatorname{vwWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right) - \left(k \cdot \operatorname{wMul}\right)\right)\right)\right)\right) + \operatorname{cliffLookupAdd}\left(\left(\operatorname{wExp} + \operatorname{wMul}\right), W, \operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \left(\left(\left(\left(\left(2 \cdot m\right) + p\right) \cdot \operatorname{numWinMul}\right) + k\right) \cdot \operatorname{tSize}\right)\right)\right)\right)\right)\right)\right)$

define toffMulAccConst(bits : Math)
equation toffMulAccConst(bits) := $\left(\operatorname{bits} \cdot \operatorname{toffRelocAdder}\left(\operatorname{bits}\right)\right)$

define toffMulInPlace(bits : Math)
equation toffMulInPlace(bits) := $\left(2 \cdot \operatorname{toffMulAccConst}\left(\operatorname{bits}\right)\right)$

define toffMulAccConstLow(bits : Math, low : Math)
equation toffMulAccConstLow(bits, low) := $\left(\operatorname{low} \cdot \operatorname{toffRelocAdder}\left(\operatorname{bits}\right)\right)$

define toffMulFromLow(bits : Math, low : Math)
equation toffMulFromLow(bits, low) := $\left(\operatorname{toffMulAccConstLow}\left(\operatorname{bits}, \operatorname{low}\right) + \operatorname{toffMulAccConst}\left(\operatorname{bits}\right)\right)$

define toffCosetPrep(bits : Math, cm : Math)
equation toffCosetPrep(bits, cm) := $\left(\operatorname{toffMulFromLow}\left(\operatorname{bits}, \operatorname{cm}\right) + \operatorname{toffRelocAdder}\left(\operatorname{bits}\right)\right)$

define cliffCtrlAddConst(bits : Math, cst : Math)
equation cliffCtrlAddConst(bits, cst) := $\left(\left(2 \cdot \operatorname{popCount}\left(\operatorname{cst}, \operatorname{bits}\right)\right) + \operatorname{cliffRelocAdder}\left(\operatorname{bits}\right)\right)$

define cliffMulAccConst(bits : Math, cst : Math)
equation cliffMulAccConst(bits, cst) := $\sum_{i < \operatorname{bits}} \left(\operatorname{cliffCtrlAddConst}\left(\operatorname{bits}, \operatorname{mod}\left(\left(\operatorname{cst} \cdot \left(2\right)^{i}\right), \left(2\right)^{\operatorname{bits}}\right)\right)\right)$

define cliffMulInPlace(bits : Math, cst : Math, cstInv : Math)
equation cliffMulInPlace(bits, cst, cstInv) := $\left(\left(\operatorname{cliffMulAccConst}\left(\operatorname{bits}, \operatorname{cst}\right) + \left(3 \cdot \operatorname{bits}\right)\right) + \operatorname{cliffMulAccConst}\left(\operatorname{bits}, \operatorname{mod}\left(\left(\left(2\right)^{\operatorname{bits}} - \operatorname{cstInv}\right), \left(2\right)^{\operatorname{bits}}\right)\right)\right)$

define cliffMulAccConstLow(bits : Math, cst : Math, low : Math)
equation cliffMulAccConstLow(bits, cst, low) := $\sum_{i < \operatorname{low}} \left(\operatorname{cliffCtrlAddConst}\left(\operatorname{bits}, \operatorname{mod}\left(\left(\operatorname{cst} \cdot \left(2\right)^{i}\right), \left(2\right)^{\operatorname{bits}}\right)\right)\right)$

define cliffMulFromLow(bits : Math, cst : Math, cstInv : Math, low : Math)
equation cliffMulFromLow(bits, cst, cstInv, low) := $\left(\left(\operatorname{cliffMulAccConstLow}\left(\operatorname{bits}, \operatorname{cst}, \operatorname{low}\right) + \left(3 \cdot \operatorname{bits}\right)\right) + \operatorname{cliffMulAccConst}\left(\operatorname{bits}, \operatorname{mod}\left(\left(\left(2\right)^{\operatorname{bits}} - \operatorname{cstInv}\right), \left(2\right)^{\operatorname{bits}}\right)\right)\right)$

define cliffAddConstInto(bits : Math, cst : Math)
equation cliffAddConstInto(bits, cst) := $\left(\left(2 \cdot \operatorname{popCount}\left(\operatorname{cst}, \operatorname{bits}\right)\right) + \operatorname{cliffRelocAdder}\left(\operatorname{bits}\right)\right)$

define cliffCosetPrep(bits : Math, cm : Math, N : Math, Ninv : Math, k : Math)
equation cliffCosetPrep(bits, cm, N, Ninv, k) := $\left(\left(\operatorname{cm} + \operatorname{cliffMulFromLow}\left(\operatorname{bits}, N, \operatorname{Ninv}, \operatorname{cm}\right)\right) + \operatorname{cliffAddConstInto}\left(\operatorname{bits}, k\right)\right)$

define toffInsertRunways(bits : Math, cm : Math, gSep : Math)
equation toffInsertRunways(bits, cm, gSep) := $\sum_{p < \left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right)} \left(\operatorname{toffRelocAdder}\left(\left(\left(\left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - p\right) - 1\right) \cdot \operatorname{gSep}\right) + \operatorname{cm}\right)\right)\right)$

define cliffInsertRunways(bits : Math, cm : Math, gSep : Math)
equation cliffInsertRunways(bits, cm, gSep) := $\sum_{p < \left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right)} \left(\left(\left(9 \cdot \left(\left(\left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - p\right) - 1\right) \cdot \operatorname{gSep}\right) + \operatorname{cm}\right)\right) + \left(3 \cdot \operatorname{cm}\right)\right)\right)$

define toffPrepRunways(bits : Math, cm : Math, gSep : Math)
equation toffPrepRunways(bits, cm, gSep) := $\left(\operatorname{toffCosetPrep}\left(\left(\operatorname{bits} + \operatorname{cm}\right), \operatorname{cm}\right) + \operatorname{toffInsertRunways}\left(\operatorname{bits}, \operatorname{cm}, \operatorname{gSep}\right)\right)$

define cliffPrepRunways(bits : Math, cm : Math, gSep : Math, N : Math, Ninv : Math, k : Math)
equation cliffPrepRunways(bits, cm, gSep, N, Ninv, k) := $\left(\operatorname{cliffCosetPrep}\left(\left(\operatorname{bits} + \operatorname{cm}\right), \operatorname{cm}, N, \operatorname{Ninv}, k\right) + \operatorname{cliffInsertRunways}\left(\operatorname{bits}, \operatorname{cm}, \operatorname{gSep}\right)\right)$

define ladderLen(wExp : Math, nA : Math, m : Math, i : Math)
equation ladderLen(wExp, nA, m, i) := $\left(\left(\left(m \cdot \operatorname{wExp}\right) + i\right) - \left(\left\lfloor\frac{\left(m \cdot \operatorname{wExp}\right)}{\operatorname{nA}}\right\rfloor \cdot \operatorname{nA}\right)\right)$

define tIdealRead(wExp : Math, nA : Math, m : Math)
equation tIdealRead(wExp, nA, m) := $\left(2 \cdot \sum_{i < \operatorname{wExp}} \left(\operatorname{min}\left(\operatorname{ladderLen}\left(\operatorname{wExp}, \operatorname{nA}, m, i\right), 1\right)\right)\right)$

define rotIdealRead(wExp : Math, nA : Math, m : Math)
equation rotIdealRead(wExp, nA, m) := $\left(2 \cdot \sum_{i < \operatorname{wExp}} \left(\operatorname{max}\left(\left(\operatorname{ladderLen}\left(\operatorname{wExp}, \operatorname{nA}, m, i\right) - 1\right), 0\right)\right)\right)$

define cliffIdealRead(wExp : Math, nA : Math, m : Math)
equation cliffIdealRead(wExp, nA, m) := $\left(\operatorname{wExp} + \left(2 \cdot \sum_{i < \operatorname{wExp}} \left(\operatorname{ladderLen}\left(\operatorname{wExp}, \operatorname{nA}, m, i\right)\right)\right)\right)$

define ge2021Layout(bits : Math, cm : Math, pBase : Math, wBase : Math, outBase : Math, addBase : Math, addrZone : Math, expWire : Math, ctrl : Math, gSep : Math, pieceLen : Math, wExp : Math, wMul : Math, numMults : Math)
equation ge2021Layout(bits, cm, pBase, wBase, outBase, addBase, addrZone, expWire, ctrl, gSep, pieceLen, wExp, wMul, numMults) := $\left(\left(\left(\operatorname{pBase} + \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) \le \operatorname{wBase}\right) \land \left(\left(\left(\operatorname{wBase} + \operatorname{regWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) \le \operatorname{outBase}\right) \land \left(\left(\left(\operatorname{outBase} + \operatorname{outWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) \le \operatorname{addrZone}\right) \land \left(\left(\left(\operatorname{addrZone} + \operatorname{zoneStride}\left(\operatorname{wExp}, \operatorname{wMul}\right)\right) \le \operatorname{expWire}\right) \land \left(\left(\left(\operatorname{expWire} + \left(\operatorname{numMults} \cdot \operatorname{wExp}\right)\right) \le \operatorname{ctrl}\right) \land \left(\left(\left(\left(\operatorname{outBase} + \operatorname{bits}\right) + \operatorname{cm}\right) \le \operatorname{addBase}\right) \land \left(\left(\left(\left(\left(\operatorname{addBase} + \operatorname{bits}\right) + \operatorname{cm}\right) + 1\right) \le \operatorname{ctrl}\right) \land \left(\operatorname{ctrl} < \operatorname{dim}\right)\right)\right)\right)\right)\right)\right)\right)$

define geAdderCarry(k : Math, x : Math, y : Math)
equation geAdderCarry(k, x, y) := $\left\lfloor\frac{\left(\operatorname{mod}\left(x, \left(2\right)^{k}\right) + \operatorname{mod}\left(y, \left(2\right)^{k}\right)\right)}{\left(2\right)^{k}}\right\rfloor$

define geAdderMiddle(n : Math, x : Math, y : Math)
equation geAdderMiddle(n, x, y) := $\sum_{j < n} \left(\left(\operatorname{xor}\left(\operatorname{geAdderCarry}\left(\left(j + 1\right), x, y\right), \operatorname{bit}\left(y, \left(j + 1\right)\right)\right) \cdot \left(2\right)^{j}\right)\right)$

define majChainWord(n : Math, accBase : Math, addBase : Math, z : Math)
equation majChainWord(n, accBase, addBase, z) := $\operatorname{setReg}\left(\operatorname{setReg}\left(\operatorname{setReg}\left(z, \operatorname{accBase}, n, \operatorname{xor}\left(\operatorname{getReg}\left(z, \operatorname{accBase}, n\right), \operatorname{getReg}\left(z, \operatorname{addBase}, n\right)\right)\right), \operatorname{addBase}, n, \operatorname{geAdderMiddle}\left(n, \operatorname{getReg}\left(z, \operatorname{accBase}, n\right), \operatorname{getReg}\left(z, \operatorname{addBase}, n\right)\right)\right), \left(\operatorname{addBase} + n\right), 1, \operatorname{bit}\left(\operatorname{getReg}\left(z, \operatorname{addBase}, n\right), 0\right)\right)$

define addWord(n : Math, accBase : Math, addBase : Math, z : Math)
equation addWord(n, accBase, addBase, z) := $\operatorname{setReg}\left(z, \operatorname{accBase}, n, \left(\operatorname{getReg}\left(z, \operatorname{accBase}, n\right) + \operatorname{getReg}\left(z, \operatorname{addBase}, n\right)\right)\right)$

define xorReg(z : Math, base : Math, n : Math, v : Math)
equation xorReg(z, base, n, v) := $\operatorname{setReg}\left(z, \operatorname{base}, n, \operatorname{xor}\left(\operatorname{getReg}\left(z, \operatorname{base}, n\right), v\right)\right)$

define addConstWord(bits : Math, cst : Math, accBase : Math, z : Math)
equation addConstWord(bits, cst, accBase, z) := $\operatorname{setReg}\left(z, \operatorname{accBase}, \operatorname{bits}, \left(\operatorname{getReg}\left(z, \operatorname{accBase}, \operatorname{bits}\right) + \operatorname{cst}\right)\right)$

define getRegS(z : Math, base : Math, stride : Math, n : Math)
equation getRegS(z, base, stride, n) := $\sum_{i < n} \left(\left(\operatorname{bit}\left(z, \left(\operatorname{base} + \left(\operatorname{stride} \cdot i\right)\right)\right) \cdot \left(2\right)^{i}\right)\right)$

define xorRegS(z : Math, base : Math, stride : Math, n : Math, v : Math)
equation xorRegS(z, base, stride, n, v) := $\operatorname{xor}\left(z, \sum_{i < n} \left(\left(\operatorname{bit}\left(v, i\right) \cdot \left(2\right)^{\left(\operatorname{base} + \left(\operatorname{stride} \cdot i\right)\right)}\right)\right)\right)$

define setRegS(z : Math, base : Math, stride : Math, n : Math, v : Math)
equation setRegS(z, base, stride, n, v) := $\operatorname{xorRegS}\left(z, \operatorname{base}, \operatorname{stride}, n, \operatorname{xor}\left(\operatorname{getRegS}\left(z, \operatorname{base}, \operatorname{stride}, n\right), v\right)\right)$

define swapRegS(z : Math, aBase : Math, aStride : Math, yBase : Math, yStride : Math, n : Math)
equation swapRegS(z, aBase, aStride, yBase, yStride, n) := $\operatorname{xorRegS}\left(\operatorname{xorRegS}\left(z, \operatorname{aBase}, \operatorname{aStride}, n, \operatorname{xor}\left(\operatorname{getRegS}\left(z, \operatorname{aBase}, \operatorname{aStride}, n\right), \operatorname{getRegS}\left(z, \operatorname{yBase}, \operatorname{yStride}, n\right)\right)\right), \operatorname{yBase}, \operatorname{yStride}, n, \operatorname{xor}\left(\operatorname{getRegS}\left(z, \operatorname{aBase}, \operatorname{aStride}, n\right), \operatorname{getRegS}\left(z, \operatorname{yBase}, \operatorname{yStride}, n\right)\right)\right)$

define mulPrepWord(bits : Math, low : Math, regBase : Math, accBase : Math, addBase : Math, z : Math)
equation mulPrepWord(bits, low, regBase, accBase, addBase, z) := $\operatorname{setReg}\left(\operatorname{setReg}\left(\operatorname{setReg}\left(z, \operatorname{regBase}, \operatorname{bits}, \operatorname{getReg}\left(z, \operatorname{regBase}, \operatorname{low}\right)\right), \operatorname{accBase}, \operatorname{bits}, 0\right), \operatorname{addBase}, \left(\operatorname{bits} + 1\right), 0\right)$

define prepZeroWord(bits : Math, regBase : Math, accBase : Math, addBase : Math, z : Math)
equation prepZeroWord(bits, regBase, accBase, addBase, z) := $\operatorname{setReg}\left(\operatorname{setReg}\left(\operatorname{setReg}\left(z, \operatorname{regBase}, \operatorname{bits}, 0\right), \operatorname{accBase}, \operatorname{bits}, 0\right), \operatorname{addBase}, \left(\operatorname{bits} + 1\right), 0\right)$

define runwayClearWord(bits : Math, gSep : Math, pieceLen : Math, outBase : Math, z : Math)
equation runwayClearWord(bits, gSep, pieceLen, outBase, z) := $\operatorname{setRegS}\left(z, \left(\operatorname{outBase} + \operatorname{pieceLen}\right), \left(\operatorname{pieceLen} + 1\right), \operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right), 0\right)$

define runwaySumWord(bits : Math, gSep : Math, pieceLen : Math, runBase : Math, outBase : Math, z : Math)
equation runwaySumWord(bits, gSep, pieceLen, runBase, outBase, z) := $\operatorname{setReg}\left(z, \operatorname{runBase}, \left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{pieceLen}\right), \sum_{p < \operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right)} \left(\left(\operatorname{mod}\left(\left(\operatorname{getReg}\left(z, \left(\operatorname{runBase} + \left(p \cdot \operatorname{pieceLen}\right)\right), \operatorname{pieceLen}\right) + \operatorname{getReg}\left(z, \left(\operatorname{outBase} + \left(p \cdot \left(\operatorname{pieceLen} + 1\right)\right)\right), \operatorname{pieceLen}\right)\right), \left(2\right)^{\operatorname{pieceLen}}\right) \cdot \left(2\right)^{\left(p \cdot \operatorname{pieceLen}\right)}\right)\right)\right)$

define rwDigit(cc : Math, cm : Math, q : Math)
equation rwDigit(cc, cm, q) := $\operatorname{mod}\left(\operatorname{shr}\left(\operatorname{cc}, \left(q \cdot \operatorname{cm}\right)\right), \left(2\right)^{\operatorname{cm}}\right)$

define rwUpper(gSep : Math, cm : Math, pc : Math, g : Math, cc : Math, p : Math)
equation rwUpper(gSep, cm, pc, g, cc, p) := $\operatorname{shr}\left(\operatorname{mod}\left(\left(g - \sum_{q < p} \left(\left(\operatorname{rwDigit}\left(\operatorname{cc}, \operatorname{cm}, q\right) \cdot \left(2\right)^{\left(\left(q + 1\right) \cdot \operatorname{gSep}\right)}\right)\right)\right), \left(2\right)^{\left(\left(\operatorname{pc} \cdot \operatorname{gSep}\right) + \operatorname{cm}\right)}\right), \left(p \cdot \operatorname{gSep}\right)\right)$

define rwPiece(gSep : Math, cm : Math, pc : Math, g : Math, cc : Math, p : Math)
equation rwPiece(gSep, cm, pc, g, cc, p) := $\begin{cases} \left(\operatorname{mod}\left(\operatorname{rwUpper}\left(\operatorname{gSep}, \operatorname{cm}, \operatorname{pc}, g, \operatorname{cc}, p\right), \left(2\right)^{\operatorname{gSep}}\right) + \left(\left(2\right)^{\operatorname{gSep}} \cdot \operatorname{rwDigit}\left(\operatorname{cc}, \operatorname{cm}, p\right)\right)\right) & \left(\left(p + 1\right) < \operatorname{pc}\right) \\ \operatorname{rwUpper}\left(\operatorname{gSep}, \operatorname{cm}, \operatorname{pc}, g, \operatorname{cc}, p\right) & \text{otherwise} \end{cases}$

define rwEnc(bits : Math, gSep : Math, cm : Math, g : Math, cc : Math)
equation rwEnc(bits, gSep, cm, g, cc) := $\sum_{p < \operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right)} \left(\left(\operatorname{rwPiece}\left(\operatorname{gSep}, \operatorname{cm}, \operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right), g, \operatorname{cc}, p\right) \cdot \left(2\right)^{\left(p \cdot \left(\operatorname{gSep} + \operatorname{cm}\right)\right)}\right)\right)$

define rwFoldSum(gSep : Math, pieceLen : Math, R : Math, z : Math, p : Math)
equation rwFoldSum(gSep, pieceLen, R, z, p) := $\left(\operatorname{getReg}\left(z, \left(R + \left(\left(p + 1\right) \cdot \operatorname{pieceLen}\right)\right), \left(\operatorname{pieceLen} - \operatorname{gSep}\right)\right) + \operatorname{getReg}\left(z, \left(\left(R + \left(p \cdot \operatorname{pieceLen}\right)\right) + \operatorname{gSep}\right), \left(\operatorname{pieceLen} - \operatorname{gSep}\right)\right)\right)$

define rwFold(p : Math, gSep : Math, pieceLen : Math, R : Math, pc : Math, z : Math)
equation rwFold(0, gSep, pieceLen, R, pc, z) := $z$

equation rwFold(p+1, gSep, pieceLen, R, pc, z) := $\operatorname{setReg}\left(\operatorname{setReg}\left(\operatorname{rwFold}\left(p, \operatorname{gSep}, \operatorname{pieceLen}, R, \operatorname{pc}, z\right), \left(R + \left(\left(p + 1\right) \cdot \operatorname{pieceLen}\right)\right), \left(\operatorname{pieceLen} - \operatorname{gSep}\right), \operatorname{mod}\left(\operatorname{rwFoldSum}\left(\operatorname{gSep}, \operatorname{pieceLen}, R, z, p\right), \left(2\right)^{\left(\operatorname{pieceLen} - \operatorname{gSep}\right)}\right)\right), \left(\left(R + \left(\operatorname{pc} \cdot \operatorname{pieceLen}\right)\right) + p\right), 1, \operatorname{shr}\left(\operatorname{rwFoldSum}\left(\operatorname{gSep}, \operatorname{pieceLen}, R, z, p\right), \left(\operatorname{pieceLen} - \operatorname{gSep}\right)\right)\right)$

define rwFolded(bits : Math, gSep : Math, pieceLen : Math, R : Math, z : Math)
equation rwFolded(bits, gSep, pieceLen, R, z) := $\operatorname{rwFold}\left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) - 1\right), \operatorname{gSep}, \operatorname{pieceLen}, R, \operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right), z\right)$

define vwWord(bits : Math, gSep : Math, pieceLen : Math, y : Math)
equation vwWord(bits, gSep, pieceLen, y) := $\sum_{v < \operatorname{vwWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)} \left(\left(\operatorname{bit}\left(\operatorname{rwFolded}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, 0, y\right), \operatorname{vwPos}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, 0, v\right)\right) \cdot \left(2\right)^{v}\right)\right)$

define rwPassSum(bits : Math, gSep : Math, pieceLen : Math, wExp : Math, wMul : Math, x : Math, y : Math, e : Math, m : Math, pass : Math, numWinMul : Math, tSize : Math)
equation rwPassSum(bits, gSep, pieceLen, wExp, wMul, x, y, e, m, pass, numWinMul, tSize) := $\sum_{p < \operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right)} \left(\left(\operatorname{mod}\left(\left(\operatorname{mod}\left(\operatorname{shr}\left(x, \left(p \cdot \operatorname{pieceLen}\right)\right), \left(2\right)^{\operatorname{pieceLen}}\right) + \sum_{k < \operatorname{numWinMul}} \left(\operatorname{mod}\left(\operatorname{shr}\left(T_{\left(\left(\left(\left(\left(\left(\left(2 \cdot m\right) + \operatorname{pass}\right) \cdot \operatorname{numWinMul}\right) + k\right) \cdot \operatorname{tSize}\right) + e\right) + \left(\left(2\right)^{\operatorname{wExp}} \cdot \operatorname{mod}\left(\operatorname{shr}\left(\operatorname{vwWord}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, y\right), \left(k \cdot \operatorname{wMul}\right)\right), \left(2\right)^{\operatorname{wMul}}\right)\right)\right)}, \left(p \cdot \operatorname{gSep}\right)\right), \left(2\right)^{\operatorname{gSep}}\right)\right)\right), \left(2\right)^{\operatorname{pieceLen}}\right) \cdot \left(2\right)^{\left(p \cdot \operatorname{pieceLen}\right)}\right)\right)$

define rwMulP(bits : Math, gSep : Math, pieceLen : Math, wExp : Math, wMul : Math, x : Math, y : Math, e : Math, m : Math, numWinMul : Math, tSize : Math)
equation rwMulP(bits, gSep, pieceLen, wExp, wMul, x, y, e, m, numWinMul, tSize) := $\begin{cases} \operatorname{rwPassSum}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{wExp}, \operatorname{wMul}, x, \operatorname{rwPassSum}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{wExp}, \operatorname{wMul}, y, x, e, m, 0, \operatorname{numWinMul}, \operatorname{tSize}\right), e, m, 1, \operatorname{numWinMul}, \operatorname{tSize}\right) & \left(\operatorname{mod}\left(m, 2\right) = 0\right) \\ \operatorname{rwPassSum}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{wExp}, \operatorname{wMul}, x, y, e, m, 0, \operatorname{numWinMul}, \operatorname{tSize}\right) & \text{otherwise} \end{cases}$

define rwMulW(bits : Math, gSep : Math, pieceLen : Math, wExp : Math, wMul : Math, x : Math, y : Math, e : Math, m : Math, numWinMul : Math, tSize : Math)
equation rwMulW(bits, gSep, pieceLen, wExp, wMul, x, y, e, m, numWinMul, tSize) := $\begin{cases} \operatorname{rwPassSum}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{wExp}, \operatorname{wMul}, y, x, e, m, 0, \operatorname{numWinMul}, \operatorname{tSize}\right) & \left(\operatorname{mod}\left(m, 2\right) = 0\right) \\ \operatorname{rwPassSum}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{wExp}, \operatorname{wMul}, y, \operatorname{rwPassSum}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{wExp}, \operatorname{wMul}, x, y, e, m, 0, \operatorname{numWinMul}, \operatorname{tSize}\right), e, m, 1, \operatorname{numWinMul}, \operatorname{tSize}\right) & \text{otherwise} \end{cases}$

define rwModStep(bits : Math, gSep : Math, pieceLen : Math, wExp : Math, wMul : Math, state : Math, e : Math, m : Math, numWinMul : Math, tSize : Math)
equation rwModStep(bits, gSep, pieceLen, wExp, wMul, state, e, m, numWinMul, tSize) := $\left(\operatorname{rwMulP}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{wExp}, \operatorname{wMul}, \operatorname{mod}\left(\operatorname{state}, \left(2\right)^{\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{pieceLen}\right)}\right), \left\lfloor\frac{\operatorname{state}}{\left(2\right)^{\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{pieceLen}\right)}}\right\rfloor, \operatorname{mod}\left(\operatorname{shr}\left(e, \left(m \cdot \operatorname{wExp}\right)\right), \left(2\right)^{\operatorname{wExp}}\right), m, \operatorname{numWinMul}, \operatorname{tSize}\right) + \left(\left(2\right)^{\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{pieceLen}\right)} \cdot \operatorname{rwMulW}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{wExp}, \operatorname{wMul}, \operatorname{mod}\left(\operatorname{state}, \left(2\right)^{\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{pieceLen}\right)}\right), \left\lfloor\frac{\operatorname{state}}{\left(2\right)^{\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{pieceLen}\right)}}\right\rfloor, \operatorname{mod}\left(\operatorname{shr}\left(e, \left(m \cdot \operatorname{wExp}\right)\right), \left(2\right)^{\operatorname{wExp}}\right), m, \operatorname{numWinMul}, \operatorname{tSize}\right)\right)\right)$

define rwModState(r : Math, bits : Math, gSep : Math, pieceLen : Math, wExp : Math, wMul : Math, x : Math, y : Math, e : Math, numWinMul : Math, tSize : Math)
equation rwModState(0, bits, gSep, pieceLen, wExp, wMul, x, y, e, numWinMul, tSize) := $\left(x + \left(\left(2\right)^{\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{pieceLen}\right)} \cdot y\right)\right)$

equation rwModState(r+1, bits, gSep, pieceLen, wExp, wMul, x, y, e, numWinMul, tSize) := $\operatorname{rwModStep}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{wExp}, \operatorname{wMul}, \operatorname{rwModState}\left(r, \operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{wExp}, \operatorname{wMul}, x, y, e, \operatorname{numWinMul}, \operatorname{tSize}\right), e, r, \operatorname{numWinMul}, \operatorname{tSize}\right)$

// FormalRV program: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:231
algorithm ge2021Ideal(q : Qubit[], c : Bit[]) {
  capacity q $\left(\operatorname{ctrl} + 1\right)$
  capacity c $\operatorname{recSlots}$
  call gePrepareRunways(q, c, bits, cm, N, Ninv, 1, gSep, pBase, outBase, addBase) @ id()
  call gePrepareRunways(q, c, bits, cm, N, Ninv, 0, gSep, wBase, outBase, addBase) @ id()
  call hadamards(q, c, expWire, nA + ehL) @ id()
  X(q[ctrl])
  call gModExpIdealLoaded(q, c, wExp, wMul, W, bits, gSep, pieceLen, pBase, wBase, outBase, addrZone, expWire, numMults, numWin, numWinMul, tSize, ctrl, 0, nA) @ id()
  call gIdealIQFT(q, c, expWire, nA + ehL, nA) @ id()
  call gExpAllMeasure(q, c, 1, expWire, nA + ehL, 2*numMults*numWinMul*((2^(wExp + wMul) - 1) + W + (2^((wExp + wMul) div 2) - (wExp + wMul) div 2 - 1) + (2^((wExp + wMul) - (wExp + wMul) div 2) - ((wExp + wMul) - (wExp + wMul) div 2) - 1))) @ id()
  call readout(q, c, bits, gSep, pieceLen, pBase, wBase, numMults, 2*numMults*numWinMul*((2^(wExp + wMul) - 1) + W + (2^((wExp + wMul) div 2) - (wExp + wMul) div 2 - 1) + (2^((wExp + wMul) - (wExp + wMul) div 2) - ((wExp + wMul) - (wExp + wMul) div 2) - 1)) + nA + ehL) @ id()
}

