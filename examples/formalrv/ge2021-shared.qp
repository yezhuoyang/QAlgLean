// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:513
algorithm cPrepMasked(q : Qubit[], c : Bit[], ctrlIdx : Nat, addBase : Nat, cst : Nat, n : Nat) {
  capacity q $\left(\operatorname{addBase} + n\right)$
  capacity c $0$
  repeat i in 0..n {
    if $\left(\operatorname{mod}\left(\operatorname{shr}\left(\operatorname{cst}, i\right), 2\right) = 1\right)$ {
      CX(q[ctrlIdx], q[addBase + i])
    }
  }
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:518
