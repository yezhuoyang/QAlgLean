// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:1050
algorithm gRunwayAdd(q : Qubit[], c : Bit[], bits : Nat, gSep : Nat, pieceLen : Nat, runBase : Nat, outBase : Nat) {
  capacity q $\operatorname{max}\left(\left(\operatorname{runBase} + \left(\left\lfloor\frac{\left(\left(\operatorname{bits} + \operatorname{gSep}\right) - 1\right)}{\operatorname{gSep}}\right\rfloor \cdot \operatorname{pieceLen}\right)\right), \left(\operatorname{outBase} + \left(\left\lfloor\frac{\left(\left(\operatorname{bits} + \operatorname{gSep}\right) - 1\right)}{\operatorname{gSep}}\right\rfloor \cdot \left(\operatorname{pieceLen} + 1\right)\right)\right)\right)$
  capacity c $0$
  repeat p in 0..(((bits + gSep - 1) div gSep)) {
    call relocAdder(q, c, pieceLen, runBase + p*pieceLen, outBase + p*(pieceLen + 1)) @ id()
  }
}

spec gRunwayAdd {
  bind $\alpha$
  requires $\left(0 < \operatorname{gSep}\right)$
  requires $\left(0 < \operatorname{bits}\right)$
  requires $\left(0 < \operatorname{pieceLen}\right)$
  requires $\left(\left(\operatorname{runBase} + \left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{pieceLen}\right)\right) \le \operatorname{outBase}\right)$
  requires $\left(\left(\operatorname{outBase} + \operatorname{outWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{runwayClearWord}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{outBase}, z\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{runwaySumWord}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{runBase}, \operatorname{outBase}, \operatorname{runwayClearWord}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{outBase}, z\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  outcomes none
  resource toffoli := $\operatorname{toffRunwayAdd}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)$
  resource t := $\left(7 \cdot \operatorname{toffRunwayAdd}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right)$
  resource clifford := $\operatorname{cliffRunwayAdd}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)$
  resource rot := $0$
  resource meas := $0$
  resource qubits := $\left(\left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \operatorname{pieceLen}\right) + \operatorname{outWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right)$
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:1073
algorithm unaryQROMSegCoh(q : Qubit[], c : Bit[], d : Nat, W : Nat, addrBase : Nat, ancBase : Nat, posBase : Nat, posStride : Nat, segLen : Nat, segStride : Nat, ctrl : Nat, base : Nat, tOff : Nat, cb : Nat) {
  capacity q $\operatorname{dim}$
  capacity c $\operatorname{dim}$
  if $\left(d \ne 0\right)$ {
    CCX(q[ctrl], q[addrBase + d - 1], q[ancBase + d - 1])
    call unaryQROMSegCoh(q, c, d - 1, W, addrBase, ancBase, posBase, posStride, segLen, segStride, ancBase + d - 1, base + 2^(d-1), tOff, cb) @ id()
    CX(q[ctrl], q[ancBase + d - 1])
    call unaryQROMSegCoh(q, c, d - 1, W, addrBase, ancBase, posBase, posStride, segLen, segStride, ancBase + d - 1, base, tOff, cb + 2^(d-1) - 1) @ id()
    CX(q[ctrl], q[ancBase + d - 1])
    H(q[ancBase + d - 1])
    measure q[ancBase + d - 1] -> c[cb + 2^d - 2]
    when $c_{\left(\left(\operatorname{cb} + \left(2\right)^{d}\right) - 2\right)}$ {
      H(q[addrBase + d - 1])
      CX(q[ctrl], q[addrBase + d - 1])
      H(q[addrBase + d - 1])
      X(q[ancBase + d - 1])
    }
  } else {
    repeat j in 0..W {
      if $\left(\operatorname{mod}\left(\operatorname{shr}\left(T_{\left(\operatorname{tOff} + \operatorname{base}\right)}, \left(\left(W - 1\right) - j\right)\right), 2\right) = 1\right)$ {
        CX(q[ctrl], q[(posBase + segStride*((W - 1 - j) div segLen) + posStride*((W - 1 - j)%segLen))])
      }
    }
  }
}

spec unaryQROMSegCoh {
  bind $\alpha$
  requires $\left(0 < W\right)$
  requires $\left(0 < \operatorname{segLen}\right)$
  requires $\left(0 < \operatorname{posStride}\right)$
  requires $\left(\left(\operatorname{addrBase} + d\right) \le \operatorname{ancBase}\right)$
  requires $\left(\left(\operatorname{ancBase} + d\right) \le \operatorname{ctrl}\right)$
  requires $\left(\operatorname{ctrl} < \operatorname{cb}\right)$
  requires $\forall m < W, \left(\forall n < W, \left(\left(\left(m \ne n\right) \implies \left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, m\right) \ne \operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, n\right)\right)\right)\right)\right)$
  requires $\forall m < W, \left(\forall j < d, \left(\left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, m\right) \ne \left(\operatorname{addrBase} + j\right)\right)\right)\right)$
  requires $\forall m < W, \left(\forall j < d, \left(\left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, m\right) \ne \left(\operatorname{ancBase} + j\right)\right)\right)\right)$
  requires $\forall m < W, \left(\left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, m\right) \ne \operatorname{ctrl}\right)\right)$
  requires $\forall m < W, \left(\left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, m\right) < \operatorname{cb}\right)\right)$
  requires $\left(\left(\left(\operatorname{cb} + \left(2\right)^{d}\right) - 1\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{setReg}\left(\operatorname{setReg}\left(z, \operatorname{ancBase}, d, 0\right), \operatorname{cb}, \left(\left(2\right)^{d} - 1\right), 0\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \left(\ket{\operatorname{posXor}\left(W, \operatorname{setReg}\left(z, \operatorname{ancBase}, d, 0\right), \operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, \left(\operatorname{bit}\left(z, \operatorname{ctrl}\right) \cdot T_{\left(\left(\operatorname{tOff} + \operatorname{base}\right) + \operatorname{getReg}\left(z, \operatorname{addrBase}, d\right)\right)}\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{cb}, 1\right)}} \otimes \ket{\operatorname{shr}\left(\operatorname{posXor}\left(W, \operatorname{setReg}\left(z, \operatorname{ancBase}, d, 0\right), \operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, \left(\operatorname{bit}\left(z, \operatorname{ctrl}\right) \cdot T_{\left(\left(\operatorname{tOff} + \operatorname{base}\right) + \operatorname{getReg}\left(z, \operatorname{addrBase}, d\right)\right)}\right)\right), \left(\left(\operatorname{cb} + \left(2\right)^{d}\right) - 1\right)\right)}_{q_{\operatorname{band}\left(\left(\left(\operatorname{cb} + \left(2\right)^{d}\right) - 1\right), \operatorname{dim}, 1\right)}}\right)\right)\right)$
  outcomes none
  resource toffoli := $\operatorname{toffQROM}\left(d\right)$
  resource t := $\left(7 \cdot \operatorname{toffQROM}\left(d\right)\right)$
  resource clifford := $\operatorname{cliffQROM}\left(d, W, \operatorname{base}, \operatorname{tOff}\right)$
  resource rot := $0$
  resource meas := $\operatorname{measQROM}\left(d\right)$
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:1125
algorithm ge2021UnlookPhaseup(q : Qubit[], c : Bit[], W : Nat, posBase : Nat, posStride : Nat, segLen : Nat, segStride : Nat, kL : Nat, kH : Nat, ppLow : Nat, ppHigh : Nat, tOff : Nat, cb : Nat) {
  capacity q $\operatorname{cb}$
  capacity c $\left(\operatorname{cb} + W\right)$
  repeat i in 0..W {
    H(q[(posBase + segStride*(i div segLen) + posStride*(i%segLen))])
    measure q[(posBase + segStride*(i div segLen) + posStride*(i%segLen))] -> c[cb + i]
    when $c_{\left(\operatorname{cb} + i\right)}$ {
      X(q[(posBase + segStride*(i div segLen) + posStride*(i%segLen))])
    }
  }
  call maskedPhaseParity(q, c, W, kL, kH, ppLow, ppHigh, tOff, cb) @ id()
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:1134
algorithm maskedPhaseParity(q : Qubit[], c : Bit[], W : Nat, kL : Nat, kH : Nat, ppLow : Nat, ppHigh : Nat, tOff : Nat, cb : Nat) {
  capacity q $\operatorname{cb}$
  capacity c $\left(\operatorname{cb} + W\right)$
  repeat mL in 0..2^kL {
    repeat mH in 0..2^kH {
      when $\bigoplus_{i < W} \left(\left(c_{\left(\operatorname{cb} + i\right)} \land \left(\operatorname{mod}\left(\operatorname{shr}\left(\operatorname{Tbar}_{\left(\left(\left(\operatorname{tOff} \cdot \left(W \cdot \left(2\right)^{\operatorname{kL}}\right)\right) + \left(i \cdot \left(2\right)^{\operatorname{kL}}\right)\right) + \operatorname{mL}\right)}, \operatorname{mH}\right), 2\right) = 1\right)\right)\right)$ {
        CZ(q[ppLow + mL], q[ppHigh + mH])
      }
    }
  }
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:1140
algorithm ge2021Unlookup(q : Qubit[], c : Bit[], W : Nat, posBase : Nat, posStride : Nat, segLen : Nat, segStride : Nat, w : Nat, addrBase : Nat, ppLow : Nat, ppHigh : Nat, tOff : Nat, cb : Nat) {
  capacity q $\operatorname{cb}$
  capacity c $\left(\left(\left(\operatorname{cb} + W\right) + \left(\left(\left(2\right)^{\left\lfloor\frac{w}{2}\right\rfloor} - \left\lfloor\frac{w}{2}\right\rfloor\right) - 1\right)\right) + \left(\left(\left(2\right)^{\left(w - \left\lfloor\frac{w}{2}\right\rfloor\right)} - \left(w - \left\lfloor\frac{w}{2}\right\rfloor\right)\right) - 1\right)\right)$
  call powerProduct(q, c, (w div 2), addrBase, ppLow) @ id()
  call powerProduct(q, c, (w - w div 2), addrBase + (w div 2), ppHigh) @ id()
  call ge2021UnlookPhaseup(q, c, W, posBase, posStride, segLen, segStride, (w div 2), (w - w div 2), ppLow, ppHigh, tOff, cb) @ id()
  call powerProductRelease(q, c, (w div 2), addrBase, ppLow, cb + W) @ id()
  call powerProductRelease(q, c, (w - w div 2), addrBase + (w div 2), ppHigh, cb + W + (2^(w div 2) - w div 2 - 1)) @ id()
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:1154
algorithm powerProduct(q : Qubit[], c : Bit[], k : Nat, addrBase : Nat, ppBase : Nat) {
  capacity q $\left(\operatorname{ppBase} + \left(2\right)^{k}\right)$
  capacity c $0$
  X(q[ppBase])
  CX(q[addrBase], q[ppBase + 1])
  repeat i in 1..k {
    CX(q[addrBase + i], q[ppBase + 2^i])
    repeat S in 1..2^i {
      CCX(q[ppBase + S], q[addrBase + i], q[ppBase + S + 2^i])
    }
  }
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:1162
algorithm powerProductRelease(q : Qubit[], c : Bit[], k : Nat, addrBase : Nat, ppBase : Nat, cb : Nat) {
  capacity q $\left(\operatorname{ppBase} + \left(2\right)^{k}\right)$
  capacity c $\left(\left(\left(\operatorname{cb} + \left(2\right)^{k}\right) - k\right) - 1\right)$
  repeat i in 0..k {
    repeat S in 1..2^(k - 1 - i) {
      H(q[ppBase + S + 2^(k - 1 - i)])
      measure q[ppBase + S + 2^(k - 1 - i)] -> c[cb + (2^i - 1)*2^(k - i) - i + (S - 1)]
      when $c_{\left(\left(\left(\operatorname{cb} + \left(\left(\left(2\right)^{i} - 1\right) \cdot \left(2\right)^{\left(k - i\right)}\right)\right) - i\right) + \left(S - 1\right)\right)}$ {
        CZ(q[ppBase + S], q[addrBase + k - 1 - i])
        X(q[ppBase + S + 2^(k - 1 - i)])
      }
    }
  }
  repeat i in 0..k {
    CX(q[addrBase + i], q[ppBase + 2^i])
  }
  X(q[ppBase])
}

spec ge2021UnlookPhaseup {
  bind $\left(i < W\right)$
  bind $\alpha$
  requires $\left(0 < W\right)$
  requires $\left(0 < \operatorname{segLen}\right)$
  requires $\left(0 < \operatorname{posStride}\right)$
  requires $\forall m < W, \left(\forall n < W, \left(\left(\left(m \ne n\right) \implies \left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, m\right) \ne \operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, n\right)\right)\right)\right)\right)$
  requires $\forall m < W, \left(\forall S < \left(2\right)^{\operatorname{kL}}, \left(\left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, m\right) \ne \left(\operatorname{ppLow} + S\right)\right)\right)\right)$
  requires $\forall m < W, \left(\forall S < \left(2\right)^{\operatorname{kH}}, \left(\left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, m\right) \ne \left(\operatorname{ppHigh} + S\right)\right)\right)\right)$
  requires $\forall m < W, \left(\left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, m\right) < \operatorname{dim}\right)\right)$
  requires $\left(\left(\operatorname{ppLow} + \left(2\right)^{\operatorname{kL}}\right) \le \operatorname{ppHigh}\right)$
  requires $\left(\left(\operatorname{ppHigh} + \left(2\right)^{\operatorname{kH}}\right) \le \operatorname{dim}\right)$
  requires $\left(\left(\operatorname{ppHigh} + \left(2\right)^{\operatorname{kH}}\right) \le \operatorname{cb}\right)$
  requires $\forall m < W, \left(\left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, m\right) < \operatorname{cb}\right)\right)$
  requires $\left(\left(\operatorname{cb} + W\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{posSet}\left(W, \operatorname{setReg}\left(z, \operatorname{cb}, W, 0\right), \operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, \operatorname{phaseBits}\left(W, \operatorname{kL}, \operatorname{kH}, \operatorname{ppLow}, \operatorname{ppHigh}, \operatorname{tOff}, z\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \left(\ket{\operatorname{posSet}\left(W, z, \operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, 0\right)}_{q_{\operatorname{band}\left(0, \operatorname{cb}, 1\right)}} \otimes \ket{\operatorname{shr}\left(\operatorname{posSet}\left(W, z, \operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, 0\right), \left(\operatorname{cb} + W\right)\right)}_{q_{\operatorname{band}\left(\left(\operatorname{cb} + W\right), \operatorname{dim}, 1\right)}}\right)\right)\right)$
  outcomes $\left(\Pr\left(\left(c_{i} = 1\right)\right) = \frac{1}{2}\right)$
  resource toffoli := $0$
  resource t := $0$
  resource clifford := $\left(\left(2 \cdot W\right) + \left(\left(3 \cdot \left(2\right)^{\operatorname{kL}}\right) \cdot \left(2\right)^{\operatorname{kH}}\right)\right)$
  resource rot := $0$
  resource meas := $W$
}

spec ge2021Unlookup {
  bind $\left(i < W\right)$
  bind $\alpha$
  requires $\left(0 < W\right)$
  requires $\left(1 < w\right)$
  requires $\left(0 < \operatorname{segLen}\right)$
  requires $\left(0 < \operatorname{posStride}\right)$
  requires $\forall u < W, \left(\forall v < W, \left(\left(\left(u \ne v\right) \implies \left(\operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, u\right) \ne \operatorname{posWire}\left(\operatorname{posBase}, \operatorname{posStride}, \operatorname{segLen}, \operatorname{segStride}, v\right)\right)\right)\right)\right)$
