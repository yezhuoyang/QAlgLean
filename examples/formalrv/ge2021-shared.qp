define bit(e : Math, k : Math)
equation bit(e, k) := $\operatorname{mod}\left(\operatorname{shr}\left(e, k\right), 2\right)$

define popCount(x : Math, n : Math)
equation popCount(x, n) := $\sum_{i < n} \left(\operatorname{bit}\left(x, i\right)\right)$

define ceilDiv(x : Math, y : Math)
equation ceilDiv(x, y) := $\left\lfloor\frac{\left(\left(x + y\right) - 1\right)}{y}\right\rfloor$

define pieceCount(bits : Math, gSep : Math)
equation pieceCount(bits, gSep) := $\operatorname{ceilDiv}\left(\operatorname{bits}, \operatorname{gSep}\right)$

define regWidth(bits : Math, gSep : Math, pieceLen : Math)
