  resource clifford := $\operatorname{min}\left(\operatorname{wMul}, \left(\operatorname{vwWidth}\left(\operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right) - \left(k \cdot \operatorname{wMul}\right)\right)\right)$
}

