  requires $\left(\left(\operatorname{ctrlIdx} < \operatorname{addBase}\right) \lor \left(\left(\operatorname{addBase} + n\right) \le \operatorname{ctrlIdx}\right)\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{z}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{xorReg}\left(z, \operatorname{addBase}, n, \left(\operatorname{bit}\left(z, \operatorname{ctrlIdx}\right) \cdot \operatorname{cst}\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  outcomes none
}

spec cPrepConst {
  bind $\alpha$
  requires $\left(\left(\operatorname{addBase} + n\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{z}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{xorReg}\left(z, \operatorname{addBase}, n, \operatorname{cst}\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  outcomes none
}

spec ctrlAddConst {
  bind $\alpha$
  requires $\left(0 < \operatorname{bits}\right)$
  requires $\left(\left(\operatorname{accBase} + \operatorname{bits}\right) \le \operatorname{addBase}\right)$
  requires $\left(\left(\left(\operatorname{addBase} + \operatorname{bits}\right) + 1\right) \le \operatorname{dim}\right)$
  requires $\left(\operatorname{ctrlIdx} < \operatorname{dim}\right)$
  requires $\left(\left(\operatorname{ctrlIdx} < \operatorname{accBase}\right) \lor \left(\left(\operatorname{accBase} + \operatorname{bits}\right) \le \operatorname{ctrlIdx}\right)\right)$
  requires $\left(\left(\operatorname{ctrlIdx} < \operatorname{addBase}\right) \lor \left(\left(\left(\operatorname{addBase} + \operatorname{bits}\right) + 1\right) \le \operatorname{ctrlIdx}\right)\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{setReg}\left(z, \operatorname{addBase}, \left(\operatorname{bits} + 1\right), 0\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{addConstWord}\left(\operatorname{bits}, \left(\operatorname{bit}\left(z, \operatorname{ctrlIdx}\right) \cdot \operatorname{cst}\right), \operatorname{accBase}, \operatorname{setReg}\left(z, \operatorname{addBase}, \left(\operatorname{bits} + 1\right), 0\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  outcomes none
}

spec addConstInto {
  bind $\alpha$
  requires $\left(0 < \operatorname{bits}\right)$
  requires $\left(\left(\operatorname{accBase} + \operatorname{bits}\right) \le \operatorname{addBase}\right)$
  requires $\left(\left(\left(\operatorname{addBase} + \operatorname{bits}\right) + 1\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{setReg}\left(z, \operatorname{addBase}, \left(\operatorname{bits} + 1\right), 0\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{addConstWord}\left(\operatorname{bits}, \operatorname{cst}, \operatorname{accBase}, \operatorname{setReg}\left(z, \operatorname{addBase}, \left(\operatorname{bits} + 1\right), 0\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  outcomes none
}

spec mulAccConst {
  bind $\alpha$
  requires $\left(0 < \operatorname{bits}\right)$
  requires $\left(\left(\operatorname{srcBase} + \operatorname{bits}\right) \le \operatorname{accBase}\right)$
  requires $\left(\left(\operatorname{accBase} + \operatorname{bits}\right) \le \operatorname{addBase}\right)$
  requires $\left(\left(\left(\operatorname{addBase} + \operatorname{bits}\right) + 1\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{setReg}\left(z, \operatorname{addBase}, \left(\operatorname{bits} + 1\right), 0\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{addConstWord}\left(\operatorname{bits}, \left(\operatorname{cst} \cdot \operatorname{getReg}\left(z, \operatorname{srcBase}, \operatorname{bits}\right)\right), \operatorname{accBase}, \operatorname{setReg}\left(z, \operatorname{addBase}, \left(\operatorname{bits} + 1\right), 0\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  outcomes none
}

spec mulAccConstLow {
  bind $\alpha$
  requires $\left(0 < \operatorname{bits}\right)$
  requires $\left(\operatorname{low} \le \operatorname{bits}\right)$
  requires $\left(\left(\operatorname{srcBase} + \operatorname{bits}\right) \le \operatorname{accBase}\right)$
  requires $\left(\left(\operatorname{accBase} + \operatorname{bits}\right) \le \operatorname{addBase}\right)$
  requires $\left(\left(\left(\operatorname{addBase} + \operatorname{bits}\right) + 1\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{setReg}\left(z, \operatorname{addBase}, \left(\operatorname{bits} + 1\right), 0\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{addConstWord}\left(\operatorname{bits}, \left(\operatorname{cst} \cdot \operatorname{getReg}\left(z, \operatorname{srcBase}, \operatorname{low}\right)\right), \operatorname{accBase}, \operatorname{setReg}\left(z, \operatorname{addBase}, \left(\operatorname{bits} + 1\right), 0\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  outcomes none
}

spec cxCascade {
  bind $\alpha$
  requires $\left(0 < \operatorname{cStride}\right)$
  requires $\left(0 < \operatorname{tStride}\right)$
  requires $\forall i < n, \left(\left(\left(\left(\operatorname{cBase} + \left(\operatorname{cStride} \cdot i\right)\right) < \operatorname{dim}\right) \land \left(\left(\operatorname{tBase} + \left(\operatorname{tStride} \cdot i\right)\right) < \operatorname{dim}\right)\right)\right)$
  requires $\forall i < n, \left(\forall j < n, \left(\left(\left(\operatorname{cBase} + \left(\operatorname{cStride} \cdot i\right)\right) \ne \left(\operatorname{tBase} + \left(\operatorname{tStride} \cdot j\right)\right)\right)\right)\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{z}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{xorRegS}\left(z, \operatorname{tBase}, \operatorname{tStride}, n, \operatorname{getRegS}\left(z, \operatorname{cBase}, \operatorname{cStride}, n\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  outcomes none
}

spec accYSwapG {
  bind $\alpha$
  requires $\left(0 < \operatorname{aStride}\right)$
  requires $\left(0 < \operatorname{yStride}\right)$
  requires $\forall i < \operatorname{bits}, \left(\left(\left(\left(\operatorname{aBase} + \left(\operatorname{aStride} \cdot i\right)\right) < \operatorname{dim}\right) \land \left(\left(\operatorname{yBase} + \left(\operatorname{yStride} \cdot i\right)\right) < \operatorname{dim}\right)\right)\right)$
  requires $\forall i < \operatorname{bits}, \left(\forall j < \operatorname{bits}, \left(\left(\left(\operatorname{aBase} + \left(\operatorname{aStride} \cdot i\right)\right) \ne \left(\operatorname{yBase} + \left(\operatorname{yStride} \cdot j\right)\right)\right)\right)\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{z}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{swapRegS}\left(z, \operatorname{aBase}, \operatorname{aStride}, \operatorname{yBase}, \operatorname{yStride}, \operatorname{bits}\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  outcomes none
}
