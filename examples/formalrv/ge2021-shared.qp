// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:323
algorithm cosetPrepFromZero(q : Qubit[], c : Bit[], bits : Nat, cm : Nat, N : Nat, Ninv : Nat, k : Nat, regBase : Nat, accBase : Nat, addBase : Nat) {
  capacity q $\operatorname{max}\left(\left(\operatorname{regBase} + \operatorname{bits}\right), \operatorname{max}\left(\left(\operatorname{accBase} + \operatorname{bits}\right), \left(\left(\operatorname{addBase} + \operatorname{bits}\right) + 1\right)\right)\right)$
  capacity c $0$
  call hadamards(q, c, regBase, cm) @ id()
  call mulFromLowConst(q, c, bits, cm, N, Ninv, regBase, accBase, addBase) @ id()
  call addConstInto(q, c, bits, k, regBase, addBase) @ id()
}

spec cosetPrepFromZero {
  bind $\alpha$
  requires $\left(0 < \operatorname{cm}\right)$
  requires $\left(\operatorname{cm} \le \operatorname{bits}\right)$
  requires $\left(k < N\right)$
  requires $\left(\operatorname{mod}\left(N, 2\right) = 1\right)$
  requires $\left(\operatorname{mod}\left(\left(N \cdot \operatorname{Ninv}\right), \left(2\right)^{\operatorname{bits}}\right) = 1\right)$
  requires $\left(\operatorname{Ninv} < \left(2\right)^{\operatorname{bits}}\right)$
  requires $\left(N < \left(2\right)^{\operatorname{bits}}\right)$
  requires $\left(\left(\operatorname{regBase} + \operatorname{bits}\right) \le \operatorname{accBase}\right)$
  requires $\left(\left(\operatorname{accBase} + \operatorname{bits}\right) \le \operatorname{addBase}\right)$
  requires $\left(\left(\left(\operatorname{addBase} + \operatorname{bits}\right) + 1\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{prepZeroWord}\left(\operatorname{bits}, \operatorname{regBase}, \operatorname{accBase}, \operatorname{addBase}, z\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\sum_{j < \left(2\right)^{\operatorname{cm}}} \left(\left(\left(\alpha\left(z\right) \cdot \frac{1}{\sqrt{\left(2\right)^{\operatorname{cm}}}}\right) \cdot \ket{\operatorname{setReg}\left(\operatorname{prepZeroWord}\left(\operatorname{bits}, \operatorname{regBase}, \operatorname{accBase}, \operatorname{addBase}, z\right), \operatorname{regBase}, \operatorname{bits}, \left(k + \left(j \cdot N\right)\right)\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)\right)$
  outcomes none
  resource toffoli := $\operatorname{toffCosetPrep}\left(\operatorname{bits}, \operatorname{cm}\right)$
  resource t := $\left(7 \cdot \operatorname{toffCosetPrep}\left(\operatorname{bits}, \operatorname{cm}\right)\right)$
  resource clifford := $\operatorname{cliffCosetPrep}\left(\operatorname{bits}, \operatorname{cm}, N, \operatorname{Ninv}, k\right)$
  resource rot := $0$
  resource meas := $0$
  resource qubits := $\left(\left(3 \cdot \operatorname{bits}\right) + 1\right)$
}

// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:348
algorithm gePrepareRunways(q : Qubit[], c : Bit[], bits : Nat, cm : Nat, N : Nat, Ninv : Nat, k : Nat, gSep : Nat, regBase : Nat, accBase : Nat, addBase : Nat) {
  capacity q $\operatorname{max}\left(\left(\operatorname{regBase} + \left(\left\lfloor\frac{\left(\left(\operatorname{bits} + \operatorname{gSep}\right) - 1\right)}{\operatorname{gSep}}\right\rfloor \cdot \left(\operatorname{gSep} + \operatorname{cm}\right)\right)\right), \left(\left(\left(\operatorname{addBase} + \operatorname{bits}\right) + \operatorname{cm}\right) + 1\right)\right)$
  capacity c $0$
  call cosetPrepFromZero(q, c, bits + cm, cm, N, Ninv, k, regBase, accBase, addBase) @ id()
  call geInsertRunways(q, c, bits, cm, gSep, regBase, addBase) @ id()
}

spec gePrepareRunways {
  bind $\alpha$
  requires $\left(0 < \operatorname{cm}\right)$
  requires $\left(\operatorname{cm} < \operatorname{gSep}\right)$
  requires $\left(0 < \operatorname{bits}\right)$
  requires $\left(k < N\right)$
  requires $\left(\operatorname{mod}\left(N, 2\right) = 1\right)$
  requires $\left(N < \left(2\right)^{\operatorname{bits}}\right)$
  requires $\left(\operatorname{mod}\left(\left(N \cdot \operatorname{Ninv}\right), \left(2\right)^{\left(\operatorname{bits} + \operatorname{cm}\right)}\right) = 1\right)$
  requires $\left(\operatorname{Ninv} < \left(2\right)^{\left(\operatorname{bits} + \operatorname{cm}\right)}\right)$
  requires $\left(\left(\operatorname{regBase} + \left(\operatorname{pieceCount}\left(\operatorname{bits}, \operatorname{gSep}\right) \cdot \left(\operatorname{gSep} + \operatorname{cm}\right)\right)\right) \le \operatorname{accBase}\right)$
  requires $\left(\left(\left(\operatorname{accBase} + \operatorname{bits}\right) + \operatorname{cm}\right) \le \operatorname{addBase}\right)$
