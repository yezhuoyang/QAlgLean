  resource t := $\left(7 \cdot \operatorname{toffLookupAdd}\left(w, \operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}\right)\right)$
  resource clifford := $\operatorname{cliffLookupAdd}\left(w, W, \operatorname{bits}, \operatorname{gSep}, \operatorname{pieceLen}, \operatorname{tOff}\right)$
