    CX(q[R + (v div gSep)*pieceLen + v%gSep], q[addrBase + v - k*wMul])
  }
  repeat v in max(k*wMul, (((bits + gSep - 1) div gSep) - 1)*gSep)..min((k + 1)*wMul, (((bits + gSep - 1) div gSep) - 1)*gSep + pieceLen) {
    CX(q[R + (((bits + gSep - 1) div gSep) - 1)*pieceLen + v - (((bits + gSep - 1) div gSep) - 1)*gSep], q[addrBase + v - k*wMul])
  }
  repeat v in max(k*wMul, (((bits + gSep - 1) div gSep) - 1)*gSep + pieceLen)..min((k + 1)*wMul, (((bits + gSep - 1) div gSep) - 1)*(gSep + 1) + pieceLen) {
    CX(q[R + ((bits + gSep - 1) div gSep)*pieceLen + (v - (((bits + gSep - 1) div gSep) - 1)*gSep - pieceLen)], q[addrBase + v - k*wMul])
