// FormalRV gadget: FormalRV/Audit/GidneyEkera2021/GE2021.shared.prog:503
algorithm ctrlAddConst(q : Qubit[], c : Bit[], bits : Nat, cst : Nat, ctrlIdx : Nat, accBase : Nat, addBase : Nat) {
