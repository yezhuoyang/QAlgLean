}

spec geSubRunway {
  bind $\alpha$
  requires $\left(0 < \operatorname{cm}\right)$
  requires $\left(\operatorname{cm} \le n\right)$
  requires $\left(\left(\operatorname{rBase} + \operatorname{cm}\right) \le \operatorname{uBase}\right)$
  requires $\left(\left(\operatorname{uBase} + n\right) \le \operatorname{addBase}\right)$
  requires $\left(\left(\left(\operatorname{addBase} + n\right) + 1\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{\operatorname{setReg}\left(z, \operatorname{addBase}, \left(n + 1\right), 0\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
