import "./measured-adder.qp"

parameter top : Nat

map shift(b : Nat)(i : Nat) := $\left(b + i\right)$

define wordRev(n : Math, x : Math)
equation wordRev(n, x) := $\sum_{i < n} \left(\left(\operatorname{bit}\left(x, i\right) \cdot \left(2\right)^{\left(\left(n - 1\right) - i\right)}\right)\right)$

define cliffGrad(g : Math, w : Math, j : Math)
equation cliffGrad(g, w, j) := $\left(\left(2 \cdot \operatorname{max}\left(0, \left(\operatorname{min}\left(g, \left(w - j\right)\right) - 1\right)\right)\right) + \operatorname{cliffAdd}\left(g\right)\right)$

define toffQft(w : Math, g : Math)
equation toffQft(w, g) := $\left(\left(w - 1\right) \cdot \left(g - 1\right)\right)$

define measQft(w : Math, g : Math)
equation measQft(w, g) := $\left(w + \left(\left(w - 1\right) \cdot \left(g - 1\right)\right)\right)$

define cliffQft(w : Math, g : Math)
equation cliffQft(w, g) := $\left(w + \sum_{k < \left(w - 1\right)} \left(\operatorname{cliffGrad}\left(g, w, k\right)\right)\right)$

define qftReadPhase(w : Math, g : Math, r : Math, x : Math)
equation qftReadPhase(w, g, r, x) := $\sum_{u < w} \left(\left(\operatorname{bit}\left(x, \left(\left(w - 1\right) - u\right)\right) \cdot \left(\left(\operatorname{bit}\left(r, u\right) \cdot \left(2\right)^{\left(g - 1\right)}\right) + \sum_{d < \operatorname{min}\left(g, \left(u + 1\right)\right)} \left(\begin{cases} 0 & \left(d = 0\right) \\ \left(\operatorname{bit}\left(r, \left(u - d\right)\right) \cdot \left(2\right)^{\left(\left(g - d\right) - 1\right)}\right) & \text{otherwise} \end{cases}\right)\right)\right)\right)$

// FormalRV gadget: FormalRV/Arithmetic/PhaseGradient/phase_gradient.prog:14
algorithm gGradientPrep(q : Qubit[], c : Bit[], g : Nat, gradBase : Nat) {
  capacity q $\left(\operatorname{gradBase} + \left(3 \cdot g\right)\right)$
  capacity c $0$
  repeat i in 0..g {
    H(q[gradBase + 3*i + 1])
  }
  repeat i in 0..g {
    RzDyadic(q[gradBase + 3*i + 1], g - i - 1)
  }
}

spec gGradientPrep {
  bind $\alpha$
  requires $\left(0 < g\right)$
  requires $\forall k < g, \left(\left(\left(\left(\operatorname{gradBase} + \left(3 \cdot k\right)\right) + 1\right) < \operatorname{dim}\right)\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \left(\ket{z}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}} \otimes \ket{0}_{q_{\operatorname{band}\left(\left(\operatorname{gradBase} + 1\right), \left(\left(\operatorname{gradBase} + \left(3 \cdot g\right)\right) + 1\right), 3\right)}}\right)\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\sum_{k < \left(2\right)^{g}} \left(\left(\frac{\left(\alpha\left(z\right) \cdot \omega\left(-\left(k\right), \left(2\right)^{g}\right)\right)}{\sqrt{\left(2\right)^{g}}} \cdot \left(\ket{z}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}} \otimes \ket{k}_{q_{\operatorname{band}\left(\left(\operatorname{gradBase} + 1\right), \left(\left(\operatorname{gradBase} + \left(3 \cdot g\right)\right) + 1\right), 3\right)}}\right)\right)\right)\right)$
  outcomes none
  resource toffoli := $0$
  resource t := $\begin{cases} 1 & \left(3 \le g\right) \\ 0 & \text{otherwise} \end{cases}$
  resource rot := $\operatorname{max}\left(0, \left(g - 3\right)\right)$
  resource meas := $0$
  resource clifford := $\left(g + \operatorname{min}\left(g, 2\right)\right)$
  resource depth := $2$
  resource width := $g$
  resource ops := $\left(2 \cdot g\right)$
  resource qubits := $g$
}

// FormalRV gadget: FormalRV/Arithmetic/PhaseGradient/phase_gradient.prog:38
algorithm gQftStage(q : Qubit[], c : Bit[], base : Nat, k : Nat, mb : Nat) {
  capacity q $\operatorname{top}$
  capacity c $\left(\operatorname{mb} + 1\right)$
  H(q[base+k])
  measure q[(base+k)] -> c[mb]
}

spec gQftStage {
  bind $\left(r < 2\right)$
  bind $\alpha$
  requires $\left(\left(\operatorname{base} + k\right) < \operatorname{dim}\right)$
  requires $\left(\operatorname{mb} < \operatorname{dim}\right)$
  requires $\left(\left(\operatorname{base} + k\right) \ne \operatorname{mb}\right)$
  requires $\left(\operatorname{top} \le \operatorname{mb}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\sum_{s < 2} \left(\sum_{x < 2} \left(\left(\frac{\left(\alpha\left(\left(z + \left(\left(2\right)^{\operatorname{dim}} \cdot s\right)\right)\right) \cdot \omega\left(\left(s \cdot x\right), 2\right)\right)}{\sqrt{2}} \cdot \left(\left(\ket{z}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}} \otimes \ket{x}_{q_{\left(\operatorname{base} + k\right)}}\right) \otimes \ket{0}_{q_{\operatorname{mb}}}\right)\right)\right)\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(\left(z + \left(\left(2\right)^{\operatorname{dim}} \cdot r\right)\right)\right) \cdot \left(\left(\ket{z}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}} \otimes \ket{r}_{q_{\left(\operatorname{base} + k\right)}}\right) \otimes \ket{r}_{q_{\operatorname{mb}}}\right)\right)\right)$ given $\left(c_{\operatorname{band}\left(\left(\operatorname{mb} - \operatorname{top}\right), \left(\left(\operatorname{mb} + 1\right) - \operatorname{top}\right), 1\right)} = r\right)$
  outcomes none
  resource toffoli := $0$
  resource t := $0$
  resource rot := $0$
  resource meas := $1$
  resource clifford := $1$
}

// FormalRV gadget: FormalRV/Arithmetic/PhaseGradient/phase_gradient.prog:58
algorithm gQftMeasure(q : Qubit[], c : Bit[], base : Nat, w : Nat, gradBase : Nat, g : Nat, cb : Nat) {
  capacity q $\operatorname{top}$
  capacity c $\left(\left(\operatorname{cb} + w\right) + \left(\left(w - 1\right) \cdot \left(g - 1\right)\right)\right)$
  call gQftStage(q, c, base, w-1, cb) @ id()
  repeat u in 1..w {
    repeat d in 1..min(g, u+1) {
      when $c_{\left(\left(\operatorname{cb} + u\right) - d\right)}$ {
        CX(q[base + w - 1 - u], q[gradBase + 3*(g - d - 1)])
      }
    }
    call gidneyAddNoCarry(q, c, g, cb + w + (u-1)*(g-1)) @ shift(gradBase)
    repeat d in 1..min(g, u+1) {
      when $c_{\left(\left(\operatorname{cb} + u\right) - d\right)}$ {
        CX(q[base + w - 1 - u], q[gradBase + 3*(g - d - 1)])
      }
    }
    call gQftStage(q, c, base, w - 1 - u, cb + u) @ id()
  }
}

spec gQftMeasure {
  bind $\left(r < \left(2\right)^{w}\right)$
  bind $\alpha$
  requires $\left(0 < w\right)$
  requires $\left(2 \le g\right)$
  requires $\left(\left(\left(\operatorname{gradBase} + \left(3 \cdot g\right)\right) \le \operatorname{base}\right) \lor \left(\left(\left(\operatorname{base} + w\right) \le \operatorname{gradBase}\right) \land \left(\left(\operatorname{gradBase} + \left(3 \cdot g\right)\right) \le \operatorname{top}\right)\right)\right)$
  requires $\left(\left(\operatorname{base} + w\right) \le \operatorname{top}\right)$
  requires $\left(\operatorname{top} \le \operatorname{dim}\right)$
  requires $\left(\left(\left(\operatorname{cb} + w\right) + \left(\left(w - 1\right) \cdot \left(g - 1\right)\right)\right) \le \operatorname{dim}\right)$
  requires $\left(\operatorname{top} \le \operatorname{cb}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\sum_{s < \left(2\right)^{w}} \left(\sum_{x < \left(2\right)^{w}} \left(\sum_{k < \left(2\right)^{g}} \left(\left(\frac{\left(\alpha\left(\left(z + \left(\left(2\right)^{\operatorname{dim}} \cdot s\right)\right)\right) \cdot \omega\left(\left(-\left(\operatorname{qftReadPhase}\left(w, g, s, x\right)\right) - k\right), \left(2\right)^{g}\right)\right)}{\left(\sqrt{\left(2\right)^{w}} \cdot \sqrt{\left(2\right)^{g}}\right)} \cdot \left(\left(\left(\left(\left(\ket{z}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}} \otimes \ket{0}_{q_{\operatorname{band}\left(\operatorname{gradBase}, \left(\operatorname{gradBase} + \left(3 \cdot g\right)\right), 3\right)}}\right) \otimes \ket{k}_{q_{\operatorname{band}\left(\left(\operatorname{gradBase} + 1\right), \left(\left(\operatorname{gradBase} + \left(3 \cdot g\right)\right) + 1\right), 3\right)}}\right) \otimes \ket{0}_{q_{\operatorname{band}\left(\left(\operatorname{gradBase} + 2\right), \left(\left(\operatorname{gradBase} + \left(3 \cdot g\right)\right) + 2\right), 3\right)}}\right) \otimes \ket{x}_{q_{\operatorname{band}\left(\operatorname{base}, \left(\operatorname{base} + w\right), 1\right)}}\right) \otimes \ket{0}_{q_{\operatorname{band}\left(\operatorname{cb}, \left(\left(\operatorname{cb} + w\right) + \left(\left(w - 1\right) \cdot \left(g - 1\right)\right)\right), 1\right)}}\right)\right)\right)\right)\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\sum_{k < \left(2\right)^{g}} \left(\left(\frac{\left(\alpha\left(\left(z + \left(\left(2\right)^{\operatorname{dim}} \cdot r\right)\right)\right) \cdot \omega\left(-\left(k\right), \left(2\right)^{g}\right)\right)}{\sqrt{\left(2\right)^{g}}} \cdot \left(\left(\left(\left(\left(\left(\ket{z}_{q_{\operatorname{band}\left(0, \operatorname{cb}, 1\right)}} \otimes \ket{\operatorname{shr}\left(z, \left(\left(\operatorname{cb} + w\right) + \left(\left(w - 1\right) \cdot \left(g - 1\right)\right)\right)\right)}_{q_{\operatorname{band}\left(\left(\left(\operatorname{cb} + w\right) + \left(\left(w - 1\right) \cdot \left(g - 1\right)\right)\right), \operatorname{dim}, 1\right)}}\right) \otimes \ket{0}_{q_{\operatorname{band}\left(\operatorname{gradBase}, \left(\operatorname{gradBase} + \left(3 \cdot g\right)\right), 3\right)}}\right) \otimes \ket{k}_{q_{\operatorname{band}\left(\left(\operatorname{gradBase} + 1\right), \left(\left(\operatorname{gradBase} + \left(3 \cdot g\right)\right) + 1\right), 3\right)}}\right) \otimes \ket{0}_{q_{\operatorname{band}\left(\left(\operatorname{gradBase} + 2\right), \left(\left(\operatorname{gradBase} + \left(3 \cdot g\right)\right) + 2\right), 3\right)}}\right) \otimes \ket{\operatorname{wordRev}\left(w, r\right)}_{q_{\operatorname{band}\left(\operatorname{base}, \left(\operatorname{base} + w\right), 1\right)}}\right) \otimes \ket{r}_{q_{\operatorname{band}\left(\operatorname{cb}, \left(\operatorname{cb} + w\right), 1\right)}}\right)\right)\right)\right)$ given $\left(c_{\operatorname{band}\left(\left(\operatorname{cb} - \operatorname{top}\right), \left(\left(\operatorname{cb} + w\right) - \operatorname{top}\right), 1\right)} = r\right)$
  outcomes none
  resource toffoli := $\operatorname{toffQft}\left(w, g\right)$
  resource t := $\left(7 \cdot \operatorname{toffQft}\left(w, g\right)\right)$
  resource rot := $0$
  resource meas := $\operatorname{measQft}\left(w, g\right)$
  resource clifford := $\operatorname{cliffQft}\left(w, g\right)$
}
