map id()(i : Nat) := $i$

define bit(e : Math, k : Math)
equation bit(e, k) := $\operatorname{mod}\left(\operatorname{shr}\left(e, k\right), 2\right)$

define cliffAdd(n : Math)
equation cliffAdd(n) := $\left(\left(14 \cdot n\right) - 15\right)$

define flip(x : Math, k : Math)
equation flip(x, k) := $\begin{cases} \left(x - \left(2\right)^{k}\right) & \left(\operatorname{bit}\left(x, k\right) = 1\right) \\ \left(x + \left(2\right)^{k}\right) & \text{otherwise} \end{cases}$

define xorInto(x : Math, k : Math, v : Math)
equation xorInto(x, k, v) := $\begin{cases} \operatorname{flip}\left(x, k\right) & \left(v = 1\right) \\ x & \text{otherwise} \end{cases}$

define cxV(u : Math, w : Math, x : Math)
equation cxV(u, w, x) := $\operatorname{xorInto}\left(x, w, \operatorname{bit}\left(x, u\right)\right)$

define ccxV(u : Math, v : Math, w : Math, x : Math)
equation ccxV(u, v, w, x) := $\operatorname{xorInto}\left(x, w, \left(\operatorname{bit}\left(x, u\right) \cdot \operatorname{bit}\left(x, v\right)\right)\right)$

define vFirst(x : Math)
equation vFirst(x) := $\operatorname{cxV}\left(2, 4, \operatorname{cxV}\left(2, 3, \operatorname{ccxV}\left(0, 1, 2, x\right)\right)\right)$

define vInt(i : Math, x : Math)
equation vInt(i, x) := $\operatorname{cxV}\left(\left(\left(3 \cdot i\right) + 2\right), \left(\left(3 \cdot \left(i + 1\right)\right) + 1\right), \operatorname{cxV}\left(\left(\left(3 \cdot i\right) + 2\right), \left(3 \cdot \left(i + 1\right)\right), \operatorname{cxV}\left(\left(\left(3 \cdot \left(i - 1\right)\right) + 2\right), \left(\left(3 \cdot i\right) + 2\right), \operatorname{ccxV}\left(\left(3 \cdot i\right), \left(\left(3 \cdot i\right) + 1\right), \left(\left(3 \cdot i\right) + 2\right), x\right)\right)\right)\right)$

define vLast(i : Math, x : Math)
equation vLast(i, x) := $\operatorname{cxV}\left(\left(\left(3 \cdot \left(i - 1\right)\right) + 2\right), \left(\left(3 \cdot i\right) + 2\right), \operatorname{ccxV}\left(\left(3 \cdot i\right), \left(\left(3 \cdot i\right) + 1\right), \left(\left(3 \cdot i\right) + 2\right), x\right)\right)$

define vFwd(m : Math, x : Math)
equation vFwd(0, x) := $\operatorname{vFirst}\left(x\right)$

equation vFwd(m+1, x) := $\operatorname{vInt}\left(\left(m + 1\right), \operatorname{vFwd}\left(m, x\right)\right)$

define vCas(m : Math, x : Math)
equation vCas(0, x) := $x$

equation vCas(m+1, x) := $\operatorname{cxV}\left(\left(3 \cdot m\right), \left(\left(3 \cdot m\right) + 1\right), \operatorname{vCas}\left(m, x\right)\right)$

define relV(w : Math, x : Math)
equation relV(w, x) := $\begin{cases} \left(x - \left(2\right)^{w}\right) & \left(\operatorname{bit}\left(x, w\right) = 1\right) \\ x & \text{otherwise} \end{cases}$

define vMInt(i : Math, x : Math)
equation vMInt(i, x) := $\operatorname{relV}\left(\left(\left(3 \cdot i\right) + 2\right), \operatorname{cxV}\left(\left(\left(3 \cdot \left(i - 1\right)\right) + 2\right), \left(\left(3 \cdot i\right) + 2\right), \operatorname{cxV}\left(\left(\left(3 \cdot i\right) + 2\right), \left(3 \cdot \left(i + 1\right)\right), \operatorname{cxV}\left(\left(\left(3 \cdot i\right) + 2\right), \left(\left(3 \cdot \left(i + 1\right)\right) + 1\right), x\right)\right)\right)\right)$

define vMFirst(x : Math)
equation vMFirst(x) := $\operatorname{relV}\left(2, \operatorname{cxV}\left(2, 3, \operatorname{cxV}\left(2, 4, x\right)\right)\right)$

define relCls(a : Math, q0 : Math, q1 : Math, x : Math)
equation relCls(a, q0, q1, x) := $\operatorname{xor}\left(\operatorname{bit}\left(x, a\right), \left(\operatorname{bit}\left(x, \operatorname{q0}\right) \cdot \left(1 - \operatorname{bit}\left(x, \operatorname{q1}\right)\right)\right)\right)$

// FormalRV gadget: FormalRV/Arithmetic/MeasuredAdder/measured_adder.prog:24
algorithm gidneyAddNoCarry(q : Qubit[], c : Bit[], n : Nat, cb : Nat) {
  capacity q $\left(3 \cdot n\right)$
  capacity c $\left(\operatorname{cb} + \left(n - 1\right)\right)$
  call gidneyForwardProp(q, c, n-1) @ id()
  call finalCxCascade(q, c, n) @ id()
  repeat k in 0..n-1 {
    if $\left(\left(\left(n - 2\right) - k\right) \ne 0\right)$ {
      call gidneyMeasInteriorRev(q, c, n-2-k, cb+k) @ id()
    } else {
      call gidneyMeasFirstRev(q, c, cb+k) @ id()
    }
  }
}

