// FormalRV gadget: FormalRV/Arithmetic/MeasuredAdder/measured_adder.prog:144
algorithm gidneyMeasInteriorRev(q : Qubit[], c : Bit[], i : Nat, cb : Nat) {
  capacity q $\left(\left(3 \cdot i\right) + 5\right)$
  capacity c $\left(\operatorname{cb} + 1\right)$
  CX(q[3*i+2], q[3*(i+1)+1])
  CX(q[3*i+2], q[3*(i+1)])
  CX(q[3*(i-1)+2], q[3*i+2])
  H(q[3*i+2])
  measure q[(3*i+2)] -> c[cb]
  when $c_{\operatorname{cb}}$ {
    X(q[3*i+1])
    CZ(q[3*i], q[3*i+1])
    X(q[3*i+1])
    X(q[3*i+2])
  }
}

