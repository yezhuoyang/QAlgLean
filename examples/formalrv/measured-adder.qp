// FormalRV gadget: FormalRV/Arithmetic/MeasuredAdder/measured_adder.prog:168
algorithm gidneyMeasFirstRev(q : Qubit[], c : Bit[], cb : Nat) {
  capacity q $5$
  capacity c $\left(\operatorname{cb} + 1\right)$
  CX(q[2], q[4])
  CX(q[2], q[3])
  H(q[2])
  measure q[(2)] -> c[cb]
  when $c_{\operatorname{cb}}$ {
    X(q[1])
    CZ(q[0], q[1])
    X(q[1])
    X(q[2])
  }
}

