algorithm gidneyForward(q : Qubit[], c : Bit[], n : Nat) {
  capacity q $\left(3 \cdot n\right)$
  capacity c $0$
  call gidneyForwardProp(q, c, n-1) @ id()
  call gidneyLast(q, c, n-1) @ id()
}

spec gidneyForward {
  bind $\left(x < \left(2\right)^{\left(3 \cdot n\right)}\right)$
  requires $\left(2 \le n\right)$
  requires $\left(\left(3 \cdot n\right) \le \operatorname{dim}\right)$
  assumes $\ket{x}_{q_{\operatorname{band}\left(0, \left(3 \cdot n\right), 1\right)}}$
  ensures $\ket{\operatorname{vLast}\left(\left(n - 1\right), \operatorname{vFwd}\left(\left(n - 2\right), x\right)\right)}_{q_{\operatorname{band}\left(0, \left(3 \cdot n\right), 1\right)}}$
  outcomes none
}

