algorithm gidneyForwardProp(q : Qubit[], c : Bit[], nSeg : Nat) {
  capacity q $\left(\left(3 \cdot \operatorname{nSeg}\right) + 2\right)$
  capacity c $0$
  repeat i in 0..nSeg {
    if $\left(i \ne 0\right)$ {
      call gidneyInterior(q, c, i) @ id()
    } else {
      call gidneyFirst(q, c) @ id()
    }
  }
}

