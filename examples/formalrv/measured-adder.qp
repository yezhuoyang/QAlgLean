  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\sum_{a < \left(2\right)^{n}} \left(\sum_{b < \left(2\right)^{n}} \left(\left(\alpha\left(\left(z + \left(\left(2\right)^{\operatorname{dim}} \cdot \left(a + \left(\left(2\right)^{n} \cdot b\right)\right)\right)\right)\right) \cdot \left(\left(\left(\left(\left(\ket{z}_{q_{\operatorname{band}\left(0, \operatorname{base}, 1\right)}} \otimes \ket{a}_{q_{\operatorname{band}\left(\left(\operatorname{base} + 0\right), \left(\left(\operatorname{base} + \left(3 \cdot n\right)\right) + 0\right), 3\right)}}\right) \otimes \ket{\operatorname{mod}\left(\left(a + b\right), \left(2\right)^{n}\right)}_{q_{\operatorname{band}\left(\left(\operatorname{base} + 1\right), \left(\left(\operatorname{base} + \left(3 \cdot n\right)\right) + 1\right), 3\right)}}\right) \otimes \ket{0}_{q_{\operatorname{band}\left(\left(\operatorname{base} + 2\right), \left(\left(\operatorname{base} + \left(3 \cdot n\right)\right) + 2\right), 3\right)}}\right) \otimes \ket{\operatorname{shr}\left(z, \left(\operatorname{base} + \left(3 \cdot n\right)\right)\right)}_{q_{\operatorname{band}\left(\left(\operatorname{base} + \left(3 \cdot n\right)\right), \operatorname{cb}, 1\right)}}\right) \otimes \ket{\operatorname{shr}\left(z, \left(\operatorname{cb} + \left(n - 1\right)\right)\right)}_{q_{\operatorname{band}\left(\left(\operatorname{cb} + \left(n - 1\right)\right), \operatorname{dim}, 1\right)}}\right)\right)\right)\right)\right)$
