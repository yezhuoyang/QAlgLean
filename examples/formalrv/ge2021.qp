spec gIdealIQFT {
  bind $\alpha$
  requires $\left(0 < \operatorname{nA}\right)$
  requires $\left(0 < \left(\operatorname{nE} - \operatorname{nA}\right)\right)$
  requires $\left(\left(\operatorname{nE} - \operatorname{nA}\right) \le \operatorname{nA}\right)$
  requires $\left(\left(\operatorname{expWire} + \operatorname{nE}\right) \le \operatorname{dim}\right)$
  assumes $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\left(\alpha\left(z\right) \cdot \ket{z}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)$
  ensures $\sum_{z < \left(2\right)^{\operatorname{dim}}} \left(\sum_{v < \left(2\right)^{\operatorname{nE}}} \left(\left(\left(\alpha\left(z\right) \cdot \left(\frac{1}{\sqrt{\left(2\right)^{\operatorname{nE}}}} \cdot \left(\omega\left(-\left(\left(\operatorname{rev}\left(\operatorname{getReg}\left(z, \operatorname{expWire}, \operatorname{nA}\right), \operatorname{nA}\right) \cdot \operatorname{mod}\left(v, \left(2\right)^{\operatorname{nA}}\right)\right)\right), \left(2\right)^{\operatorname{nA}}\right) \cdot \omega\left(-\left(\left(\operatorname{rev}\left(\operatorname{getReg}\left(z, \left(\operatorname{expWire} + \operatorname{nA}\right), \left(\operatorname{nE} - \operatorname{nA}\right)\right), \left(\operatorname{nE} - \operatorname{nA}\right)\right) \cdot \left\lfloor\frac{v}{\left(2\right)^{\operatorname{nA}}}\right\rfloor\right)\right), \left(2\right)^{\left(\operatorname{nE} - \operatorname{nA}\right)}\right)\right)\right)\right) \cdot \ket{\operatorname{setReg}\left(z, \operatorname{expWire}, \operatorname{nE}, v\right)}_{q_{\operatorname{band}\left(0, \operatorname{dim}, 1\right)}}\right)\right)\right)$
  outcomes none
  resource toffoli := $0$
  resource t := $\sum_{p < \operatorname{nE}} \left(\operatorname{tIdealRead}\left(1, \operatorname{nA}, p\right)\right)$
  resource clifford := $\sum_{p < \operatorname{nE}} \left(\operatorname{cliffIdealRead}\left(1, \operatorname{nA}, p\right)\right)$
  resource rot := $\sum_{p < \operatorname{nE}} \left(\operatorname{rotIdealRead}\left(1, \operatorname{nA}, p\right)\right)$
  resource meas := $0$
  resource qubits := $\operatorname{nE}$
}
