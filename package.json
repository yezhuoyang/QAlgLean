{
  "name": "qparam-studio",
  "displayName": "QParam Studio",
  "description": "Quantum programs and specifications with mathematics rendered directly in the VS Code editor.",
  "version": "0.3.0",
  "publisher": "yezhuoyang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yezhuoyang/QAlgLean.git"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Education"
  ],
  "keywords": [
    "quantum",
    "qparam",
    "latex",
    "mathematics",
    "research"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:qparam",
    "onCustomEditor:qparam.mathEditor"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "qparam.mathEditor",
        "displayName": "QParam Mathematical Editor",
        "selector": [
          {
            "filenamePattern": "*.qp"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "qparam",
        "aliases": [
          "QParam",
          "qp"
        ],
        "extensions": [
          ".qp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qparam",
        "scopeName": "source.qparam",
        "path": "./syntaxes/qparam.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "qparam",
        "path": "./snippets/qparam.json"
      }
    ],
    "commands": [
      {
        "command": "qparam.openMathEditor",
        "title": "QParam: Open Mathematical Editor",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "qparam.openPreview",
        "title": "QParam: Open Paper Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "qparam.openExample",
        "title": "QParam: Open an Example"
      },
      {
        "command": "qparam.insertMath",
        "title": "QParam: Insert Mathematical Notation"
      },
      {
        "command": "qparam.exportLatex",
        "title": "QParam: Export Paper to LaTeX"
      },
      {
        "command": "qparam.importLatex",
        "title": "QParam: Import QParam Block from LaTeX"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "qparam.openMathEditor",
          "when": "editorLangId == qparam && activeCustomEditorId != qparam.mathEditor",
          "group": "navigation"
        },
        {
          "command": "qparam.openPreview",
          "when": "editorLangId == qparam",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "qparam.openPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && editorLangId == qparam"
      }
    ],
    "configuration": {
      "title": "QParam",
      "properties": {
        "qparam.preview.updateDelay": {
          "type": "number",
          "default": 180,
          "minimum": 50,
          "maximum": 2000,
          "description": "Delay in milliseconds before updating syntax diagnostics and the paper preview after an edit."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "build": "npm run compile && node scripts/build.cjs",
    "watch": "tsc -watch -p .",
    "test": "npm run build && node --test test/*.test.cjs",
    "package": "npm run build && node -e \"require('fs').mkdirSync('artifacts',{recursive:true})\" && vsce package --no-dependencies --out artifacts/qparam-studio-0.3.0.vsix",
    "vscode:prepublish": "npm run build",
    "preview": "npm run build && node scripts/preview.cjs",
    "test:extension": "npm run build && node scripts/test-extension.cjs",
    "check:literature": "npm run build && node --test test/literature-corpus.test.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "katex": "^0.19.1"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
